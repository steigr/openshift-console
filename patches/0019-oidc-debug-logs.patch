diff --git a/pkg/auth/oauth2/debug.go b/pkg/auth/oauth2/debug.go
new file mode 100644
index 00000000..9280008d
--- /dev/null
+++ b/pkg/auth/oauth2/debug.go
@@ -0,0 +1,43 @@
+package oauth2
+
+import (
+	"fmt"
+
+	"k8s.io/klog/v2"
+)
+
+// debugLogsEnabled gates the verbose OIDC login/refresh flow tracing below.
+// It's off by default and turned on via SetDebugLogging, which the
+// --user-auth-oidc-debug-logs flag calls at startup -- a dedicated,
+// discoverable flag instead of overloading klog's global -v verbosity (which
+// would also turn on unrelated subsystems' debug logs cluster-wide).
+var debugLogsEnabled bool
+
+// SetDebugLogging enables or disables verbose OIDC login/refresh flow tracing.
+func SetDebugLogging(enabled bool) {
+	debugLogsEnabled = enabled
+}
+
+// debugf logs an oidc-debug trace line when debug logging is enabled. Tokens
+// and other secrets must never be passed to it in full -- callers should use
+// tokenPreview for anything token-shaped.
+func debugf(format string, args ...interface{}) {
+	if !debugLogsEnabled {
+		return
+	}
+	klog.Infof("oidc-debug: "+format, args...)
+}
+
+// tokenPreview returns a short, non-sensitive preview of a token suitable for
+// inclusion in debug logs (only the first few characters plus length, never
+// the full bearer).
+func tokenPreview(t string) string {
+	if t == "" {
+		return "<empty>"
+	}
+	const prefixLen = 8
+	if len(t) > prefixLen {
+		return fmt.Sprintf("%s…(len=%d)", t[:prefixLen], len(t))
+	}
+	return fmt.Sprintf("…(len=%d)", len(t))
+}
