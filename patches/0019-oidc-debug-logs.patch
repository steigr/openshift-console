diff --git a/frontend/packages/console-shared/src/utils/oidc-debug.ts b/frontend/packages/console-shared/src/utils/oidc-debug.ts
new file mode 100644
index 00000000..a8b9e723
--- /dev/null
+++ b/frontend/packages/console-shared/src/utils/oidc-debug.ts
@@ -0,0 +1,13 @@
+/**
+ * Verbose OIDC login/refresh flow tracing for the browser console. Gated by
+ * window.SERVER_FLAGS.oidcDebugLogs (backend --user-auth-oidc-debug-logs
+ * flag) instead of always logging, so production consoles stay quiet by
+ * default.
+ */
+export const oidcDebugLog = (message: string, data?: Record<string, unknown>): void => {
+  if (!window.SERVER_FLAGS?.oidcDebugLogs) {
+    return;
+  }
+  // eslint-disable-next-line no-console
+  console.debug(`[oidc-debug] ${message}`, data ?? '');
+};
