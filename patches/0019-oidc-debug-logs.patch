diff --git a/pkg/auth/sessions/debug.go b/pkg/auth/sessions/debug.go
new file mode 100644
index 00000000..c872f093
--- /dev/null
+++ b/pkg/auth/sessions/debug.go
@@ -0,0 +1,37 @@
+package sessions
+
+import "k8s.io/klog/v2"
+
+// debugLogsEnabled gates the verbose OIDC session tracing below. It's off by
+// default and turned on via SetDebugLogging, which the --user-auth-oidc-debug-logs
+// flag calls at startup -- a dedicated, discoverable flag instead of overloading
+// klog's global -v verbosity (which would also turn on unrelated subsystems'
+// debug logs cluster-wide).
+var debugLogsEnabled bool
+
+// SetDebugLogging enables or disables verbose OIDC session tracing.
+func SetDebugLogging(enabled bool) {
+	debugLogsEnabled = enabled
+}
+
+// debugf logs an oidc-debug trace line when debug logging is enabled. Tokens
+// and other secrets must never be passed to it in full -- callers should use
+// shortID/tokenPreview-style previews instead.
+func debugf(format string, args ...interface{}) {
+	if !debugLogsEnabled {
+		return
+	}
+	klog.Infof("oidc-debug: "+format, args...)
+}
+
+// shortID returns a short, low-cardinality preview of an identifier for debug
+// logs (never logs sensitive material in full).
+func shortID(s string) string {
+	if s == "" {
+		return "<empty>"
+	}
+	if len(s) > 8 {
+		return s[:8] + "…"
+	}
+	return s
+}
