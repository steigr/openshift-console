+// SPEC_REFERENCE_ANNOTATION is read from the target node. When present it
+// names a ConfigMap in the `openshift-console` namespace whose YAML `spec`
+// key is merged on top of the base override PodSpec, allowing per-node
+// customisation of the debug pod.
+const SPEC_REFERENCE_ANNOTATION = 'node-terminal.netztronaut.de/spec-reference';
+
+// deepMergePodSpec performs a recursive object merge of `source` into
+// `target`, returning a new value. Arrays and scalars from `source` replace
+// their counterparts in `target`; only plain objects are merged key-by-key.
+const deepMergePodSpec = (target: any, source: any): any => {
+  if (source === null || source === undefined) {
+    return target;
+  }
+  if (Array.isArray(source) || typeof source !== 'object') {
+    return source;
+  }
+  if (!target || typeof target !== 'object' || Array.isArray(target)) {
+    return { ...source };
+  }
+  const out: Record<string, any> = { ...target };
+  Object.keys(source).forEach((key) => {
+    out[key] = deepMergePodSpec(target[key], source[key]);
+  });
+  return out;
+};
+
+// getOverridePodSpecFromConfigMap returns a parsed PodSpec from the named
+// ConfigMap in the `openshift-console` namespace if present, otherwise null.
+// The ConfigMap key `spec` is interpreted as YAML. The returned spec has
+// `nodeName` overridden with the requested node.
+const getOverridePodSpecFromConfigMap = async (
+  nodeName: string,
+  configMapName = 'node-terminal',
+): Promise<PodKind['spec'] | null> => {
+  try {
+    const configMap = await k8sGet(ConfigMapModel, configMapName, 'openshift-console');
+    const raw = configMap?.data?.spec;
+    if (!raw) {
+      return null;
+    }
+    const parsed = safeYAMLToJS(raw, null);
+    if (!parsed || typeof parsed !== 'object') {
+      return null;
+    }
+    parsed.nodeName = nodeName;
+    return parsed;
+  } catch (e) {
+    return null;
+  }
+};
