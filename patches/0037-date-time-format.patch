@@ -0,0 +1,162 @@
+import type { FC, Ref } from 'react';
+import { useMemo, useState } from 'react';
+import type { MenuToggleElement } from '@patternfly/react-core';
+import { MenuToggle, Select, SelectList, SelectOption, Skeleton } from '@patternfly/react-core';
+import { useTranslation } from 'react-i18next';
+import { useTelemetry } from '@console/shared/src/hooks/useTelemetry';
+import {
+  DATE_TIME_LOCALE_BROWSER,
+  DATE_TIME_LOCALE_LANGUAGE,
+  DATE_TIME_LOCALE_LOCAL_STORAGE_KEY,
+  dateTimeLocales,
+} from './const';
+import {
+  getBrowserDateTimeLocale,
+  getHourCycle,
+  isSupportedDateTimeLocale,
+} from './getDateTimeLocale';
+import { getLastLanguage } from './getLastLanguage';
+import {
+  DATE_TIME_LOCALE_USER_PREFERENCE_KEY,
+  storeDateTimeFormatPreference,
+  useDateTimeFormatChange,
+  usePreferredDateTimeLocale,
+} from './useDateTimeFormat';
+
+/** "Oct 11, 2026, 11:29 PM", the format of a console Timestamp, in `locale`. */
+export const formatDateTimeSample = (
+  locale: string,
+  hourCycle: Intl.DateTimeFormatOptions['hourCycle'] | undefined,
+  date: Date,
+): string => {
+  try {
+    return new Intl.DateTimeFormat(locale, {
+      month: 'short',
+      day: 'numeric',
+      year: 'numeric',
+      hour: 'numeric',
+      minute: 'numeric',
+      ...(hourCycle ? { hourCycle } : {}),
+    }).format(date);
+  } catch {
+    return '';
+  }
+};
+
+const canonical = (locale: string): string => {
+  try {
+    return Intl.getCanonicalLocales(locale)[0];
+  } catch {
+    return undefined;
+  }
+};
+
+const DateTimeFormatDropdown: FC = () => {
+  const { t } = useTranslation();
+  const fireTelemetryEvent = useTelemetry();
+  const [preference, setPreference, loaded] = usePreferredDateTimeLocale();
+  const [isOpen, setIsOpen] = useState(false);
+  useDateTimeFormatChange();
+
+  const language = getLastLanguage();
+  const hourCycle = getHourCycle();
+
+  const options = useMemo(() => {
+    const now = new Date();
+    let displayNames: Intl.DisplayNames;
+    try {
+      displayNames = new Intl.DisplayNames([language], { type: 'language' });
+    } catch {
+      displayNames = undefined;
+    }
+    const nameOf = (locale: string) => {
+      try {
+        return displayNames?.of(locale) ?? locale;
+      } catch {
+        return locale;
+      }
+    };
+    const browserLocale = getBrowserDateTimeLocale();
+    // The browser's own preferred languages first: those are the regional formats the user
+    // most likely wants, and a language tag without a region formats like its main region.
+    const locales = [...(navigator.languages ?? []), ...dateTimeLocales]
+      .map(canonical)
+      .filter((locale, i, all) => locale && all.indexOf(locale) === i)
+      .filter(isSupportedDateTimeLocale);
+    return [
+      {
+        value: DATE_TIME_LOCALE_LANGUAGE,
+        label: t('console-app~Same as language'),
+        sample: formatDateTimeSample(language, hourCycle, now),
+      },
+      {
+        value: DATE_TIME_LOCALE_BROWSER,
+        label: t('console-app~Browser default ({{locale}})', { locale: nameOf(browserLocale) }),
+        sample: formatDateTimeSample(browserLocale, hourCycle, now),
+      },
+      ...locales.map((locale) => ({
+        value: locale,
+        label: nameOf(locale),
+        sample: formatDateTimeSample(locale, hourCycle, now),
+      })),
+    ];
+  }, [language, hourCycle, t]);
+
+  const selected =
+    options.find((option) => option.value === preference) ??
+    // a stored locale this browser cannot format in, or one from an older list
+    options.find((option) => option.value === DATE_TIME_LOCALE_LANGUAGE);
+
+  const onSelect = (_, value: string) => {
+    if (value !== preference) {
+      setPreference(value);
+      // takes effect right away; useDateTimeFormat only catches up once the setting round-trips
+      storeDateTimeFormatPreference(
+        DATE_TIME_LOCALE_LOCAL_STORAGE_KEY,
+        value,
+        DATE_TIME_LOCALE_LANGUAGE,
+      );
+      fireTelemetryEvent('User Preference Changed', {
+        property: DATE_TIME_LOCALE_USER_PREFERENCE_KEY,
+        value: [DATE_TIME_LOCALE_LANGUAGE, DATE_TIME_LOCALE_BROWSER].includes(value)
+          ? value
+          : 'custom',
+      });
+    }
+    setIsOpen(false);
+  };
+
+  return loaded ? (
+    <Select
+      isOpen={isOpen}
+      onOpenChange={(open) => setIsOpen(open)}
+      selected={selected.value}
+      onSelect={onSelect}
+      data-test="dropdown console.dateTimeLocale"
+      id="console.dateTimeLocale"
+      isScrollable
+      toggle={(toggleRef: Ref<MenuToggleElement>) => (
+        <MenuToggle
+          aria-label={t('console-app~Select a date and time format')}
+          isFullWidth
+          ref={toggleRef}
+          onClick={() => setIsOpen(!isOpen)}
+        >
+          {selected.sample ? `${selected.label} — ${selected.sample}` : selected.label}
+        </MenuToggle>
+      )}
+    >
+      <SelectList>
+        {options.map((option) => (
+          <SelectOption key={option.value} value={option.value} description={option.sample}>
+            {option.label}
+          </SelectOption>
+        ))}
+      </SelectList>
+    </Select>
+  ) : (
+    <Skeleton height="30px" width="100%" data-test="dropdown skeleton console.dateTimeLocale" />
+  );
+};
+
+export default DateTimeFormatDropdown;
