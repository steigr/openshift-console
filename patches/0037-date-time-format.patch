+import { act, fireEvent, screen } from '@testing-library/react';
+import { renderWithProviders } from '@console/shared/src/test-utils/unit-test-utils';
+import {
+  DATE_TIME_LOCALE_LOCAL_STORAGE_KEY,
+  HOUR_CYCLE_LOCAL_STORAGE_KEY,
+  LAST_LANGUAGE_LOCAL_STORAGE_KEY,
+} from '../const';
+import DateTimeFormatDropdown from '../DateTimeFormatDropdown';
+import HourCycleDropdown from '../HourCycleDropdown';
+import { usePreferredDateTimeLocale, usePreferredHourCycle } from '../useDateTimeFormat';
+
+jest.mock('@console/shared/src/hooks/useTelemetry', () => ({
+  useTelemetry: () => () => {},
+}));
+
+jest.mock('../useDateTimeFormat', () => ({
+  ...jest.requireActual('../useDateTimeFormat'),
+  usePreferredDateTimeLocale: jest.fn(),
+  usePreferredHourCycle: jest.fn(),
+}));
+
+const usePreferredDateTimeLocaleMock = usePreferredDateTimeLocale as jest.Mock;
+const usePreferredHourCycleMock = usePreferredHourCycle as jest.Mock;
+
+describe('DateTimeFormatDropdown', () => {
+  beforeEach(() => localStorage.setItem(LAST_LANGUAGE_LOCAL_STORAGE_KEY, 'en'));
+  afterEach(() => localStorage.clear());
+
+  it('shows a skeleton until the preference has loaded', async () => {
+    usePreferredDateTimeLocaleMock.mockReturnValue(['language', jest.fn(), false]);
+    await act(async () => {
+      renderWithProviders(<DateTimeFormatDropdown />);
+    });
+    expect(screen.getByTestId('dropdown skeleton console.dateTimeLocale')).toBeInTheDocument();
+  });
+
+  it('stores a chosen regional format where the formatters read it', async () => {
+    const setPreference = jest.fn();
+    usePreferredDateTimeLocaleMock.mockReturnValue(['language', setPreference, true]);
+    await act(async () => {
+      renderWithProviders(<DateTimeFormatDropdown />);
+    });
+
+    const toggle = screen.getByRole('button', { name: 'Select a date and time format' });
+    expect(toggle).toHaveTextContent('Same as language');
+    fireEvent.click(toggle);
+    fireEvent.click(await screen.findByText('German (Germany)'));
+
+    expect(setPreference).toHaveBeenCalledWith('de-DE');
+    expect(localStorage.getItem(DATE_TIME_LOCALE_LOCAL_STORAGE_KEY)).toBe('de-DE');
+  });
+});
+
+describe('HourCycleDropdown', () => {
+  afterEach(() => localStorage.clear());
+
+  it('stores a 24-hour clock and clears it again for automatic', async () => {
+    const setPreference = jest.fn();
+    usePreferredHourCycleMock.mockReturnValue(['auto', setPreference, true]);
+    await act(async () => {
+      renderWithProviders(<HourCycleDropdown />);
+    });
+
+    fireEvent.click(screen.getByRole('button', { name: 'Select a time format' }));
+    fireEvent.click(await screen.findByText('24-hour'));
+    expect(setPreference).toHaveBeenLastCalledWith('h23');
+    expect(localStorage.getItem(HOUR_CYCLE_LOCAL_STORAGE_KEY)).toBe('h23');
+
+    usePreferredHourCycleMock.mockReturnValue(['h23', setPreference, true]);
+    fireEvent.click(screen.getByRole('button', { name: 'Select a time format' }));
+    fireEvent.click(await screen.findByText('Same as date and time format'));
+    expect(setPreference).toHaveBeenLastCalledWith('auto');
+    expect(localStorage.getItem(HOUR_CYCLE_LOCAL_STORAGE_KEY)).toBeNull();
+  });
+});
diff --git a/frontend/packages/console-app/src/components/user-preferences/language/__tests__/getDateTimeLocale.spec.ts b/frontend/packages/console-app/src/components/user-preferences/language/__tests__/getDateTimeLocale.spec.ts
