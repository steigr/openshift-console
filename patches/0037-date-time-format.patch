+import type { Dispatch, SetStateAction } from 'react';
+import { useEffect, useReducer } from 'react';
+import { useUserPreference } from '@console/shared/src/hooks/useUserPreference';
+import {
+  DATE_TIME_LOCALE_LANGUAGE,
+  DATE_TIME_LOCALE_LOCAL_STORAGE_KEY,
+  HOUR_CYCLE_AUTO,
+  HOUR_CYCLE_LOCAL_STORAGE_KEY,
+} from './const';
+
+const CHANGE_EVENT = 'console:date-time-format-change';
+
+export const DATE_TIME_LOCALE_USER_PREFERENCE_KEY = 'console.dateTimeLocale';
+export const HOUR_CYCLE_USER_PREFERENCE_KEY = 'console.hourCycle';
+
+export const usePreferredDateTimeLocale = (): [string, Dispatch<SetStateAction<string>>, boolean] =>
+  useUserPreference<string>(DATE_TIME_LOCALE_USER_PREFERENCE_KEY, DATE_TIME_LOCALE_LANGUAGE, true);
+
+export const usePreferredHourCycle = (): [string, Dispatch<SetStateAction<string>>, boolean] =>
+  useUserPreference<string>(HOUR_CYCLE_USER_PREFERENCE_KEY, HOUR_CYCLE_AUTO, true);
+
+/**
+ * Mirrors a date and time format preference into localStorage, where the formatters read it
+ * synchronously. The default is stored as no item at all.
+ */
+export const storeDateTimeFormatPreference = (
+  storageKey: string,
+  value: string,
+  defaultValue: string,
+) => {
+  try {
+    if (value && value !== defaultValue) {
+      localStorage.setItem(storageKey, value);
+    } else {
+      localStorage.removeItem(storageKey);
+    }
+  } catch {
+    // storage unavailable; formatting keeps following the console language
+    return;
+  }
+  window.dispatchEvent(new Event(CHANGE_EVENT));
+};
+
+/** Re-renders the caller whenever a date and time format preference changes in this window. */
+export const useDateTimeFormatChange = () => {
+  const [, update] = useReducer((n: number) => n + 1, 0);
+  useEffect(() => {
+    window.addEventListener(CHANGE_EVENT, update);
+    return () => window.removeEventListener(CHANGE_EVENT, update);
+  }, []);
+};
+
+/** Keeps the localStorage mirrors in step with the user settings, e.g. set on another device. */
+export const useDateTimeFormat = () => {
+  const [locale, , localeLoaded] = usePreferredDateTimeLocale();
+  const [hourCycle, , hourCycleLoaded] = usePreferredHourCycle();
+
+  useEffect(() => {
+    if (localeLoaded) {
+      storeDateTimeFormatPreference(
+        DATE_TIME_LOCALE_LOCAL_STORAGE_KEY,
+        locale,
+        DATE_TIME_LOCALE_LANGUAGE,
+      );
+    }
+  }, [locale, localeLoaded]);
+
+  useEffect(() => {
+    if (hourCycleLoaded) {
+      storeDateTimeFormatPreference(HOUR_CYCLE_LOCAL_STORAGE_KEY, hourCycle, HOUR_CYCLE_AUTO);
+    }
+  }, [hourCycle, hourCycleLoaded]);
+};
