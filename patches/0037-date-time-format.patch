+import type { FC, Ref } from 'react';
+import { useMemo, useState } from 'react';
+import type { MenuToggleElement } from '@patternfly/react-core';
+import { MenuToggle, Select, SelectList, SelectOption, Skeleton } from '@patternfly/react-core';
+import { useTranslation } from 'react-i18next';
+import { useTelemetry } from '@console/shared/src/hooks/useTelemetry';
+import {
+  HOUR_CYCLE_12,
+  HOUR_CYCLE_24,
+  HOUR_CYCLE_AUTO,
+  HOUR_CYCLE_LOCAL_STORAGE_KEY,
+} from './const';
+import { formatDateTimeSample } from './DateTimeFormatDropdown';
+import { getDateTimeLocale } from './getDateTimeLocale';
+import {
+  HOUR_CYCLE_USER_PREFERENCE_KEY,
+  storeDateTimeFormatPreference,
+  useDateTimeFormatChange,
+  usePreferredHourCycle,
+} from './useDateTimeFormat';
+
+const HourCycleDropdown: FC = () => {
+  const { t } = useTranslation();
+  const fireTelemetryEvent = useTelemetry();
+  const [preference, setPreference, loaded] = usePreferredHourCycle();
+  const [isOpen, setIsOpen] = useState(false);
+  useDateTimeFormatChange();
+
+  const locale = getDateTimeLocale();
+
+  const options = useMemo(() => {
+    const now = new Date();
+    return [
+      {
+        value: HOUR_CYCLE_AUTO,
+        label: t('console-app~Same as date and time format'),
+        sample: formatDateTimeSample(locale, undefined, now),
+      },
+      {
+        value: HOUR_CYCLE_12,
+        label: t('console-app~12-hour'),
+        sample: formatDateTimeSample(locale, HOUR_CYCLE_12, now),
+      },
+      {
+        value: HOUR_CYCLE_24,
+        label: t('console-app~24-hour'),
+        sample: formatDateTimeSample(locale, HOUR_CYCLE_24, now),
+      },
+    ];
+  }, [locale, t]);
+
+  const selected =
+    options.find((option) => option.value === preference) ??
+    options.find((option) => option.value === HOUR_CYCLE_AUTO);
+
+  const onSelect = (_, value: string) => {
+    if (value !== preference) {
+      setPreference(value);
+      storeDateTimeFormatPreference(HOUR_CYCLE_LOCAL_STORAGE_KEY, value, HOUR_CYCLE_AUTO);
+      fireTelemetryEvent('User Preference Changed', {
+        property: HOUR_CYCLE_USER_PREFERENCE_KEY,
+        value,
+      });
+    }
+    setIsOpen(false);
+  };
+
+  return loaded ? (
+    <Select
+      isOpen={isOpen}
+      onOpenChange={(open) => setIsOpen(open)}
+      selected={selected.value}
+      onSelect={onSelect}
+      data-test="dropdown console.hourCycle"
+      id="console.hourCycle"
+      toggle={(toggleRef: Ref<MenuToggleElement>) => (
+        <MenuToggle
+          aria-label={t('console-app~Select a time format')}
+          isFullWidth
+          ref={toggleRef}
+          onClick={() => setIsOpen(!isOpen)}
+        >
+          {selected.sample ? `${selected.label} — ${selected.sample}` : selected.label}
+        </MenuToggle>
+      )}
+    >
+      <SelectList>
+        {options.map((option) => (
+          <SelectOption key={option.value} value={option.value} description={option.sample}>
+            {option.label}
+          </SelectOption>
+        ))}
+      </SelectList>
+    </Select>
+  ) : (
+    <Skeleton height="30px" width="100%" data-test="dropdown skeleton console.hourCycle" />
+  );
+};
+
+export default HourCycleDropdown;
diff --git a/frontend/packages/console-app/src/components/user-preferences/language/__tests__/DateTimeFormatDropdown.spec.tsx b/frontend/packages/console-app/src/components/user-preferences/language/__tests__/DateTimeFormatDropdown.spec.tsx
