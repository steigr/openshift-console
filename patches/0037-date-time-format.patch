@@ -0,0 +1,53 @@
+import {
+  DATE_TIME_LOCALE_LOCAL_STORAGE_KEY,
+  HOUR_CYCLE_LOCAL_STORAGE_KEY,
+  LAST_LANGUAGE_LOCAL_STORAGE_KEY,
+} from '../const';
+import { getBrowserDateTimeLocale, getDateTimeLocale, getHourCycle } from '../getDateTimeLocale';
+
+describe('getDateTimeLocale', () => {
+  afterEach(() => localStorage.clear());
+
+  it('follows the console language by default', () => {
+    localStorage.setItem(LAST_LANGUAGE_LOCAL_STORAGE_KEY, 'ja');
+    expect(getDateTimeLocale()).toBe('ja');
+    expect(getDateTimeLocale('fr')).toBe('fr');
+    localStorage.setItem(DATE_TIME_LOCALE_LOCAL_STORAGE_KEY, 'language');
+    expect(getDateTimeLocale()).toBe('ja');
+  });
+
+  it('uses a chosen regional format over the console language', () => {
+    localStorage.setItem(LAST_LANGUAGE_LOCAL_STORAGE_KEY, 'en');
+    localStorage.setItem(DATE_TIME_LOCALE_LOCAL_STORAGE_KEY, 'de-DE');
+    expect(getDateTimeLocale()).toBe('de-DE');
+    expect(getDateTimeLocale('en')).toBe('de-DE');
+  });
+
+  it("uses the browser's own format", () => {
+    localStorage.setItem(LAST_LANGUAGE_LOCAL_STORAGE_KEY, 'ja');
+    localStorage.setItem(DATE_TIME_LOCALE_LOCAL_STORAGE_KEY, 'browser');
+    expect(getDateTimeLocale()).toBe(getBrowserDateTimeLocale());
+  });
+
+  it('ignores a malformed locale', () => {
+    localStorage.setItem(LAST_LANGUAGE_LOCAL_STORAGE_KEY, 'en');
+    localStorage.setItem(DATE_TIME_LOCALE_LOCAL_STORAGE_KEY, 'not a locale!');
+    expect(getDateTimeLocale()).toBe('en');
+  });
+});
+
+describe('getHourCycle', () => {
+  afterEach(() => localStorage.clear());
+
+  it('is unset unless 12- or 24-hour was chosen', () => {
+    expect(getHourCycle()).toBeUndefined();
+    localStorage.setItem(HOUR_CYCLE_LOCAL_STORAGE_KEY, 'auto');
+    expect(getHourCycle()).toBeUndefined();
+    localStorage.setItem(HOUR_CYCLE_LOCAL_STORAGE_KEY, 'h11');
+    expect(getHourCycle()).toBeUndefined();
+    localStorage.setItem(HOUR_CYCLE_LOCAL_STORAGE_KEY, 'h23');
+    expect(getHourCycle()).toBe('h23');
+    localStorage.setItem(HOUR_CYCLE_LOCAL_STORAGE_KEY, 'h12');
+    expect(getHourCycle()).toBe('h12');
+  });
+});
