diff --git a/pkg/proxy/proxy.go b/pkg/proxy/proxy.go
index 81f922f3..d418bc3a 100644
--- a/pkg/proxy/proxy.go
+++ b/pkg/proxy/proxy.go
@@ -8,6 +8,7 @@ import (
 	"net/http"
 	"net/http/httputil"
 	"net/url"
+	"os"
 	"strings"
 	"sync"
 	"time"
@@ -228,9 +229,26 @@ func (p *Proxy) ServeHTTP(w http.ResponseWriter, r *http.Request) {
 		proxiedHeader.Del(header)
 	}
 
+	// Optionally swap the bearer token for the in-cluster service account
+	// token. Useful when the console proxies websocket traffic on behalf of
+	// the user but the upstream API server only trusts the SA token.
+	if os.Getenv("AUTH_WITH_SERVICE_ACCOUNT_TOKEN") == "true" {
+		klog.V(4).Info("Using service account token for websocket proxy authentication")
+		if bt, err := os.ReadFile("/var/run/secrets/kubernetes.io/serviceaccount/token"); err == nil {
+			rawUserToken := string(bt)
+			proxiedHeader.Del("Authorization")
+			proxiedHeader.Set("Authorization", "Bearer "+rawUserToken)
+		} else {
+			klog.Warningf("AUTH_WITH_SERVICE_ACCOUNT_TOKEN set but failed to read SA token: %v", err)
+		}
+	}
+
 	// NOTE (ericchiang): K8s might not enforce this but websockets requests are
-	// required to supply an origin.
-	proxiedHeader.Add("Origin", "http://localhost")
+	// required to supply an origin. Preserve any client-supplied Origin and
+	// only fall back to localhost when none is set.
+	if proxiedHeader.Get("Origin") == "" {
+		proxiedHeader.Add("Origin", "http://localhost")
+	}
 
 	dialer := &websocket.Dialer{
 		TLSClientConfig: p.config.TLSClientConfig,
diff --git a/pkg/server/server.go b/pkg/server/server.go
index d9c500c9..8dc077d4 100644
--- a/pkg/server/server.go
+++ b/pkg/server/server.go
@@ -3,6 +3,7 @@ package server
 import (
 	"context"
 	"crypto/tls"
+	"encoding/base64"
 	"encoding/json"
 	"fmt"
 	"html/template"
@@ -236,6 +237,43 @@ func init() {
 	}
 }
 
+// injectImpersonateUserHeader adds an `Impersonate-User` request header
+// derived from the authenticated user. When AUTH_PREFERRED_USER_IDENTIFIER
+// is "username" (the default) the user's email is used as-is. Otherwise the
+// User.ID is base64-decoded, stripped to hex characters, and reformatted as
+// a UUID. The header is only added when no upstream caller already provided
+// one.
+func injectImpersonateUserHeader(r *http.Request, user *auth.User) {
+	if user == nil {
+		return
+	}
+	if r.Header.Get("Impersonate-User") != "" {
+		return
+	}
+	if len(user.Username) > 0 && preferredUserIdentifier == defaultPreferredUserIdentifier {
+		if user.Email != "" {
+			r.Header.Add("Impersonate-User", user.Email)
+		}
+		return
+	}
+	decoded, err := base64.StdEncoding.DecodeString(user.ID)
+	if err != nil {
+		return
+	}
+	cleaned := strings.Map(func(c rune) rune {
+		if strings.IndexRune("0123456789abcdef", c) >= 0 {
+			return c
+		}
+		return -1
+	}, string(decoded))
+	if len(cleaned) < 32 {
+		return
+	}
+	impersonateUserID := fmt.Sprintf("%s-%s-%s-%s-%s",
+		cleaned[:8], cleaned[8:12], cleaned[12:16], cleaned[16:20], cleaned[20:32])
+	r.Header.Add("Impersonate-User", impersonateUserID)
+}
+
 func disableDirectoryListing(handler http.Handler) http.Handler {
 	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
 		// If the request is for a directory, return a 404.
@@ -374,7 +412,10 @@ func (s *Server) HTTPHandler() (http.Handler, error) {
 
 	handle(k8sProxyEndpoint, http.StripPrefix(
 		proxy.SingleJoiningSlash(s.BaseURL.Path, k8sProxyEndpoint),
-		authHandler(k8sProxy.ServeHTTP),
+		authHandlerWithUser(func(user *auth.User, w http.ResponseWriter, r *http.Request) {
+			injectImpersonateUserHeader(r, user)
+			k8sProxy.ServeHTTP(w, r)
+		}),
 	))
 
