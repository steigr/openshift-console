+// serviceAccountTokenAuth makes the requests console proxies to the k8s API
+// (/api/kubernetes/ and /api/graphql) authenticate with console's own service
+// account token while impersonating the logged-in user, for clusters whose
+// apiserver doesn't accept the user's OIDC token (see
+// --user-auth-service-account-token). Only those two endpoints swap tokens:
+// everything else keeps forwarding the user's own token, so the service
+// account token never reaches plugin backends, monitoring, or any other
+// proxied service. Without it the user's own token goes to the apiserver
+// as-is, and adding impersonation headers would be both unnecessary and
+// actively harmful (the apiserver rejects any request carrying
+// Impersonate-Group without a corresponding Impersonate-User).
+var serviceAccountTokenAuth bool
+
+// serviceAccountTokenFile is read on every request so rotated tokens are
+// picked up. A variable so tests can point it elsewhere.
+var serviceAccountTokenFile = "/var/run/secrets/kubernetes.io/serviceaccount/token"
+
+// SetServiceAccountTokenAuth enables or disables service-account-token auth
+// on k8s API requests. Set via the --user-auth-service-account-token flag.
+func SetServiceAccountTokenAuth(enabled bool) {
+	serviceAccountTokenAuth = enabled
+}
+
+// authorizeWithServiceAccountToken makes a k8s-API-bound request authenticate
+// as console's service account while impersonating the logged-in user. That
+// service account may impersonate anyone, so the identity must come from the
+// session alone: a request that picks its own is refused, and so is one whose
+// user can't be mapped to an Impersonate-User, instead of being sent as the
+// bare service account. Writes an error response and returns false when the
+// request must not be proxied. No-op unless --user-auth-service-account-token
+// is enabled.
+func authorizeWithServiceAccountToken(w http.ResponseWriter, r *http.Request, user *auth.User) bool {
+	if !serviceAccountTokenAuth {
+		return true
+	}
+	if hasClientImpersonation(r) {
+		http.Error(w, "Impersonation is not supported when console authenticates with its service account token.", http.StatusForbidden)
+		return false
+	}
+	injectImpersonateUserHeader(r, user)
+	if r.Header.Get("Impersonate-User") == "" {
+		klog.Warning("service-account-token auth: cannot derive an Impersonate-User from the session, refusing to send the request as console's service account")
+		http.Error(w, "Unable to determine the user to impersonate.", http.StatusForbidden)
+		return false
+	}
+	token, err := os.ReadFile(serviceAccountTokenFile)
+	if err == nil && strings.TrimSpace(string(token)) == "" {
+		err = fmt.Errorf("%s is empty", serviceAccountTokenFile)
+	}
+	if err != nil {
+		klog.Errorf("service-account-token auth: failed to read service account token: %v", err)
+		http.Error(w, "Service account token unavailable.", http.StatusInternalServerError)
+		return false
+	}
+	r.Header.Set("Authorization", "Bearer "+strings.TrimSpace(string(token)))
+	return true
+}
+
+// hasClientImpersonation reports whether a request picks an identity to
+// impersonate itself: any Impersonate-* header, console's own
+// X-Console-Impersonate-Groups header, or the Impersonate-User. and
+// Impersonate-Group. websocket subprotocols pkg/proxy turns into headers.
+func hasClientImpersonation(r *http.Request) bool {
+	for key := range r.Header {
+		key = http.CanonicalHeaderKey(key)
+		if strings.HasPrefix(key, "Impersonate-") || key == "X-Console-Impersonate-Groups" {
+			return true
+		}
+	}
+	for _, protocols := range r.Header.Values("Sec-Websocket-Protocol") {
+		for _, protocol := range strings.Split(protocols, ",") {
+			protocol = strings.TrimSpace(protocol)
+			if strings.HasPrefix(protocol, "Impersonate-User.") || strings.HasPrefix(protocol, "Impersonate-Group.") {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// graphQLInitPayload wraps resolver.InitPayload, which lets a GraphQL
+// websocket's connection_init payload set the identity to impersonate. With
+// service-account-token auth, a connection that asks to impersonate gets no
+// credentials at all -- the same rule authorizeWithServiceAccountToken applies
+// to the upgrade request itself.
+func graphQLInitPayload(ctx context.Context, payload json.RawMessage) context.Context {
+	if serviceAccountTokenAuth && graphQLInitPayloadImpersonates(payload) {
+		klog.Warning("service-account-token auth: dropping the credentials of a GraphQL connection that asked to impersonate")
+		return context.WithValue(ctx, resolver.HeadersKey, map[string]interface{}{})
+	}
+	return resolver.InitPayload(ctx, payload)
+}
+
+// graphQLInitPayloadImpersonates reports whether a GraphQL websocket
+// connection_init payload asks to impersonate someone, reading it the same
+// way resolver.InitPayload does.
+func graphQLInitPayloadImpersonates(payload json.RawMessage) bool {
+	var p struct {
+		User  string          `json:"Impersonate-User"`
+		Group json.RawMessage `json:"Impersonate-Group"`
+	}
+	if err := json.Unmarshal(payload, &p); err != nil {
+		return false
+	}
+	if p.User != "" {
+		return true
+	}
+	var groups []string
+	if err := json.Unmarshal(p.Group, &groups); err == nil {
+		return len(groups) > 0
+	}
+	var group string
+	return json.Unmarshal(p.Group, &group) == nil && group != ""
+}
+
+// injectImpersonateUserHeader adds an `Impersonate-User` request header
+// derived from the authenticated user. When --user-auth-preferred-user-identifier
+// is "username" (the default) the user's email is used as-is. Otherwise the
+// User.ID is base64-decoded, stripped to hex characters, and reformatted as
+// a UUID. Adds nothing when no identity can be derived. No-op unless
+// --user-auth-service-account-token is enabled.
+func injectImpersonateUserHeader(r *http.Request, user *auth.User) {
+	if !serviceAccountTokenAuth || user == nil {
+		return
+	}
+	if len(user.Username) > 0 && preferredUserIdentifier == defaultPreferredUserIdentifier {
+		if user.Email != "" {
+			r.Header.Add("Impersonate-User", user.Email)
+		}
+		return
+	}
+	decoded, err := base64.StdEncoding.DecodeString(user.ID)
+	if err != nil {
+		return
+	}
+	cleaned := strings.Map(func(c rune) rune {
+		if strings.IndexRune("0123456789abcdef", c) >= 0 {
+			return c
+		}
+		return -1
+	}, string(decoded))
+	if len(cleaned) < 32 {
+		return
+	}
+	impersonateUserID := fmt.Sprintf("%s-%s-%s-%s-%s",
+		cleaned[:8], cleaned[8:12], cleaned[12:16], cleaned[16:20], cleaned[20:32])
+	r.Header.Add("Impersonate-User", impersonateUserID)
+}
