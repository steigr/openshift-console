+	token := ls.AccessToken()
+	if os.Getenv("AUTH_WITH_SERVICE_ACCOUNT_TOKEN") == "true" {
+		if bt, readErr := os.ReadFile("/var/run/secrets/kubernetes.io/serviceaccount/token"); readErr == nil && len(bt) > 0 {
+			token = string(bt)
+		} else if readErr != nil {
+			klog.Warningf("AUTH_WITH_SERVICE_ACCOUNT_TOKEN set but failed to read service account token: %v", readErr)
+		}
+	}
+
 	return &auth.User{
 		ID:       ls.UserID(),
 		Username: ls.Username(),
-		Token:    ls.AccessToken(),
