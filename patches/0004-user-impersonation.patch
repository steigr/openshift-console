 6 files changed, 128 insertions(+), 9 deletions(-)

diff --git a/cmd/bridge/config/auth/authoptions.go b/cmd/bridge/config/auth/authoptions.go
index 16e182bc..1e8240d9 100644
--- a/cmd/bridge/config/auth/authoptions.go
+++ b/cmd/bridge/config/auth/authoptions.go
@@ -6,6 +6,7 @@ import (
 	"fmt"
 	"net/url"
 	"os"
+	"strings"
 
 	"github.com/coreos/pkg/flagutil"
 
@@ -290,7 +291,28 @@ func (c *completedOptions) getAuthenticator(
 		userAuthOIDCIssuerURL = k8sEndpoint
 	} else {
 		userAuthOIDCIssuerURL = c.IssuerURL
-		scopes = append(c.ExtraScopes, "openid")
+		appendUnique := func(dst []string, src ...string) []string {
+			seen := make(map[string]struct{}, len(dst))
+			for _, s := range dst {
+				seen[s] = struct{}{}
+			}
+			for _, s := range src {
+				if _, ok := seen[s]; ok || s == "" {
+					continue
+				}
+				seen[s] = struct{}{}
+				dst = append(dst, s)
+			}
+			return dst
+		}
+		// offline_access is required for the IdP to issue a refresh token;
+		// without it, sessions can never refresh past the access token's
+		// expiry no matter how the operator configures --user-auth-oidc-token-scopes.
+		scopes = appendUnique(append([]string{}, c.ExtraScopes...), "openid", "email", "profile", "groups", "offline_access")
+		if v := os.Getenv("OIDC_SCOPES"); v != "" {
+			scopes = appendUnique(scopes, strings.Fields(v)...)
+		}
+		klog.Infof("Using the following OIDC scopes: %v", scopes)
 
 	}
 
