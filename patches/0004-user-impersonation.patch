 	"github.com/openshift/console/pkg/auth/sessions"
@@ -149,10 +151,21 @@ func (o *oidcAuth) Authenticate(w http.ResponseWriter, r *http.Request) (*auth.U
 		return nil, err
 	}
 
+	token := ls.AccessToken()
+	if serviceAccountTokenAuth {
+		if bt, readErr := os.ReadFile("/var/run/secrets/kubernetes.io/serviceaccount/token"); readErr == nil && len(bt) > 0 {
+			token = string(bt)
+		} else if readErr != nil {
+			klog.Warningf("service-account-token auth enabled but failed to read service account token: %v", readErr)
+		}
+	}
+
 	return &auth.User{
 		ID:       ls.UserID(),
 		Username: ls.Username(),
-		Token:    ls.AccessToken(),
