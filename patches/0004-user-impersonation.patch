+)
+
+func TestAuthorizeWithServiceAccountToken(t *testing.T) {
+	tokenFile := filepath.Join(t.TempDir(), "token")
+	if err := os.WriteFile(tokenFile, []byte("console-sa-token\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	defer func(enabled bool, file string) {
+		serviceAccountTokenAuth = enabled
+		serviceAccountTokenFile = file
+	}(serviceAccountTokenAuth, serviceAccountTokenFile)
+
+	alice := &auth.User{ID: "alice-id", Username: "alice", Email: "alice@example.com", Token: "alice-oidc-token"}
+
+	tests := []struct {
+		name              string
+		disabled          bool
+		header            http.Header
+		user              *auth.User
+		tokenFile         string
+		wantStatus        int
+		wantAuthorization string
+		wantImpersonate   string
+	}{
+		{
+			name:              "disabled leaves the request alone",
+			disabled:          true,
+			header:            http.Header{"Authorization": {"Bearer alice-oidc-token"}, "Impersonate-User": {"bob@example.com"}},
+			wantAuthorization: "Bearer alice-oidc-token",
+			wantImpersonate:   "bob@example.com",
+		},
+		{
+			name:              "swaps in the service account token and impersonates the session user",
+			header:            http.Header{"Authorization": {"Bearer alice-oidc-token"}},
+			wantAuthorization: "Bearer console-sa-token",
+			wantImpersonate:   "alice@example.com",
+		},
+		{
+			name:       "refuses a client-supplied Impersonate-User",
+			header:     http.Header{"Impersonate-User": {"system:admin"}},
+			wantStatus: http.StatusForbidden,
+		},
+		{
+			name:       "refuses a client-supplied Impersonate-Group",
+			header:     http.Header{"Impersonate-Group": {"system:masters"}},
+			wantStatus: http.StatusForbidden,
+		},
+		{
+			name:       "refuses client-supplied Impersonate-Extra headers",
+			header:     http.Header{"Impersonate-Extra-Scopes": {"user:full"}},
+			wantStatus: http.StatusForbidden,
+		},
+		{
+			name:       "refuses X-Console-Impersonate-Groups",
+			header:     http.Header{"X-Console-Impersonate-Groups": {"system:masters"}},
+			wantStatus: http.StatusForbidden,
+		},
+		{
+			name:       "refuses impersonation websocket subprotocols",
+			header:     http.Header{"Sec-Websocket-Protocol": {"v4.channel.k8s.io, Impersonate-User.c3lzdGVtOmFkbWlu"}},
+			wantStatus: http.StatusForbidden,
+		},
+		{
+			name:       "refuses a session it cannot derive an Impersonate-User from",
+			user:       &auth.User{ID: "alice-id", Username: "alice", Token: "alice-oidc-token"},
+			wantStatus: http.StatusForbidden,
+		},
+		{
+			name:       "fails when the service account token is unreadable",
+			tokenFile:  filepath.Join(t.TempDir(), "missing"),
+			wantStatus: http.StatusInternalServerError,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			serviceAccountTokenAuth = !tt.disabled
+			serviceAccountTokenFile = tokenFile
+			if tt.tokenFile != "" {
+				serviceAccountTokenFile = tt.tokenFile
+			}
+			user := alice
+			if tt.user != nil {
+				user = tt.user
+			}
+			r := httptest.NewRequest(http.MethodGet, "/api/kubernetes/api/v1/namespaces", nil)
+			for key, values := range tt.header {
+				r.Header[key] = values
+			}
+			w := httptest.NewRecorder()
+
+			ok := authorizeWithServiceAccountToken(w, r, user)
+
+			if tt.wantStatus != 0 {
+				if ok || w.Code != tt.wantStatus {
+					t.Fatalf("got ok=%v status=%d, want the request refused with %d", ok, w.Code, tt.wantStatus)
+				}
+				if r.Header.Get("Authorization") == "Bearer console-sa-token" {
+					t.Errorf("refused request carries the service account token")
+				}
+				return
+			}
+			if !ok {
+				t.Fatalf("request refused with %d: %s", w.Code, w.Body.String())
+			}
+			if got := r.Header.Get("Authorization"); got != tt.wantAuthorization {
+				t.Errorf("Authorization = %q, want %q", got, tt.wantAuthorization)
+			}
+			if got := r.Header.Values("Impersonate-User"); len(got) != 1 || got[0] != tt.wantImpersonate {
+				t.Errorf("Impersonate-User = %q, want [%q]", got, tt.wantImpersonate)
+			}
+		})
+	}
+}
+
+func TestGraphQLInitPayload(t *testing.T) {
+	defer func(enabled bool) { serviceAccountTokenAuth = enabled }(serviceAccountTokenAuth)
+
+	headersAfter := func(payload string) map[string]interface{} {
+		ctx := context.WithValue(context.Background(), resolver.HeadersKey, map[string]interface{}{
+			"Authorization":    "Bearer console-sa-token",
+			"Impersonate-User": "alice@example.com",
+		})
+		return graphQLInitPayload(ctx, json.RawMessage(payload)).Value(resolver.HeadersKey).(map[string]interface{})
+	}
+	impersonating := `{"Impersonate-User":"system:admin","Impersonate-Group":["system:masters"]}`
+
+	serviceAccountTokenAuth = true
+	if headers := headersAfter(impersonating); len(headers) != 0 {
+		t.Errorf("impersonating connection kept credentials: %v", headers)
+	}
+	if headers := headersAfter(`{"X-CSRFToken":"abc"}`); headers["Impersonate-User"] != "alice@example.com" || headers["Authorization"] != "Bearer console-sa-token" {
+		t.Errorf("non-impersonating connection lost its session identity: %v", headers)
+	}
+
+	serviceAccountTokenAuth = false
+	if headers := headersAfter(impersonating); headers["Impersonate-User"] != "system:admin" {
+		t.Errorf("without service-account-token auth impersonation should reach the apiserver, which authorizes it against the user's own token: %v", headers)
+	}
+}
+
+func TestGraphQLInitPayloadImpersonates(t *testing.T) {
+	for payload, want := range map[string]bool{
+		`{"X-CSRFToken":"abc"}`:                    false,
+		`{"Impersonate-User":""}`:                  false,
+		`{"Impersonate-Group":[]}`:                 false,
+		`{"Impersonate-Group":null}`:               false,
+		`not json`:                                 false,
+		`{"Impersonate-User":"system:admin"}`:      true,
+		`{"impersonate-user":"system:admin"}`:      true,
+		`{"Impersonate-Group":"system:masters"}`:   true,
+		`{"Impersonate-Group":["system:masters"]}`: true,
+	} {
+		if got := graphQLInitPayloadImpersonates(json.RawMessage(payload)); got != want {
+			t.Errorf("graphQLInitPayloadImpersonates(%s) = %v, want %v", payload, got, want)
+		}
+	}
+}
