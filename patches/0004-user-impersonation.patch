@@ -206,6 +220,15 @@ func parseIDToken(tokenVerifier IDTokenVerifier, rawIDToken string) (*interestin
 		return nil, fmt.Errorf("token missing require claim 'sub'")
 	}
 
+	// Normalize Azure AD external user email addresses (e.g.
+	// "alice_example.com#ext#@tenant.onmicrosoft.com" -> "alice@example.com").
+	if strings.Contains(c.Email, "#ext#") {
+		c.Email = strings.SplitN(c.Email, "#ext#", 2)[0]
+		if i := strings.LastIndex(c.Email, "_"); i >= 0 {
+			c.Email = c.Email[:i] + "@" + c.Email[i+1:]
+		}
+	}
+
