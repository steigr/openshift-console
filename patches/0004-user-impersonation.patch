From 845ced25d01c2742985e2cae666113093e5d1261 Mon Sep 17 00:00:00 2001
From: Port Bot <port@local>
Date: Wed, 26 Aug 2026 12:54:17 +0200
Subject: [PATCH] 0004: user impersonation via OIDC (SA token, scopes,
 email/groups) minus OIDC_VALIDATOR

Service-account-token substitution is a --user-auth-service-account-token
flag from the start (not an env var later converted); the OIDC_SCOPES
escape hatch is dropped entirely since --user-auth-oidc-token-scopes
already covers it.
---
 cmd/bridge/config/auth/authoptions.go | 32 +++++++++++++++++++-
 pkg/auth/oauth2/auth_oidc.go          | 15 +++++++++-
 pkg/auth/oauth2/config.go             | 13 ++++++++
 pkg/auth/sessions/loginstate.go       | 31 ++++++++++++++++---
 pkg/auth/types.go                     |  2 ++
 pkg/proxy/config.go                   | 13 ++++++++
 pkg/proxy/proxy.go                    | 22 ++++++++++++--
 pkg/server/server.go                  | 43 ++++++++++++++++++++++++++-
 8 files changed, 162 insertions(+), 9 deletions(-)
 create mode 100644 pkg/auth/oauth2/config.go
 create mode 100644 pkg/proxy/config.go

diff --git a/cmd/bridge/config/auth/authoptions.go b/cmd/bridge/config/auth/authoptions.go
index b66d97bc..4b13ffd6 100644
--- a/cmd/bridge/config/auth/authoptions.go
+++ b/cmd/bridge/config/auth/authoptions.go
@@ -46,6 +46,10 @@ type AuthOptions struct {
 	// PreferredUserIdentifier selects which user attribute the k8s proxy's
 	// Impersonate-User header is derived from.
 	PreferredUserIdentifier string
+	// ServiceAccountToken substitutes the in-cluster service account token
+	// for the user's own OIDC token on outgoing k8s API calls (impersonation
+	// headers still carry the real user's identity).
+	ServiceAccountToken bool
 }
 
 type CompletedOptions struct {
@@ -68,6 +72,7 @@ type completedOptions struct {
 	LogoutRedirectURL        *url.URL
 
 	PreferredUserIdentifier string
+	ServiceAccountToken     bool
 }
 
 func NewAuthOptions() *AuthOptions {
@@ -90,6 +95,7 @@ func (c *AuthOptions) AddFlags(fs *flag.FlagSet) {
 	fs.StringVar(&c.LogoutRedirect, "user-auth-logout-redirect", "", "Optional redirect URL on logout needed for some single sign-on identity providers.")
 
 	fs.StringVar(&c.PreferredUserIdentifier, "user-auth-preferred-user-identifier", "username", "Which user attribute the k8s proxy's Impersonate-User header is derived from. 'username' (default) uses the user's email; anything else falls back to a UUID built from the user's ID.")
+	fs.BoolVar(&c.ServiceAccountToken, "user-auth-service-account-token", false, "Substitute the in-cluster service account token for the user's own OIDC token on outgoing k8s API calls. Impersonate-User/-Group headers still carry the real user's identity.")
 }
 
 func (c *AuthOptions) ApplyConfig(config *serverconfig.Auth) {
@@ -135,6 +141,7 @@ func (c *AuthOptions) Complete() (*CompletedOptions, error) {
 		OCLoginCommand:           c.OCLoginCommand,
 		StaticUserBearerToken:    c.StaticUserBearerToken,
 		PreferredUserIdentifier:  c.PreferredUserIdentifier,
+		ServiceAccountToken:      c.ServiceAccountToken,
 	}
 
 	if len(c.IssuerURL) > 0 {
@@ -231,6 +238,8 @@ func (c *completedOptions) ApplyTo(
 	srv.InactivityTimeout = c.InactivityTimeoutSeconds
 
 	server.SetPreferredUserIdentifier(c.PreferredUserIdentifier)
+	oauth2.SetServiceAccountTokenAuth(c.ServiceAccountToken)
+	proxy.SetServiceAccountTokenAuth(c.ServiceAccountToken)
 
 	useSecureCookies := srv.BaseURL.Scheme == "https"
 
@@ -301,7 +310,28 @@ func (c *completedOptions) getAuthenticator(
 		userAuthOIDCIssuerURL = k8sEndpoint
 	} else {
 		userAuthOIDCIssuerURL = c.IssuerURL
-		scopes = append(c.ExtraScopes, "openid")
+		appendUnique := func(dst []string, src ...string) []string {
+			seen := make(map[string]struct{}, len(dst))
+			for _, s := range dst {
+				seen[s] = struct{}{}
+			}
+			for _, s := range src {
+				if _, ok := seen[s]; ok || s == "" {
+					continue
+				}
+				seen[s] = struct{}{}
+				dst = append(dst, s)
+			}
+			return dst
+		}
+		// offline_access is required for the IdP to issue a refresh token;
+		// without it, sessions can never refresh past the access token's
+		// expiry no matter how the operator configures --user-auth-oidc-token-scopes.
+		// Any additional scopes belong in --user-auth-oidc-token-scopes
+		// (c.ExtraScopes) alongside the ones an operator already configures
+		// there -- no separate env-var escape hatch.
+		scopes = appendUnique(append([]string{}, c.ExtraScopes...), "openid", "email", "profile", "groups", "offline_access")
+		klog.Infof("Using the following OIDC scopes: %v", scopes)
 
 	}
 
