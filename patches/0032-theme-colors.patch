--- a/frontend/public/components/ThemeProvider.tsx
+++ b/frontend/public/components/ThemeProvider.tsx
@@ -16,15 +16,32 @@ type Theme = {
   theme: PROCESSED_THEME;
 };
 
+const THEME_COLOR_TOKEN = '--pf-t--global--background--color--secondary--default';
+
+/**
+ * Points the `theme-color` meta tag (created in index.html) at the masthead's background, so
+ * browsers that tint their own chrome from it follow the console theme. That theme can differ
+ * from the OS one, which is why this is not a pair of static `media` meta tags.
+ */
+const syncThemeColorMeta = (htmlTagElement: HTMLElement) => {
+  const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
+  const color = getComputedStyle(htmlTagElement).getPropertyValue(THEME_COLOR_TOKEN).trim();
+  if (meta && color) {
+    meta.content = color;
+  }
+};
+
 const updateThemeClass = (htmlTagElement: HTMLElement, theme: string): PROCESSED_THEME => {
   if (darkThemeMq.matches && theme === THEME_SYSTEM_DEFAULT) {
     theme = THEME_DARK;
   }
   if (theme === THEME_DARK) {
     htmlTagElement.classList.add(THEME_DARK_CLASS);
+    syncThemeColorMeta(htmlTagElement);
     return THEME_DARK;
   }
   htmlTagElement.classList.remove(THEME_DARK_CLASS);
+  syncThemeColorMeta(htmlTagElement);
   return THEME_LIGHT;
 };
 
