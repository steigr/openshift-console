index f758a2b1..39298f30 100644
--- a/frontend/public/index.html
+++ b/frontend/public/index.html
@@ -56,6 +56,52 @@
       if (theme === 'dark') {
         document.documentElement.classList.add('pf-v6-theme-dark');
       }
+      // Configured theme colors (--theme-{light,dark}-{background,content}), applied here rather
+      // than from the bundle so the first paint already has them. They override PatternFly's
+      // global background tokens, so everything derived from those follows; hover and clicked
+      // variants are derived the way PatternFly's own are (darker in light, lighter in dark).
+      // bridge only lets hex colors through, since they are written into a stylesheet verbatim.
+      (function (colors) {
+        var token = '--pf-t--global--background--color--';
+        var declarations = function (palette, toward, amount) {
+          var css = '';
+          palette = palette || {};
+          [
+            ['secondary', palette.background],
+            ['primary', palette.content],
+          ].forEach(function (entry) {
+            if (!entry[1]) {
+              return;
+            }
+            var shade = 'color-mix(in srgb, ' + entry[1] + ', ' + toward + ' ' + amount + ')';
+            css += token + entry[0] + '--default: ' + entry[1] + ';';
+            css += token + entry[0] + '--hover: ' + shade + ';';
+            css += token + entry[0] + '--clicked: ' + shade + ';';
+          });
+          return css;
+        };
+        var light = declarations(colors.light, 'black', '5%');
+        var dark = declarations(colors.dark, 'white', '8%');
+        if (light || dark) {
+          var style = document.createElement('style');
+          style.id = 'console-theme-colors';
+          // html:root outranks PatternFly's :root and :root:where(.pf-v6-theme-dark) whatever the
+          // stylesheet order.
+          style.textContent =
+            'html:root:not(.pf-v6-theme-dark) {' + light + '}' +
+            'html:root.pf-v6-theme-dark {' + dark + '}';
+          document.head.appendChild(style);
+        }
+        // Browser chrome (tab bar, title bar) follows the masthead. ThemeProvider keeps it in sync
+        // once the stylesheets are loaded; until then use the configured color or PatternFly's.
+        var meta = document.createElement('meta');
+        meta.name = 'theme-color';
+        meta.content =
+          theme === 'dark'
+            ? (colors.dark && colors.dark.background) || '#151515'
+            : (colors.light && colors.light.background) || '#f2f2f2';
+        document.head.appendChild(meta);
+      })(window.SERVER_FLAGS.theme || {});
     </script>
   </head>
 
