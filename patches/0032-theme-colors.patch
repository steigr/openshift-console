diff --git a/pkg/server/theme.go b/pkg/server/theme.go
new file mode 100644
index 00000000..cf8ac27c
--- /dev/null
+++ b/pkg/server/theme.go
@@ -0,0 +1,28 @@
+package server
+
+import "regexp"
+
+// ThemeColors are the two background colors of one console theme: Background is the frame
+// around the page (masthead, navigation sidebar, page background; PatternFly's secondary
+// background), Content the main content area (PatternFly's primary background). Empty keeps
+// the PatternFly default.
+type ThemeColors struct {
+	Background string `json:"background,omitempty"`
+	Content    string `json:"content,omitempty"`
+}
+
+// Theme holds the colors for the light and the dark theme. The frontend applies them by
+// overriding PatternFly's global background tokens before first paint, so every component
+// derived from those tokens follows.
+type Theme struct {
+	Light ThemeColors `json:"light"`
+	Dark  ThemeColors `json:"dark"`
+}
+
+var themeColorRegexp = regexp.MustCompile(`^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$`)
+
+// IsThemeColor reports whether value is empty or a CSS hex color. Theme colors are written
+// verbatim into a stylesheet, so nothing else may get through.
+func IsThemeColor(value string) bool {
+	return value == "" || themeColorRegexp.MatchString(value)
+}
diff --git a/pkg/server/theme_test.go b/pkg/server/theme_test.go
new file mode 100644
index 00000000..a03d22d2
--- /dev/null
+++ b/pkg/server/theme_test.go
@@ -0,0 +1,16 @@
+package server
+
+import "testing"
+
+func TestIsThemeColor(t *testing.T) {
+	for _, value := range []string{"", "#fff", "#FFFA", "#002b36", "#002B36CC"} {
+		if !IsThemeColor(value) {
+			t.Errorf("IsThemeColor(%q) = false, want true", value)
+		}
+	}
+	for _, value := range []string{"fff", "#ff", "#fffff", "#gggggg", "red", "#fff;}body{", "#002b36 ", "var(--x)"} {
+		if IsThemeColor(value) {
+			t.Errorf("IsThemeColor(%q) = true, want false", value)
+		}
+	}
+}
