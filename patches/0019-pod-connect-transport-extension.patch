+/**
+ * Extension point that lets a dynamic plugin take over the body of the pod
+ * "Terminal" tab with a different transport (e.g. VNC over port-forward) for
+ * containers it claims. Console core stays transport-agnostic: it only renders
+ * the extra "via" dropdown and delegates rendering to the extension.
+ */
+export const POD_CONNECT_TRANSPORT_TYPE = 'stei.gr/pod-connect-transport';
+
+export const TERMINAL_TRANSPORT_ID = 'terminal';
+
+/** One item in the toolbar's "send key" menu, e.g. Ctrl+Alt+Del or F11. */
+export type PodConnectTransportAction = {
+  /** Unique within one transport's action list. */
+  id: string;
+  /** Human readable, already translated by the extension. */
+  label: string;
+  onSelect: () => void;
+};
+
+export type PodConnectTransportProps = {
+  /** The pod being connected to. */
+  obj: PodKind;
+  /** Container currently selected in the container dropdown. */
+  containerName: string;
+  /** Impersonation subprotocols, to be sent before any k8s stream subprotocol. */
+  subprotocols: string[];
+  /** Whether the tab is currently expanded to fullscreen. */
+  isFullscreen: boolean;
+  /** Report a connection error (or null to clear it) to the surrounding toolbar. */
+  onError: (error: string | null) => void;
+  /**
+   * Replace the toolbar's "send key" menu (shown left of Expand) with these
+   * actions - e.g. offered only once actually connected. An empty array hides
+   * the menu; console resets it whenever the transport itself changes.
+   */
+  onActionsChange: (actions: PodConnectTransportAction[]) => void;
+};
+
+export type PodConnectTransport = Extension<
+  typeof POD_CONNECT_TRANSPORT_TYPE,
+  {
+    /** Unique id of this transport, must not be `terminal`. */
+    id: string;
+    /** Human readable name, shown in the "via" dropdown. */
+    label: string;
+    /** Preselect this transport for containers where `isAvailable` returns true. */
+    preferred?: boolean;
+    /** Whether this transport can be used for the given container of the given pod. */
+    isAvailable: CodeRef<(obj: PodKind, containerName: string) => boolean>;
+    /** Rendered in place of the terminal while this transport is selected. */
+    component: CodeRef<FC<PodConnectTransportProps>>;
+  }
+>;
+
+const isPodConnectTransport = (e: Extension): e is PodConnectTransport =>
+  e.type === POD_CONNECT_TRANSPORT_TYPE;
+
+const TransportSelect: FC<TransportSelectProps> = ({ transports, selected, onChange }) => {
+  const { t } = useTranslation('public');
+  const [isOpen, setIsOpen] = useState(false);
+
+  const options = useMemo(
+    () => [
+      ...transports.map(({ properties }) => ({ id: properties.id, label: properties.label })),
+      { id: TERMINAL_TRANSPORT_ID, label: t('Terminal') },
+    ],
+    [transports, t],
+  );
+
+  const onSelect: SelectProps['onSelect'] = (_event, value: string) => {
+    onChange(value);
+    setIsOpen(false);
+  };
+
+  return (
+    <Select
+      isOpen={isOpen}
+      selected={selected}
+      onSelect={onSelect}
+      onOpenChange={(open) => setIsOpen(open)}
+      toggle={(toggleRef: Ref<MenuToggleElement>) => (
+        <MenuToggle
+          ref={toggleRef}
+          onClick={() => setIsOpen(!isOpen)}
+          isExpanded={isOpen}
+          data-test="pod-connect-transport-select"
+        >
+          {options.find((o) => o.id === selected)?.label ?? t('Terminal')}
+        </MenuToggle>
+      )}
+      shouldFocusToggleOnSelect
+      popperProps={{ appendTo: 'inline' }}
+    >
+      <SelectList>
+        {options.map(({ id, label }) => (
+          <SelectOption key={id} value={id} data-test-dropdown-menu={id}>
+            {label}
+          </SelectOption>
+        ))}
+      </SelectList>
+    </Select>
+  );
+};
+
+type TransportSelectProps = {
+  transports: ResolvedExtension<PodConnectTransport>[];
+  selected: string;
+  onChange: (value: string) => void;
+};
+
+const TransportActionsMenu: FC<{ actions: PodConnectTransportAction[] }> = ({ actions }) => {
+  const { t } = useTranslation('public');
+  const [isOpen, setIsOpen] = useState(false);
+
+  if (actions.length === 0) {
+    return null;
+  }
+
+  const onSelect: SelectProps['onSelect'] = (_event, value: string) => {
+    setIsOpen(false);
+    actions.find((action) => action.id === value)?.onSelect();
+  };
+
+  return (
+    <Select
+      isOpen={isOpen}
+      onSelect={onSelect}
+      onOpenChange={(open) => setIsOpen(open)}
+      toggle={(toggleRef: Ref<MenuToggleElement>) => (
+        <MenuToggle
+          ref={toggleRef}
+          onClick={() => setIsOpen(!isOpen)}
+          isExpanded={isOpen}
+          variant="plain"
+          aria-label={t('Send key')}
+          data-test="pod-connect-transport-actions"
+        >
+          <KeyboardIcon />
+        </MenuToggle>
+      )}
+      popperProps={{ appendTo: 'inline', position: 'right' }}
+    >
+      <SelectList>
+        {actions.map(({ id, label }) => (
+          <SelectOption key={id} value={id} data-test-dropdown-menu={id}>
+            {label}
+          </SelectOption>
+        ))}
+      </SelectList>
+    </Select>
+  );
+};
