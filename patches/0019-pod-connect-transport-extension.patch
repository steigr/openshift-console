+  onActionsChange: (actions: PodConnectTransportAction[]) => void;
+  /**
+   * The target selected in the "via" dropdown, when this transport declared
+   * more than one via `targets` (e.g. which of several VNC endpoints on the
+   * same container) - see `PodConnectTransport.targets`. Undefined when the
+   * transport didn't declare `targets`, or declared at most one.
+   */
+  targetId?: string;
+};
+
+/** One selectable option a transport offers within the "via" dropdown. */
+export type PodConnectTransportTarget = {
+  /** Unique among this transport's targets for a given container. */
+  id: string;
+  /**
+   * Combined with this transport's own `label` to form the dropdown entry,
+   * e.g. transport label "VNC" + target label "Display" becomes "VNC (Display)".
+   */
+  label: string;
+};
+
+export type PodConnectTransport = Extension<
+  typeof POD_CONNECT_TRANSPORT_TYPE,
+  {
+    /** Unique id of this transport, must not be `terminal`. */
+    id: string;
+    /** Human readable name, shown in the "via" dropdown. */
+    label: string;
+    /** Preselect this transport for containers where `isAvailable` returns true. */
+    preferred?: boolean;
+    /** Whether this transport can be used for the given container of the given pod. */
+    isAvailable: CodeRef<(obj: PodKind, containerName: string) => boolean>;
+    /**
+     * When a container has more than one distinct thing this transport could
+     * connect to (e.g. multiple VNC endpoints), list them here - each becomes
+     * its own "via" dropdown entry (see `PodConnectTransportTarget`), and
+     * `component` receives the chosen one as `targetId`. Omit, or return at
+     * most one target, for a transport that only ever offers one option -
+     * the dropdown then shows just this transport's own `label`, unchanged.
+     */
+    targets?: CodeRef<(obj: PodKind, containerName: string) => PodConnectTransportTarget[]>;
+    /** Rendered in place of the terminal while this transport is selected. */
+    component: CodeRef<FC<PodConnectTransportProps>>;
+  }
+>;
+
+const isPodConnectTransport = (e: Extension): e is PodConnectTransport =>
+  e.type === POD_CONNECT_TRANSPORT_TYPE;
