+
+export type PodConnectTransport = Extension<
+  typeof POD_CONNECT_TRANSPORT_TYPE,
+  {
+    /** Unique id of this transport, must not be `terminal`. */
+    id: string;
+    /** Every connection this transport can currently offer, across all of the pod's containers. */
+    listConnections: CodeRef<(obj: PodKind) => PodConnectConnection[]>;
+    /** Rendered in place of the terminal while one of this transport's connections is selected. */
+    component: CodeRef<FC<PodConnectTransportProps>>;
+  }
+>;
+
+const isPodConnectTransport = (e: Extension): e is PodConnectTransport =>
+  e.type === POD_CONNECT_TRANSPORT_TYPE;
+
+/**
+ * Stable-sorts by `priority` ascending; items without one sort after every
+ * item that has one, keeping their relative input order among themselves.
+ */
+const sortByPriority = <T extends { priority?: number }>(items: T[]): T[] =>
+  items
+    .map((item, index) => ({ item, index }))
+    .sort((a, b) => {
+      const ap = a.item.priority ?? Number.POSITIVE_INFINITY;
+      const bp = b.item.priority ?? Number.POSITIVE_INFINITY;
+      return ap !== bp ? ap - bp : a.index - b.index;
+    })
+    .map(({ item }) => item);
+
