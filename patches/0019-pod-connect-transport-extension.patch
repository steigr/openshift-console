+/**
+ * Extension point that lets a dynamic plugin take over the body of the pod
+ * "Terminal" tab with a different transport (e.g. VNC over port-forward) for
+ * containers it claims. Console core stays transport-agnostic: it only merges
+ * each transport's connections into the single "Connecting to" dropdown
+ * (alongside a plain-exec Terminal entry per container) and delegates
+ * rendering to the extension for whichever entry is selected.
+ */
+export const POD_CONNECT_TRANSPORT_TYPE = 'stei.gr/pod-connect-transport';
+
+/** Prefix of the built-in Terminal entries' dropdown values, one per container. */
+export const TERMINAL_TRANSPORT_ID = 'terminal';
