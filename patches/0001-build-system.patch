From 0000000000000000000000000000000000000001 Mon Sep 17 00:00:00 2001
From: Port Bot <port@local>
Date: Sat, 22 Aug 2026 22:00:00 +0200
Subject: build: use a distroless final image instead of alpine and reduce
 backend binary size

---
 Dockerfile       | 34 +++++++++++++++++++++++++++-------
 build-backend.sh |  6 +++++-
 2 files changed, 32 insertions(+), 8 deletions(-)

diff --git a/Dockerfile b/Dockerfile
index 3c33de0b..71e635b9 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -1,3 +1,5 @@
+ARG DISTROLESS_BASE_IMAGE=gcr.io/distroless/static-debian12:latest
+
 ##################################################
 #
 # go backend build
@@ -12,10 +14,11 @@ RUN ./build-backend.sh
 # nodejs frontend build
 FROM registry.ci.openshift.org/ocp/builder:rhel-9-base-nodejs-openshift-4.22 AS nodebuilder
 
+WORKDIR /opt/app-root/src
 ADD . .
 USER 0
 
-WORKDIR frontend
+WORKDIR /opt/app-root/src/frontend
 ENV CYPRESS_INSTALL_BINARY=0
 
 RUN node .yarn/releases/yarn-4.12.0.cjs install --immutable && \
@@ -23,18 +26,35 @@ RUN node .yarn/releases/yarn-4.12.0.cjs install --immutable && \
 
 ##################################################
 #
-# actual base image for final product
-FROM registry.ci.openshift.org/ocp/4.22:base-rhel9
-RUN mkdir -p /opt/bridge/bin
-COPY --from=gobuilder /go/src/github.com/openshift/console/bin/bridge /opt/bridge/bin
+# assemble the runtime payload on top of the go builder, which already
+# ships ca-certificates and tar; avoids pulling in a separate alpine
+# tool stage just to compress/stage a handful of files.
+FROM gobuilder AS assets
+RUN mkdir -p /data/bin /data/pkg/graphql \
+ && cp /go/src/github.com/openshift/console/bin/bridge /data/bin/bridge \
+ && cp /go/src/github.com/openshift/console/pkg/graphql/schema.graphql /data/pkg/graphql/schema.graphql
+
+##################################################
+#
+# actual base image for final product: distroless static, not alpine -
+# no shell/package manager, smaller attack surface, CA certs and
+# nsswitch already included for the statically-linked (CGO_ENABLED=0)
+# bridge binary.
+FROM ${DISTROLESS_BASE_IMAGE}
+
+COPY --from=assets /data /
 COPY --from=nodebuilder /opt/app-root/src/frontend/public/dist /opt/bridge/static
-COPY --from=gobuilder /go/src/github.com/openshift/console/pkg/graphql/schema.graphql /pkg/graphql/schema.graphql
 
 WORKDIR /
 # doesn't require a root user.
 USER 1001
 
-CMD [ "/opt/bridge/bin/bridge", "--public-dir=/opt/bridge/static" ]
+ENV \
+  BRIDGE_PUBLIC_DIR=/opt/bridge/static \
+  PATH=/bin
+
+ENTRYPOINT []
+CMD [ "bridge", "--public-dir=/opt/bridge/static" ]
 
 LABEL \
         io.k8s.description="This is a component of OpenShift Container Platform and provides a web console." \
diff --git a/build-backend.sh b/build-backend.sh
index d80d24f5..fa538dbe 100755
--- a/build-backend.sh
+++ b/build-backend.sh
@@ -8,7 +8,11 @@ set -e
 # Use deps from vendor dir.
 export GOFLAGS="-mod=vendor"
 
+# Produce a fully static binary: the distroless "static" runtime image has
+# no libc/dynamic loader, so a CGO-linked bridge binary would fail to start.
+export CGO_ENABLED=0
+
 GIT_TAG=${SOURCE_GIT_TAG:-$(git describe --always --tags HEAD)}
-LD_FLAGS="-w -X github.com/openshift/console/pkg/version.Version=${GIT_TAG}"
+LD_FLAGS="-w -s -X github.com/openshift/console/pkg/version.Version=${GIT_TAG}"
 
 go build -ldflags "${LD_FLAGS}" -o bin/bridge github.com/openshift/console/cmd/bridge
-- 
