@@ -0,0 +1,96 @@
+import { render, screen } from '@testing-library/react';
+
+import { ChartOverlayTooltip } from '@console/internal/components/graphs/overlay-tooltip';
+
+const TOOLTIP_WIDTH = 160;
+const TOOLTIP_HEIGHT = 60;
+
+const at = new Date('2026-10-10T09:48:00Z');
+const activePoints = [
+  { x: at, y: 233, childName: 'in' },
+  { x: at, y: 81, childName: 'out' },
+];
+const legendData = [
+  { childName: 'in', name: 'in' },
+  { childName: 'out', name: 'out' },
+];
+const getLabel = ({ datum }, includeDate = true) =>
+  includeDate ? `${datum.y} at 9:48 AM` : `${datum.y} MBps`;
+
+// jsdom does no layout: give the anchor rect a screen position and the tooltip a size.
+const layout = (anchor: { left: number; top: number; bottom: number }) => {
+  jest
+    .spyOn(Element.prototype, 'getBoundingClientRect')
+    .mockReturnValue({ ...anchor, right: anchor.left, width: 0, height: 0 } as DOMRect);
+  jest.spyOn(HTMLElement.prototype, 'offsetWidth', 'get').mockReturnValue(TOOLTIP_WIDTH);
+  jest.spyOn(HTMLElement.prototype, 'offsetHeight', 'get').mockReturnValue(TOOLTIP_HEIGHT);
+};
+
+const renderTooltip = (props = {}) =>
+  render(
+    <svg>
+      <ChartOverlayTooltip
+        activePoints={activePoints}
+        center={{ x: 100, y: 30 }}
+        scale={{ y: { range: () => [70, 13] } }}
+        formatDate={() => '9:48 AM'}
+        getLabel={getLabel}
+        legendData={legendData}
+        {...props}
+      />
+    </svg>,
+  );
+
+describe('ChartOverlayTooltip', () => {
+  afterEach(() => jest.restoreAllMocks());
+
+  it('renders into document.body, above the plot, centered on the cursor', () => {
+    layout({ left: 500, top: 400, bottom: 457 });
+    const { container } = renderTooltip({ stack: true });
+
+    const tooltip = screen.getByRole('tooltip');
+    expect(container).not.toContainElement(tooltip);
+    expect(tooltip).toHaveClass('pf-m-top');
+    expect(tooltip.style.left).toBe(`${500 - TOOLTIP_WIDTH / 2}px`);
+    expect(tooltip.style.top).toBe(`${400 - 12 - TOOLTIP_HEIGHT}px`);
+    expect(tooltip.style.getPropertyValue('--pf-v6-c-tooltip--m-top--InsetInlineStart')).toBe(
+      `${TOOLTIP_WIDTH / 2}px`,
+    );
+  });
+
+  it('flips below the plot when the viewport has no room above', () => {
+    layout({ left: 500, top: 30, bottom: 87 });
+    renderTooltip({ stack: true });
+
+    const tooltip = screen.getByRole('tooltip');
+    expect(tooltip).toHaveClass('pf-m-bottom');
+    expect(tooltip.style.top).toBe(`${87 + 12}px`);
+  });
+
+  it('stays inside the viewport and keeps the arrow on the cursor', () => {
+    layout({ left: 20, top: 400, bottom: 457 });
+    renderTooltip({ stack: true });
+
+    const tooltip = screen.getByRole('tooltip');
+    expect(tooltip.style.left).toBe('8px');
+    expect(tooltip.style.getPropertyValue('--pf-v6-c-tooltip--m-top--InsetInlineStart')).toBe(
+      '12px',
+    );
+  });
+
+  it('titles a stacked chart by date and lists every series, topmost first', () => {
+    layout({ left: 500, top: 400, bottom: 457 });
+    renderTooltip({ stack: true });
+
+    const tooltip = screen.getByRole('tooltip');
+    expect(tooltip).toHaveTextContent(/^9:48 AM81 MBps out233 MBps in$/);
+  });
+
+  it('titles any other chart by its main series and lists the rest', () => {
+    layout({ left: 500, top: 400, bottom: 457 });
+    renderTooltip({ mainDataName: 'in' });
+
+    const tooltip = screen.getByRole('tooltip');
+    expect(tooltip).toHaveTextContent(/^233 at 9:48 AM81 MBps out$/);
+  });
+});
