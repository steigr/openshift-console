diff --git a/frontend/public/components/graphs/overlay-tooltip.tsx b/frontend/public/components/graphs/overlay-tooltip.tsx
new file mode 100644
index 00000000..33b65c10
--- /dev/null
+++ b/frontend/public/components/graphs/overlay-tooltip.tsx
@@ -0,0 +1,175 @@
+import type { CSSProperties, FC } from 'react';
+import { useLayoutEffect, useRef, useState } from 'react';
+import { createPortal } from 'react-dom';
+import { css } from '@patternfly/react-styles';
+
+import { DataPoint } from '.';
+
+// Space between the plot and the tooltip, taken up by the arrow (a 15px square rotated 45deg,
+// half of it outside the box).
+const ARROW_GAP = 12;
+// Distance the tooltip keeps from the viewport edges.
+const VIEWPORT_MARGIN = 8;
+// Closest the arrow may get to the tooltip's corners when the tooltip is pushed off center.
+const ARROW_INSET = 12;
+
+type Placement = {
+  left: number;
+  top: number;
+  arrowLeft: number;
+  below: boolean;
+};
+
+const samePlacement = (a: Placement, b: Placement) =>
+  a.left === b.left && a.top === b.top && a.arrowLeft === b.arrowLeft && a.below === b.below;
+
+/**
+ * Tooltip for charts too small to hold one, such as the dashboard utilization sparklines. Use as
+ * the labelComponent of a cursor voronoi container (with mouseFollowTooltips). Instead of a
+ * flyout drawn inside the chart's SVG, where it covers the data it describes and is clipped by
+ * the card around the chart, it renders a PatternFly tooltip into document.body: above the plot,
+ * arrow pointing down at the cursor line, or below the plot when the viewport has no room above.
+ */
+export const ChartOverlayTooltip: FC<ChartOverlayTooltipProps> = ({
+  activePoints = [],
+  center,
+  formatDate,
+  getLabel,
+  legendData = [],
+  mainDataName,
+  scale,
+  stack,
+  theme,
+}) => {
+  const anchorRef = useRef<SVGRectElement>(null);
+  const tooltipRef = useRef<HTMLDivElement>(null);
+  const [placement, setPlacement] = useState<Placement>();
+
+  // The anchor spans the plot vertically at the cursor; its screen position is all the placement
+  // needs, whatever the chart's padding or the page's layout.
+  const [rangeStart, rangeEnd] = scale?.y?.range?.() ?? [0, 0];
+  const plotTop = Math.min(rangeStart, rangeEnd);
+  const plotHeight = Math.abs(rangeEnd - rangeStart);
+  const cursorX = center?.x ?? 0;
+
+  // As in ChartLegendTooltip: a stacked chart is titled by its date and lists every series, any
+  // other by its main series' value and date, listing the rest.
+  let mainPoint: ActivePoint;
+  let title: string;
+  if (stack) {
+    title = formatDate(activePoints);
+  } else {
+    mainPoint = mainDataName
+      ? activePoints.find((point) => point.childName === mainDataName)
+      : activePoints[0];
+    title = mainPoint ? getLabel({ datum: mainPoint }) : `No ${mainDataName || 'data'} available`;
+  }
+
+  const colorScale: string[] = theme?.legend?.colorScale ?? [];
+  const rows = legendData.flatMap((entry, index) => {
+    const point = activePoints.find((p) => p.childName === entry.childName);
+    if (!point || point === mainPoint) {
+      return [];
+    }
+    return [
+      {
+        key: entry.childName,
+        color: entry.symbol?.fill ?? colorScale[index % colorScale.length],
+        dashed: entry.symbol?.type === 'dash',
+        text: `${getLabel({ datum: point }, false)} ${entry.name}`,
+      },
+    ];
+  });
+  if (stack) {
+    rows.reverse();
+  }
+
+  const contentKey = [title, ...rows.map((row) => row.text)].join('\n');
+
+  // Measured whenever the cursor or the text, and so the tooltip's size, changes.
+  useLayoutEffect(() => {
+    const anchor = anchorRef.current?.getBoundingClientRect();
+    const tooltip = tooltipRef.current;
+    if (!anchor || !tooltip) {
+      return;
+    }
+    const width = tooltip.offsetWidth;
+    const height = tooltip.offsetHeight;
+    const below = anchor.top - ARROW_GAP - height < VIEWPORT_MARGIN;
+    const left = Math.max(
+      VIEWPORT_MARGIN,
+      Math.min(anchor.left - width / 2, window.innerWidth - VIEWPORT_MARGIN - width),
+    );
+    const next: Placement = {
+      left,
+      top: below ? anchor.bottom + ARROW_GAP : anchor.top - ARROW_GAP - height,
+      arrowLeft: Math.max(ARROW_INSET, Math.min(anchor.left - left, width - ARROW_INSET)),
+      below,
+    };
+    setPlacement((prev) => (prev && samePlacement(prev, next) ? prev : next));
+  }, [cursorX, plotTop, plotHeight, contentKey]);
+
+  // position is set here rather than in the stylesheet, where it would tie with
+  // .pf-v6-c-tooltip's own position: relative and depend on stylesheet order.
+  const style = {
+    position: 'fixed',
+    left: placement?.left ?? 0,
+    top: placement?.top ?? 0,
+    visibility: placement ? undefined : 'hidden',
+    '--pf-v6-c-tooltip--m-top--InsetInlineStart': `${placement?.arrowLeft ?? 0}px`,
+    '--pf-v6-c-tooltip--m-bottom--InsetInlineStart': `${placement?.arrowLeft ?? 0}px`,
+  } as CSSProperties;
+
+  return (
+    <>
+      <rect ref={anchorRef} x={cursorX} y={plotTop} width={0} height={plotHeight} fill="none" />
+      {createPortal(
+        <div
+          ref={tooltipRef}
+          className={css(
+            'pf-v6-c-tooltip',
+            placement?.below ? 'pf-m-bottom' : 'pf-m-top',
+            'co-chart-overlay-tooltip',
+          )}
+          role="tooltip"
+          style={style}
+        >
+          <div className="pf-v6-c-tooltip__arrow" />
+          <div className="pf-v6-c-tooltip__content pf-m-text-align-left">
+            <div>{title}</div>
+            {rows.map((row) => (
+              <div key={row.key} className="co-chart-overlay-tooltip__row">
+                <span
+                  className={css(
+                    'co-chart-overlay-tooltip__swatch',
+                    row.dashed && 'co-chart-overlay-tooltip__swatch--dashed',
+                  )}
+                  style={{ color: row.color }}
+                />
+                {row.text}
+              </div>
+            ))}
+          </div>
+        </div>,
+        document.body,
+      )}
+    </>
+  );
+};
+ChartOverlayTooltip.displayName = 'ChartOverlayTooltip';
+
+type ActivePoint = DataPoint<Date> & { childName?: string };
+
+type ChartOverlayTooltipProps = {
+  // Passed by the voronoi container.
+  activePoints?: ActivePoint[];
+  center?: { x: number; y: number };
+  scale?: { y?: { range?: () => number[] } };
+  theme?: { legend?: { colorScale?: string[] } };
+  // Passed by the chart.
+  formatDate: (points: ActivePoint[]) => string;
+  getLabel: (prop: { datum: DataPoint<Date> }, includeDate?: boolean) => string;
+  legendData?: { childName: string; name: string; symbol?: { fill?: string; type?: string } }[];
+  mainDataName?: string;
+  stack?: boolean;
+};
