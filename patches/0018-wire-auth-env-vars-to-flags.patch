From 1900c32c3dd11fc99026d36871a30b2f8689067a Mon Sep 17 00:00:00 2001
From: Port Bot <port@local>
Date: Wed, 26 Aug 2026 11:56:42 +0200
Subject: [PATCH] 0018: wire hidden env-var auth switches to CLI flags

Replaces AUTH_PREFERRED_USER_IDENTIFIER, AUTH_WITH_SERVICE_ACCOUNT_TOKEN,
OIDC_GROUP_MATCHER, OIDC_EXCLUDE_GROUP_MATCHER, and KUBEADMIN_GROUP_NAME
env vars with discoverable --user-auth-* CLI flags (still passable via
Helm chart args), and drops the redundant OIDC_SCOPES env-var escape
hatch (--user-auth-oidc-token-scopes already covers it).
---
 cmd/bridge/config/auth/authoptions.go | 45 ++++++++++++++++++++++++---
 pkg/auth/config.go                    | 18 +++++++++++
 pkg/auth/metrics.go                   |  5 ---
 pkg/auth/oauth2/auth_oidc.go          |  4 +--
 pkg/auth/oauth2/config.go             | 13 ++++++++
 pkg/proxy/config.go                   | 13 ++++++++
 pkg/proxy/proxy.go                    |  4 +--
 pkg/server/server.go                  | 33 +++++++++++++++-----
 8 files changed, 114 insertions(+), 21 deletions(-)
 create mode 100644 pkg/auth/config.go
 create mode 100644 pkg/auth/oauth2/config.go
 create mode 100644 pkg/proxy/config.go

diff --git a/cmd/bridge/config/auth/authoptions.go b/cmd/bridge/config/auth/authoptions.go
index 1e8240d9..5e542279 100644
--- a/cmd/bridge/config/auth/authoptions.go
+++ b/cmd/bridge/config/auth/authoptions.go
@@ -6,7 +6,6 @@ import (
 	"fmt"
 	"net/url"
 	"os"
-	"strings"
 
 	"github.com/coreos/pkg/flagutil"
 
@@ -43,6 +42,21 @@ type AuthOptions struct {
 
 	InactivityTimeoutSeconds int
 	LogoutRedirect           string
+
+	// PreferredUserIdentifier selects which user attribute the k8s proxy's
+	// Impersonate-User header is derived from.
+	PreferredUserIdentifier string
+	// ServiceAccountToken substitutes the in-cluster service account token
+	// for the user's own OIDC token on outgoing k8s API calls (impersonation
+	// headers still carry the real user's identity).
+	ServiceAccountToken bool
+	// OIDCGroupMatcher/OIDCExcludeGroupMatcher optionally filter which of the
