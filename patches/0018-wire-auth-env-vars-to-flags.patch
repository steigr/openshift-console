+	OIDCGroupMatcher        string
+	OIDCExcludeGroupMatcher string
+	// KubeAdminGroupName is the group-name suffix used to detect a
+	// cluster-admin-equivalent user when user.openshift.io/v1 is unavailable.
+	KubeAdminGroupName string
 }
 
 type CompletedOptions struct {
@@ -63,6 +77,12 @@ type completedOptions struct {
 
 	InactivityTimeoutSeconds int
 	LogoutRedirectURL        *url.URL
+
+	PreferredUserIdentifier string
+	ServiceAccountToken     bool
+	OIDCGroupMatcher        string
+	OIDCExcludeGroupMatcher string
+	KubeAdminGroupName      string
 }
 
 func NewAuthOptions() *AuthOptions {
@@ -83,6 +103,12 @@ func (c *AuthOptions) AddFlags(fs *flag.FlagSet) {
 
 	fs.IntVar(&c.InactivityTimeoutSeconds, "inactivity-timeout", 0, "Number of seconds, after which user will be logged out if inactive. Ignored if less than 300 seconds (5 minutes).")
 	fs.StringVar(&c.LogoutRedirect, "user-auth-logout-redirect", "", "Optional redirect URL on logout needed for some single sign-on identity providers.")
+
+	fs.StringVar(&c.PreferredUserIdentifier, "user-auth-preferred-user-identifier", "username", "Which user attribute the k8s proxy's Impersonate-User header is derived from. 'username' (default) uses the user's email; anything else falls back to a UUID built from the user's ID.")
+	fs.BoolVar(&c.ServiceAccountToken, "user-auth-service-account-token", false, "Substitute the in-cluster service account token for the user's own OIDC token on outgoing k8s API calls. Impersonate-User/-Group headers still carry the real user's identity.")
+	fs.StringVar(&c.OIDCGroupMatcher, "user-auth-oidc-group-matcher", "", "Regular expression allow-list: only groups matching this pattern are forwarded as Impersonate-Group headers. Empty (default) forwards every group.")
+	fs.StringVar(&c.OIDCExcludeGroupMatcher, "user-auth-oidc-exclude-group-matcher", "", "Regular expression deny-list: groups matching this pattern are never forwarded as Impersonate-Group headers.")
+	fs.StringVar(&c.KubeAdminGroupName, "user-auth-kubeadmin-group-name", "-KubeAdmin", "Group-name suffix used to detect a cluster-admin-equivalent user when the OpenShift user.openshift.io/v1 API is unavailable.")
 }
 
 func (c *AuthOptions) ApplyConfig(config *serverconfig.Auth) {
@@ -127,6 +153,11 @@ func (c *AuthOptions) Complete() (*CompletedOptions, error) {
 		InactivityTimeoutSeconds: c.InactivityTimeoutSeconds,
 		OCLoginCommand:           c.OCLoginCommand,
 		StaticUserBearerToken:    c.StaticUserBearerToken,
+		PreferredUserIdentifier:  c.PreferredUserIdentifier,
+		ServiceAccountToken:      c.ServiceAccountToken,
+		OIDCGroupMatcher:         c.OIDCGroupMatcher,
+		OIDCExcludeGroupMatcher:  c.OIDCExcludeGroupMatcher,
+		KubeAdminGroupName:       c.KubeAdminGroupName,
 	}
 
 	if len(c.IssuerURL) > 0 {
@@ -222,6 +253,12 @@ func (c *completedOptions) ApplyTo(
 ) error {
 	srv.InactivityTimeout = c.InactivityTimeoutSeconds
 
+	server.SetPreferredUserIdentifier(c.PreferredUserIdentifier)
+	server.SetOIDCGroupMatchers(c.OIDCGroupMatcher, c.OIDCExcludeGroupMatcher)
+	auth.SetKubeAdminGroupName(c.KubeAdminGroupName)
+	oauth2.SetServiceAccountTokenAuth(c.ServiceAccountToken)
+	proxy.SetServiceAccountTokenAuth(c.ServiceAccountToken)
+
 	useSecureCookies := srv.BaseURL.Scheme == "https"
 
 	if c.AuthType == flagvalues.AuthTypeDisabled && c.StaticUserBearerToken != "" {
@@ -308,10 +345,10 @@ func (c *completedOptions) getAuthenticator(
 		// offline_access is required for the IdP to issue a refresh token;
 		// without it, sessions can never refresh past the access token's
 		// expiry no matter how the operator configures --user-auth-oidc-token-scopes.
+		// Any additional scopes belong in --user-auth-oidc-token-scopes
+		// (c.ExtraScopes) alongside the ones an operator already configures
+		// there -- no separate env-var escape hatch.
 		scopes = appendUnique(append([]string{}, c.ExtraScopes...), "openid", "email", "profile", "groups", "offline_access")
-		if v := os.Getenv("OIDC_SCOPES"); v != "" {
-			scopes = appendUnique(scopes, strings.Fields(v)...)
-		}
 		klog.Infof("Using the following OIDC scopes: %v", scopes)
 
 	}
diff --git a/pkg/auth/config.go b/pkg/auth/config.go
new file mode 100644
index 00000000..cb74359f
--- /dev/null
+++ b/pkg/auth/config.go
@@ -0,0 +1,18 @@
+package auth
+
+// defaultKubeAdminGroupName is the group-name suffix used to detect a
+// cluster-admin-equivalent user when the OpenShift user.openshift.io/v1 API
+// is unavailable (see Metrics.isKubeAdmin).
+const defaultKubeAdminGroupName = "-KubeAdmin"
+
+var kubeAdminGroupName = defaultKubeAdminGroupName
+
+// SetKubeAdminGroupName sets the group-name suffix Metrics.isKubeAdmin
+// matches against a user's groups. Set via the
+// --user-auth-kubeadmin-group-name flag; falls back to
+// defaultKubeAdminGroupName when given an empty string.
+func SetKubeAdminGroupName(name string) {
+	if name != "" {
+		kubeAdminGroupName = name
+	}
+}
