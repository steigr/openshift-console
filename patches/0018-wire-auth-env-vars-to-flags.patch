@@ -152,11 +152,11 @@ func (o *oidcAuth) Authenticate(w http.ResponseWriter, r *http.Request) (*auth.U
 	}
 
 	token := ls.AccessToken()
-	if os.Getenv("AUTH_WITH_SERVICE_ACCOUNT_TOKEN") == "true" {
