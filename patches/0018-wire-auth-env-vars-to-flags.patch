+	oidcGroupMatcher        string
+	oidcExcludeGroupMatcher string
 )
 
-func init() {
-	// get AUTH_PREFERRED_USER_IDENTIFIER from env, if not set, use "username" as default
-	preferredUserIdentifier = os.Getenv("AUTH_PREFERRED_USER_IDENTIFIER")
-	if preferredUserIdentifier == "" {
-		preferredUserIdentifier = defaultPreferredUserIdentifier
+// SetPreferredUserIdentifier selects which user attribute the k8s proxy's
+// Impersonate-User header is derived from ("username", using the user's
+// email, by default; anything else falls back to a UUID built from the
+// user's ID). Set via the --user-auth-preferred-user-identifier flag.
+func SetPreferredUserIdentifier(identifier string) {
+	if identifier != "" {
+		preferredUserIdentifier = identifier
 	}
 }
 
+// SetOIDCGroupMatchers sets the allow-list and deny-list regular expressions
+// used by injectImpersonateGroupHeaders. Set via the
+// --user-auth-oidc-group-matcher / --user-auth-oidc-exclude-group-matcher
+// flags.
+func SetOIDCGroupMatchers(groupMatcher, excludeGroupMatcher string) {
+	oidcGroupMatcher = groupMatcher
+	oidcExcludeGroupMatcher = excludeGroupMatcher
+}
+
 // injectImpersonateUserHeader adds an `Impersonate-User` request header
 // derived from the authenticated user. When AUTH_PREFERRED_USER_IDENTIFIER
 // is "username" (the default) the user's email is used as-is. Otherwise the
@@ -282,8 +299,8 @@ func injectImpersonateGroupHeaders(r *http.Request, user *auth.User) {
 	if user == nil || len(user.Groups) == 0 {
 		return
 	}
-	groupMatcher := os.Getenv("OIDC_GROUP_MATCHER")
-	excludedGroupMatcher := os.Getenv("OIDC_EXCLUDE_GROUP_MATCHER")
+	groupMatcher := oidcGroupMatcher
+	excludedGroupMatcher := oidcExcludeGroupMatcher
 	for _, group := range user.Groups {
 		if excludedGroupMatcher == "" && groupMatcher == "" {
 			r.Header.Add("Impersonate-Group", group)
-- 
