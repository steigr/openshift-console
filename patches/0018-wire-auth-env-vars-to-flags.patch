@@ -189,10 +188,6 @@ func (m *Metrics) isKubeAdmin(ctx context.Context, config *rest.Config, ls *sess
 	// OIDC), fall back to a configurable group-suffix check against the
 	// caller's identity claims (Groups). The group name is matched by
 	// suffix to allow customer-specific prefixes.
-	kubeAdminGroupName := os.Getenv("KUBEADMIN_GROUP_NAME")
-	if kubeAdminGroupName == "" {
-		kubeAdminGroupName = "-KubeAdmin"
-	}
 	if ls == nil {
 		return false, fmt.Errorf("loginState is nil")
 	}
diff --git a/pkg/auth/oauth2/auth_oidc.go b/pkg/auth/oauth2/auth_oidc.go
