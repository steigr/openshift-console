 frontend/@types/console/window.d.ts           |   2 +
 .../src/components/nodes/NodesPage.tsx        | 138 ++++++++++++++++--
 pkg/server/server.go                          |   3 +
 4 files changed, 132 insertions(+), 13 deletions(-)

