@@ -868,6 +877,186 @@ const NodeList: FC<NodeListProps> = ({
   );
 };
 
+type NodeGroupMetrics = {
+  pods?: number;
+  cpu?: number;
+  totalCPU?: number;
+  usedMemory?: number;
+  totalMemory?: number;
+};
+
+type NodeGroup = {
+  key: string;
+  title: string;
+  items: NodeListProps['data'];
+  metrics?: NodeGroupMetrics;
+};
+
+// The empty-value bucket (nodes missing the grouping label) always sorts
+// last, after every real label value, using titleKey so it participates in
+// the same locale-aware sort as the rest instead of a separate splice.
+const groupNodesByLabel = (
+  data: NodeListProps['data'],
+  label: string,
+  noValueTitle: string,
+): NodeGroup[] => {
+  const buckets = new Map<string, NodeListProps['data']>();
+  data.forEach((item) => {
+    const value = item.metadata?.labels?.[label] || '';
+    const bucket = buckets.get(value);
+    if (bucket) {
+      bucket.push(item);
+    } else {
+      buckets.set(value, [item]);
+    }
+  });
+
+  return Array.from(buckets.entries())
+    .map(([value, items]) => ({
+      key: value,
+      title: value || noValueTitle,
+      titleKey: value ? `0${value}` : `1${noValueTitle}`,
+      items,
+    }))
+    .sort((a, b) => a.titleKey.localeCompare(b.titleKey))
+    .map(({ key, title, items }) => ({ key, title, items }));
+};
+
+// Sums a per-node metric (keyed by node name, e.g. nodeMetrics.cpu) across a
+// group's nodes. CSR pseudo-nodes never carry metrics and are skipped.
+// Returns undefined (rendered as DASH) rather than 0 when no node in the
+// group reported that metric, so "no data yet" isn't confused with "zero".
+const sumNodeMetric = (
+  items: NodeListProps['data'],
+  metric: NodeMetrics[keyof NodeMetrics] | undefined,
+): number | undefined => {
+  let sum = 0;
+  let found = false;
+  items.forEach((item) => {
+    if (isCSRResource(item)) {
+      return;
+    }
+    const value = metric?.[getName(item as NodeKind)];
+    if (Number.isFinite(value)) {
+      sum += value;
+      found = true;
+    }
+  });
+  return found ? sum : undefined;
+};
+
+const aggregateNodeGroupMetrics = (
+  items: NodeListProps['data'],
+  nodeMetrics: NodeMetrics,
+): NodeGroupMetrics => ({
+  pods: sumNodeMetric(items, nodeMetrics?.pods),
+  cpu: sumNodeMetric(items, nodeMetrics?.cpu),
+  totalCPU: sumNodeMetric(items, nodeMetrics?.totalCPU),
+  usedMemory: sumNodeMetric(items, nodeMetrics?.usedMemory),
+  totalMemory: sumNodeMetric(items, nodeMetrics?.totalMemory),
+});
+
+const NodeGroupMetricsBar: FC<{ metrics: NodeGroupMetrics }> = ({ metrics }) => {
+  const { t } = useTranslation();
+  const hasCPU = Number.isFinite(metrics.cpu) && Number.isFinite(metrics.totalCPU);
+  const hasMemory = Number.isFinite(metrics.usedMemory) && Number.isFinite(metrics.totalMemory);
+
+  return (
+    <Flex spaceItems={{ default: 'spaceItemsMd' }} flexWrap={{ default: 'nowrap' }}>
+      <FlexItem>
+        {t('console-app~Pods: {{pods}}', {
+          pods: Number.isFinite(metrics.pods) ? metrics.pods : DASH,
+        })}
+      </FlexItem>
+      <FlexItem>
+        {t('console-app~CPU: {{used}} / {{available}} cores', {
+          used: hasCPU ? formatCores(metrics.cpu) : DASH,
+          available: hasCPU ? metrics.totalCPU : DASH,
+        })}
+      </FlexItem>
+      <FlexItem>
+        {t('console-app~Memory: {{used}} / {{available}}', {
+          used: hasMemory ? humanizeBinaryBytes(metrics.usedMemory).string : DASH,
+          available: hasMemory ? humanizeBinaryBytes(metrics.totalMemory).string : DASH,
+        })}
+      </FlexItem>
+    </Flex>
+  );
+};
+
+type NodeGroupsListProps = NodeListProps & {
+  nodeGroupingLabel: string;
+};
+
+const NodeGroupsList: FC<NodeGroupsListProps> = ({ data, nodeGroupingLabel, ...rest }) => {
+  const { t } = useTranslation();
+  const [collapsedGroups, setCollapsedGroups] = useState<Set<string>>(new Set());
+  const nodeMetrics = useConsoleSelector<NodeMetrics>(({ UI }) => UI.getIn(['metrics', 'node']));
+
+  const toggleGroup = useCallback((key: string) => {
+    setCollapsedGroups((prev) => {
+      const next = new Set(prev);
+      if (next.has(key)) {
+        next.delete(key);
+      } else {
+        next.add(key);
+      }
+      return next;
+    });
+  }, []);
+
+  const noValueTitle = t('console-app~No "{{label}}" label', { label: nodeGroupingLabel });
+
+  const groups = useMemo(() => {
+    const base = groupNodesByLabel(data, nodeGroupingLabel, noValueTitle);
+    // Monitoring availability (Prometheus wired up at all) gates the whole
+    // metrics bar, independent of whether any query has resolved yet.
+    return PROMETHEUS_BASE_PATH
+      ? base.map((group) => ({
+          ...group,
+          metrics: aggregateNodeGroupMetrics(group.items, nodeMetrics),
+        }))
+      : base;
+  }, [data, nodeGroupingLabel, noValueTitle, nodeMetrics]);
+
+  return (
+    <Accordion asDefinitionList={false}>
+      {groups.map((group) => {
+        const isExpanded = !collapsedGroups.has(group.key);
+        return (
+          <AccordionItem key={group.key || '__no_value__'} isExpanded={isExpanded}>
+            <AccordionToggle
+              id={`node-group-${group.key || '__no_value__'}-toggle`}
+              onClick={() => toggleGroup(group.key)}
+            >
+              <Flex
+                justifyContent={{ default: 'justifyContentSpaceBetween' }}
+                alignItems={{ default: 'alignItemsCenter' }}
+                flexWrap={{ default: 'nowrap' }}
+              >
+                <FlexItem>
+                  {t('console-app~{{title}} ({{count}})', {
+                    title: group.title,
+                    count: group.items.length,
+                  })}
+                </FlexItem>
+                {group.metrics && (
+                  <FlexItem>
+                    <NodeGroupMetricsBar metrics={group.metrics} />
+                  </FlexItem>
+                )}
+              </Flex>
+            </AccordionToggle>
+            <AccordionContent>
+              {isExpanded && <NodeList {...rest} data={group.items} />}
+            </AccordionContent>
+          </AccordionItem>
+        );
+      })}
+    </Accordion>
+  );
+};
+
 type NodeRowItem = (NodeKind | NodeCertificateSigningRequestKind) & {
   machineOwner?: OwnerReference;
   machineConfigPool?: MachineConfigPoolKind;
