@@ -0,0 +1,111 @@
+import { WSFactory } from '../ws-factory';
+
+class FakeWebSocket {
+  static readonly CONNECTING = 0;
+
+  static readonly OPEN = 1;
+
+  static readonly CLOSING = 2;
+
+  static readonly CLOSED = 3;
+
+  static instances: FakeWebSocket[] = [];
+
+  readyState = FakeWebSocket.CONNECTING;
+
+  sent: string[] = [];
+
+  onopen: () => void;
+
+  onclose: (evt: Partial<CloseEvent>) => void;
+
+  onerror: (evt: Event) => void;
+
+  onmessage: (evt: { data: string }) => void;
+
+  constructor() {
+    FakeWebSocket.instances.push(this);
+  }
+
+  send(data: string) {
+    // What browsers do: https://websockets.spec.whatwg.org/#dom-websocket-send
+    if (this.readyState === FakeWebSocket.CONNECTING) {
+      throw new DOMException('Still in CONNECTING state.', 'InvalidStateError');
+    }
+    this.sent.push(data);
+  }
+
+  close() {
+    this.readyState = FakeWebSocket.CLOSED;
+  }
+
+  open() {
+    this.readyState = FakeWebSocket.OPEN;
+    this.onopen();
+  }
+}
+
+describe('WSFactory.send', () => {
+  const originalWebSocket = window.WebSocket;
+  const options = { host: 'ws://example', path: '/exec', subprotocols: [] };
+
+  beforeEach(() => {
+    FakeWebSocket.instances = [];
+    window.WebSocket = (FakeWebSocket as unknown) as typeof WebSocket;
+    jest.spyOn(console, 'log').mockImplementation(() => {});
+  });
+
+  afterEach(() => {
+    window.WebSocket = originalWebSocket;
+    jest.restoreAllMocks();
+  });
+
+  it('queues data sent while connecting and sends it, in order, before open handlers run', () => {
+    const ws = new WSFactory('test', options);
+    const socket = FakeWebSocket.instances[0];
+    const seenOnOpen: string[][] = [];
+    ws.onopen(() => seenOnOpen.push([...socket.sent]));
+
+    expect(() => ws.send('a')).not.toThrow();
+    ws.send('b');
+    expect(socket.sent).toEqual([]);
+
+    socket.open();
+    expect(socket.sent).toEqual(['a', 'b']);
+    expect(seenOnOpen).toEqual([['a', 'b']]);
+
+    ws.send('c');
+    expect(socket.sent).toEqual(['a', 'b', 'c']);
+  });
+
+  it('drops queued data when destroyed before the socket opens', () => {
+    const ws = new WSFactory('test', options);
+    const socket = FakeWebSocket.instances[0];
+
+    // PodConnect's unmount cleanup: type "exit" into the shell, then destroy.
+    'exit\r'.split('').forEach((c) => ws.send(c));
+    ws.destroy();
+
+    expect(socket.sent).toEqual([]);
+    expect(() => ws.send('x')).not.toThrow();
+  });
+
+  it('does not carry queued data over to a reconnected socket', () => {
+    jest.useFakeTimers();
+    try {
+      const ws = new WSFactory('test', { ...options, reconnect: true });
+      const first = FakeWebSocket.instances[0];
+      ws.send('stale');
+      first.close();
+      first.onclose({ wasClean: false });
+
+      jest.advanceTimersByTime(1000);
+      const second = FakeWebSocket.instances[1];
+      second.open();
+      expect(second.sent).toEqual([]);
+      ws.destroy();
+    } finally {
+      jest.useRealTimers();
+    }
+  });
+});
