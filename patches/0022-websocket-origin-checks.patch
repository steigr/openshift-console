+// allowOrigin reports whether a websocket may be proxied for a browser that
+// sent the given Origin header values to target: any origin when the proxy has
+// no configured Origin, otherwise only that one.
+func (p *Proxy) allowOrigin(origin []string, target *url.URL) bool {
+	if p.config.Origin == "" {
+		klog.Infof("CheckOrigin: Proxy has no configured Origin. Allowing origin %v to %v", origin, target)
+		return true
+	}
+	if len(origin) == 0 {
+		klog.Warningf("CheckOrigin: No origin header. Denying request to %v", target)
+		return false
+	}
+	if p.config.Origin == origin[0] {
+		return true
+	}
+	klog.Warningf("CheckOrigin '%v' != '%v'", p.config.Origin, origin[0])
+	return false
+}
