+func TestWebSocketSourceOrigin(t *testing.T) {
+	refererURL, err := url.Parse(validReferer)
+	require.NoError(t, err)
+
+	for _, tt := range []struct {
+		name       string
+		refererURL *url.URL
+		origin     string
+		websocket  bool
+		accept     bool
+	}{
+		{name: "same-origin websocket", refererURL: refererURL, origin: "https://example.com", websocket: true, accept: true},
+		{name: "cross-origin websocket", refererURL: refererURL, origin: "https://evil.example.com", websocket: true},
+		{name: "websocket without origin", refererURL: refererURL, websocket: true},
+		{name: "cross-origin GET that isn't a websocket", refererURL: refererURL, origin: "https://evil.example.com", accept: true},
+		{name: "console origin unknown", refererURL: &url.URL{Path: "/"}, origin: "https://evil.example.com", websocket: true, accept: true},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			r, err := http.NewRequest(http.MethodGet, "/api/graphql", nil)
+			require.NoError(t, err)
+			if tt.origin != "" {
+				r.Header.Set("Origin", tt.origin)
+			}
+			if tt.websocket {
+				r.Header.Set("Connection", "Upgrade")
+				r.Header.Set("Upgrade", "websocket")
+			}
+
+			err = (&CSRFVerifier{refererURL: tt.refererURL}).verifyCSRF(r)
+			if tt.accept {
+				require.NoError(t, err)
+			} else {
+				require.Error(t, err)
+			}
+		})
+	}
+}
