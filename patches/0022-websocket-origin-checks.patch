diff --git a/pkg/proxy/proxy_test.go b/pkg/proxy/proxy_test.go
index f6bcbe89..4a265887 100644
--- a/pkg/proxy/proxy_test.go
+++ b/pkg/proxy/proxy_test.go
@@ -6,11 +6,73 @@ import (
 	"net/http/httptest"
 	"net/url"
 	"strings"
+	"sync/atomic"
 	"testing"
 
 	"github.com/gorilla/websocket"
 )
 
+func TestProxyWebsocketOrigin(t *testing.T) {
+	var dials int32
+	backend := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		atomic.AddInt32(&dials, 1)
+		upgrader := &websocket.Upgrader{CheckOrigin: func(*http.Request) bool { return true }}
+		ws, err := upgrader.Upgrade(w, r, nil)
+		if err != nil {
+			return
+		}
+		ws.Close()
+	}))
+	defer backend.Close()
+	backendURL, err := url.Parse(backend.URL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Plugin proxies blacklist Origin; the origin check must still see it.
+	proxyServer := httptest.NewServer(NewProxy(&Config{
+		Endpoint:        backendURL,
+		HeaderBlacklist: []string{"Cookie", "X-CSRFToken", "Origin"},
+		Origin:          "https://console.example.com",
+	}))
+	defer proxyServer.Close()
+
+	for _, tt := range []struct {
+		name   string
+		origin string
+		accept bool
+	}{
+		{name: "console origin", origin: "https://console.example.com", accept: true},
+		{name: "foreign origin", origin: "https://evil.example.com"},
+		{name: "no origin"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			atomic.StoreInt32(&dials, 0)
+			headers := http.Header{}
+			if tt.origin != "" {
+				headers.Set("Origin", tt.origin)
+			}
+			ws, resp, err := websocket.DefaultDialer.Dial(toWSScheme(proxyServer.URL), headers)
+			if tt.accept {
+				if err != nil {
+					t.Fatalf("error connecting with origin %q: %v", tt.origin, err)
+				}
+				ws.Close()
+				return
+			}
+			if err == nil {
+				ws.Close()
+				t.Fatalf("websocket with origin %q was accepted", tt.origin)
+			}
+			if resp == nil || resp.StatusCode != http.StatusForbidden {
+				t.Errorf("got response %v, want status %d", resp, http.StatusForbidden)
+			}
+			if n := atomic.LoadInt32(&dials); n != 0 {
+				t.Errorf("backend was dialed %d times for a refused origin", n)
+			}
+		})
+	}
+}
