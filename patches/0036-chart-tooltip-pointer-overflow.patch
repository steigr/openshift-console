+// Whether the flyout goes right of the cursor: when it fits there, else left when it fits there,
+// else whichever side has more room. In a narrow chart (a dashboard sparkline) neither side may
+// fit, and PatternFly then clamps the flyout into the chart, over the hovered point, where its
+// pointer has nothing to point at. Overflowing the chart instead is fine: tooltips render into
+// Victory's portal <svg>, which is overflow: visible.
+const isFlyoutOnRight = (
+  center: { x: number },
+  flyoutWidth: number,
+  pointerLength: number,
+  width: number,
+) =>
+  width > center.x + flyoutWidth + pointerLength ||
+  (center.x < flyoutWidth + pointerLength && width - center.x >= center.x);
