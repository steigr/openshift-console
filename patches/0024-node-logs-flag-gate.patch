 // this tab exactly as before.
 const NODE_TERMINAL_PLUGIN_FLAG = 'TERMINAL_PLUGIN_NODE_TERMINAL_ENABLED';
 
+// Set by the `logging` console plugin's console.flag handler
+// (plugins/logging/src/flags.ts) once its own backend reports
+// NODE_LOGS_ENABLED - while active, that plugin contributes its own Node
+// "Logs" tab (a console.tab/horizontalNav extension) that this core tab
+// steps aside for, so exactly one is ever shown. Unset (the default, and
+// the state on an unpatched console with no such plugin installed) leaves
+// this tab exactly as before.
+const NODE_LOGS_PLUGIN_FLAG = 'LOGGING_PLUGIN_NODE_LOGS_ENABLED';
+
 export const NodeDetailsPage: FC<ComponentProps<typeof DetailsPage>> = (props) => {
   const nodeTerminalPluginActive = useFlag(NODE_TERMINAL_PLUGIN_FLAG);
+  const nodeLogsPluginActive = useFlag(NODE_LOGS_PLUGIN_FLAG);
