+package server
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestSetDefaultFieldManager(t *testing.T) {
+	tests := []struct {
+		method, url, want string
+	}{
+		{http.MethodPut, "/apis/apps/v1/namespaces/a/deployments/b", "fieldManager=openshift-console"},
+		{http.MethodPatch, "/api/v1/pods/x?dryRun=All", "dryRun=All&fieldManager=openshift-console"},
+		{http.MethodPost, "/api/v1/pods", "fieldManager=openshift-console"},
+		{http.MethodPut, "/api/v1/pods/x?fieldManager=mine", "fieldManager=mine"},
+		{http.MethodGet, "/api/v1/pods", ""},
+		{http.MethodDelete, "/api/v1/pods/x", ""},
+	}
+	for _, tt := range tests {
+		r := httptest.NewRequest(tt.method, tt.url, nil)
+		setDefaultFieldManager(r)
+		if got := r.URL.RawQuery; got != tt.want {
+			t.Errorf("%s %s: query = %q, want %q", tt.method, tt.url, got, tt.want)
+		}
+	}
+}
