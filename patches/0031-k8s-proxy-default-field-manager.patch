+// defaultFieldManager names console in metadata.managedFields. Without a
+// ?fieldManager= query parameter the apiserver derives the manager from the
+// request's User-Agent, which for browser requests is just "Mozilla".
+const defaultFieldManager = "openshift-console"
+
+// setDefaultFieldManager gives writes that don't name their own field manager
+// a descriptive one. Reads and requests that already set it are left alone.
+func setDefaultFieldManager(r *http.Request) {
+	switch r.Method {
+	case http.MethodPost, http.MethodPut, http.MethodPatch:
+	default:
+		return
+	}
+	q := r.URL.Query()
+	if q.Has("fieldManager") {
+		return
+	}
+	q.Set("fieldManager", defaultFieldManager)
+	r.URL.RawQuery = q.Encode()
+}
+
 // authorizeWithServiceAccountToken makes a k8s-API-bound request authenticate
 // as console's service account while impersonating the logged-in user. That
 // service account may impersonate anyone, so the identity must come from the
@@ -616,6 +637,7 @@ func (s *Server) HTTPHandler() (http.Handler, error) {
 			if !authorizeWithServiceAccountToken(w, r, user) {
 				return
 			}
+			setDefaultFieldManager(r)
 			k8sProxy.ServeHTTP(w, r)
 		}),
