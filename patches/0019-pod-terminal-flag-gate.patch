 import { Status } from '@console/shared/src/components/status/Status';
 import { ByteDataTypes } from '@console/shared/src/graph-helper/data-utils';
+import { useFlag } from '@console/shared/src/hooks/useFlag';
 import { usePrometheusGate } from '@console/shared/src/hooks/usePrometheusGate';
 import {
   Card,
@@ -489,8 +490,18 @@ export const PodConnectLoader: FC<PodConnectLoaderProps> = ({
     </Grid>
   </PaneBody>
 );
+// Set by the `terminal` console plugin's console.flag handler
+// (plugins/terminal/src/flags/terminalFlags.ts) once its own backend reports
+// POD_TERMINAL_ENABLED - while active, that plugin contributes its own Pod
+// "Terminal" tab (a console.tab/horizontalNav extension) that this core tab
+// steps aside for, so exactly one is ever shown. Unset (the default, and
+// the state on an unpatched console with no such plugin installed) leaves
+// this tab exactly as before.
+const POD_TERMINAL_PLUGIN_FLAG = 'TERMINAL_PLUGIN_POD_TERMINAL_ENABLED';
+
 export const PodsDetailsPage: FC<PodDetailsPageProps> = (props) => {
   const prometheusIsAvailable = usePrometheusGate();
+  const podTerminalPluginActive = useFlag(POD_TERMINAL_PLUGIN_FLAG);
   const customActionMenu = (kindObj, obj) => {
     const resourceKind = referenceForModel(kindObj);
     const context = { [resourceKind]: obj };
@@ -516,7 +527,7 @@ export const PodsDetailsPage: FC<PodDetailsPageProps> = (props) => {
         navFactory.envEditor(PodEnvironmentComponent),
         navFactory.logs(PodLogs),
         navFactory.events(ResourceEventStream),
-        navFactory.terminal(PodConnectLoader),
+        ...(!podTerminalPluginActive ? [navFactory.terminal(PodConnectLoader)] : []),
       ]}
     />
   );
