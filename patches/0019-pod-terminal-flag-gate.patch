 frontend/public/components/pod.tsx | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/frontend/public/components/pod.tsx b/frontend/public/components/pod.tsx
index a794ce70..31c73e27 100644
