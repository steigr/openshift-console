diff --git a/frontend/packages/console-app/src/components/user-preferences/language/TimeZoneDropdown.tsx b/frontend/packages/console-app/src/components/user-preferences/language/TimeZoneDropdown.tsx
new file mode 100644
index 00000000..9f54c36e
--- /dev/null
+++ b/frontend/packages/console-app/src/components/user-preferences/language/TimeZoneDropdown.tsx
@@ -0,0 +1,185 @@
+import type { FC, Ref } from 'react';
+import { useMemo, useState } from 'react';
+import type { MenuToggleElement } from '@patternfly/react-core';
+import {
+  MenuToggle,
+  Select,
+  SelectList,
+  SelectOption,
+  Skeleton,
+  TextInputGroup,
+  TextInputGroupMain,
+} from '@patternfly/react-core';
+import { useTranslation } from 'react-i18next';
+import { useTelemetry } from '@console/shared/src/hooks/useTelemetry';
+import { TIME_ZONE_BROWSER, TIME_ZONE_LOCAL_STORAGE_KEY, TIME_ZONE_UTC } from './const';
+import { getBrowserTimeZone, isSupportedTimeZone } from './getDateTimeLocale';
+import {
+  storeDateTimeFormatPreference,
+  TIME_ZONE_USER_PREFERENCE_KEY,
+  useDateTimeFormatChange,
+  usePreferredTimeZone,
+} from './useDateTimeFormat';
+
+// For browsers without Intl.supportedValuesOf: one zone per common UTC offset.
+const fallbackTimeZones = [
+  'Pacific/Honolulu',
+  'America/Anchorage',
+  'America/Los_Angeles',
+  'America/Denver',
+  'America/Chicago',
+  'America/New_York',
+  'America/Sao_Paulo',
+  'Atlantic/Azores',
+  'Europe/London',
+  'Europe/Berlin',
+  'Europe/Helsinki',
+  'Europe/Moscow',
+  'Asia/Dubai',
+  'Asia/Kolkata',
+  'Asia/Bangkok',
+  'Asia/Shanghai',
+  'Asia/Tokyo',
+  'Australia/Sydney',
+  'Pacific/Auckland',
+];
+
+const availableTimeZones = (): string[] => {
+  try {
+    return (Intl as typeof Intl & {
+      supportedValuesOf?: (key: 'timeZone') => string[];
+    }).supportedValuesOf('timeZone');
+  } catch {
+    return fallbackTimeZones;
+  }
+};
+
+/** "GMT+02:00", the zone's offset right now. */
+export const timeZoneOffset = (timeZone: string, date: Date): string => {
+  try {
+    return (
+      new Intl.DateTimeFormat('en-US', { timeZone, timeZoneName: 'longOffset' })
+        .formatToParts(date)
+        .find((part) => part.type === 'timeZoneName')?.value ?? ''
+    );
+  } catch {
+    return '';
+  }
+};
+
+const matches = (text: string, filter: string): boolean =>
+  text.toLowerCase().replace(/_/g, ' ').includes(filter.toLowerCase().replace(/_/g, ' '));
+
+const TimeZoneDropdown: FC = () => {
+  const { t } = useTranslation();
+  const fireTelemetryEvent = useTelemetry();
+  const [preference, setPreference, loaded] = usePreferredTimeZone();
+  const [isOpen, setIsOpen] = useState(false);
+  const [filter, setFilter] = useState('');
+  useDateTimeFormatChange();
+
+  const options = useMemo(() => {
+    const now = new Date();
+    const browserTimeZone = getBrowserTimeZone();
+    const zones = availableTimeZones().filter(
+      (zone) => zone !== TIME_ZONE_UTC && isSupportedTimeZone(zone),
+    );
+    return [
+      {
+        value: TIME_ZONE_BROWSER,
+        label: t('console-app~Browser default ({{timeZone}})', { timeZone: browserTimeZone }),
+        offset: timeZoneOffset(browserTimeZone, now),
+      },
+      { value: TIME_ZONE_UTC, label: TIME_ZONE_UTC, offset: 'GMT' },
+      ...zones.map((zone) => ({ value: zone, label: zone, offset: timeZoneOffset(zone, now) })),
+    ];
+  }, [t]);
+
+  const selected =
+    options.find((option) => option.value === preference) ??
+    // a stored zone this browser does not know
+    options.find((option) => option.value === TIME_ZONE_BROWSER);
+
+  const visible = filter
+    ? options.filter(
+        (option) =>
+          matches(option.label, filter) || (option.offset && matches(option.offset, filter)),
+      )
+    : options;
+
+  const close = () => {
+    setIsOpen(false);
+    setFilter('');
+  };
+
+  const onSelect = (_, value: string) => {
+    if (value && value !== preference) {
+      setPreference(value);
+      storeDateTimeFormatPreference(TIME_ZONE_LOCAL_STORAGE_KEY, value, TIME_ZONE_BROWSER);
+      fireTelemetryEvent('User Preference Changed', {
+        property: TIME_ZONE_USER_PREFERENCE_KEY,
+        value: [TIME_ZONE_BROWSER, TIME_ZONE_UTC].includes(value) ? value : 'custom',
+      });
+    }
+    close();
+  };
+
+  const selectedText = selected.offset ? `${selected.label} — ${selected.offset}` : selected.label;
+
+  return loaded ? (
+    <Select
+      isOpen={isOpen}
+      onOpenChange={(open) => (open ? setIsOpen(true) : close())}
+      selected={selected.value}
+      onSelect={onSelect}
+      data-test="dropdown console.timeZone"
+      id="console.timeZone"
+      isScrollable
+      toggle={(toggleRef: Ref<MenuToggleElement>) => (
+        <MenuToggle
+          ref={toggleRef}
+          variant="typeahead"
+          aria-label={t('console-app~Select a time zone')}
+          onClick={() => (isOpen ? close() : setIsOpen(true))}
+          isExpanded={isOpen}
+          isFullWidth
+        >
+          <TextInputGroup isPlain>
+            <TextInputGroupMain
+              value={filter}
+              onClick={() => setIsOpen(true)}
+              onChange={(_event, value) => {
+                setFilter(value);
+                setIsOpen(true);
+              }}
+              placeholder={selectedText}
+              autoComplete="off"
+              role="combobox"
+              isExpanded={isOpen}
+              aria-label={t('console-app~Filter time zones')}
+              data-test="input console.timeZone"
+            />
+          </TextInputGroup>
+        </MenuToggle>
+      )}
+    >
+      <SelectList>
+        {visible.length > 0 ? (
+          visible.map((option) => (
+            <SelectOption key={option.value} value={option.value} description={option.offset}>
+              {option.label}
+            </SelectOption>
+          ))
+        ) : (
+          <SelectOption isDisabled value="">
+            {t('console-app~No time zone matches "{{filter}}"', { filter })}
+          </SelectOption>
+        )}
+      </SelectList>
+    </Select>
+  ) : (
+    <Skeleton height="30px" width="100%" data-test="dropdown skeleton console.timeZone" />
+  );
+};
+
+export default TimeZoneDropdown;
