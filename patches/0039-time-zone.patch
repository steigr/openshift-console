+
+const supportedTimeZones = new Map<string, boolean>();
+
+export const isSupportedTimeZone = (timeZone: string): boolean => {
+  if (!supportedTimeZones.has(timeZone)) {
+    try {
+      // eslint-disable-next-line no-new
+      new Intl.DateTimeFormat('en', { timeZone });
+      supportedTimeZones.set(timeZone, true);
+    } catch {
+      // RangeError: invalid time zone
+      supportedTimeZones.set(timeZone, false);
+    }
+  }
+  return supportedTimeZones.get(timeZone);
+};
+
+/** The browser's own time zone, which Intl formats in when given none. */
+export const getBrowserTimeZone = (): string =>
+  new Intl.DateTimeFormat().resolvedOptions().timeZone;
+
+/**
+ * The time zone dates and times are shown in, or undefined for the browser's own -- the
+ * default, and what Intl uses when given none.
+ */
+export const getTimeZone = (): string | undefined => {
+  const preference = getItem(TIME_ZONE_LOCAL_STORAGE_KEY);
+  return preference && preference !== TIME_ZONE_BROWSER && isSupportedTimeZone(preference)
+    ? preference
+    : undefined;
+};
