+import { act, fireEvent, screen } from '@testing-library/react';
+import { renderWithProviders } from '@console/shared/src/test-utils/unit-test-utils';
+import { TIME_ZONE_LOCAL_STORAGE_KEY } from '../const';
+import TimeZoneDropdown from '../TimeZoneDropdown';
+import { usePreferredTimeZone } from '../useDateTimeFormat';
+
+jest.mock('@console/shared/src/hooks/useTelemetry', () => ({
+  useTelemetry: () => () => {},
+}));
+
+jest.mock('../useDateTimeFormat', () => ({
+  ...jest.requireActual('../useDateTimeFormat'),
+  usePreferredTimeZone: jest.fn(),
+}));
+
+const usePreferredTimeZoneMock = usePreferredTimeZone as jest.Mock;
+
+describe('TimeZoneDropdown', () => {
+  afterEach(() => localStorage.clear());
+
+  it('shows a skeleton until the preference has loaded', async () => {
+    usePreferredTimeZoneMock.mockReturnValue(['browser', jest.fn(), false]);
+    await act(async () => {
+      renderWithProviders(<TimeZoneDropdown />);
+    });
+    expect(screen.getByTestId('dropdown skeleton console.timeZone')).toBeInTheDocument();
+  });
+
+  it('filters the zones and stores the chosen one where the formatters read it', async () => {
+    const setPreference = jest.fn();
+    usePreferredTimeZoneMock.mockReturnValue(['browser', setPreference, true]);
+    await act(async () => {
+      renderWithProviders(<TimeZoneDropdown />);
+    });
+
+    const input = screen.getByRole('combobox', { name: 'Filter time zones' });
+    expect(input).toHaveAttribute('placeholder', expect.stringMatching(/^Browser default/));
+    fireEvent.change(input, { target: { value: 'berl' } });
+    expect(screen.queryByText('Asia/Tokyo')).not.toBeInTheDocument();
+    fireEvent.click(await screen.findByText('Europe/Berlin'));
+
+    expect(setPreference).toHaveBeenCalledWith('Europe/Berlin');
+    expect(localStorage.getItem(TIME_ZONE_LOCAL_STORAGE_KEY)).toBe('Europe/Berlin');
+  });
+
+  it('clears the stored zone when going back to the browser default', async () => {
+    localStorage.setItem(TIME_ZONE_LOCAL_STORAGE_KEY, 'UTC');
+    const setPreference = jest.fn();
+    usePreferredTimeZoneMock.mockReturnValue(['UTC', setPreference, true]);
+    await act(async () => {
+      renderWithProviders(<TimeZoneDropdown />);
+    });
+
+    fireEvent.click(screen.getByRole('combobox', { name: 'Filter time zones' }));
+    fireEvent.click(await screen.findByText(/^Browser default/));
+    expect(setPreference).toHaveBeenCalledWith('browser');
+    expect(localStorage.getItem(TIME_ZONE_LOCAL_STORAGE_KEY)).toBeNull();
+  });
+});
