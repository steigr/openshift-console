+// Tenant/non-system namespace prefixes. The backend may inject the list via
+// `window.SERVER_FLAGS.nonSystemNamespacesPrefix` (configured through the
+// `--non-system-namespaces-prefix` CLI flag or the
+// `BRIDGE_NON_SYSTEM_NAMESPACES_PREFIX` env variable). When not provided, the
+// list is empty and only the default `SYSTEM_NAMESPACES*` rules apply.
+export const NON_SYSTEM_NAMESPACES_PREFIX: string[] =
+  (typeof window !== 'undefined' && window.SERVER_FLAGS?.nonSystemNamespacesPrefix) || [];
