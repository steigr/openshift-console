--- a/pkg/server/server.go
+++ b/pkg/server/server.go
@@ -247,10 +247,11 @@ func SetPreferredUserIdentifier(identifier string) {
 // (/api/kubernetes/ and /api/graphql) authenticate with console's own service
 // account token while impersonating the logged-in user, for clusters whose
 // apiserver doesn't accept the user's OIDC token (see
-// --user-auth-service-account-token). Only those two endpoints swap tokens:
+// --user-auth-service-account-token). Only those two endpoints swap tokens,
+// plus the plugin endpoints when --plugin-impersonation asks for it:
 // everything else keeps forwarding the user's own token, so the service
-// account token never reaches plugin backends, monitoring, or any other
-// proxied service. Without it the user's own token goes to the apiserver
+// account token never reaches monitoring or any other proxied service.
+// Without it the user's own token goes to the apiserver
 // as-is, and adding impersonation headers would be both unnecessary and
 // actively harmful (the apiserver rejects any request carrying
 // Impersonate-Group without a corresponding Impersonate-User).
@@ -266,6 +267,34 @@ func SetServiceAccountTokenAuth(enabled bool) {
 	serviceAccountTokenAuth = enabled
 }
 
+// pluginImpersonation extends service-account-token auth to the requests console
+// proxies to plugin backends -- /api/plugins/ and the --plugin-proxy routes that
+// ask to be authorized -- so they carry console's service account token and
+// session-derived Impersonate-User/-Group headers, exactly like /api/kubernetes/
+// requests. That lets a plugin backend act as the logged-in user on a cluster
+// whose apiserver doesn't accept the user's own OIDC token. Off by default, in
+// which case plugin backends receive the user's own token. Set via the
+// --plugin-impersonation flag; a no-op without
+// --user-auth-service-account-token.
+var pluginImpersonation bool
+
+// SetPluginImpersonation enables or disables service-account-token auth on
+// plugin-bound requests. Set via the --plugin-impersonation flag.
+func SetPluginImpersonation(enabled bool) {
+	pluginImpersonation = enabled
+}
+
+// authorizePluginRequest gives a plugin-bound request the same
+// service-account-token auth the k8s API endpoints get, when
+// --plugin-impersonation is enabled. Writes an error response and returns false
+// when the request must not be proxied.
+func authorizePluginRequest(w http.ResponseWriter, r *http.Request, user *auth.User) bool {
+	if !pluginImpersonation {
+		return true
+	}
+	return authorizeWithServiceAccountToken(w, r, user)
+}
+
 // authorizeWithServiceAccountToken makes a k8s-API-bound request authenticate
 // as console's service account while impersonating the logged-in user. That
 // service account may impersonate anyone, so the identity must come from the
@@ -791,7 +820,10 @@ func (s *Server) HTTPHandler() (http.Handler, error) {
 
 	handle(pluginAssetsEndpoint, http.StripPrefix(
 		proxy.SingleJoiningSlash(s.BaseURL.Path, pluginAssetsEndpoint),
-		authHandler(func(w http.ResponseWriter, r *http.Request) {
+		authHandlerWithUser(func(user *auth.User, w http.ResponseWriter, r *http.Request) {
+			if !authorizePluginRequest(w, r, user) {
+				return
+			}
 			pluginsHandler.HandlePluginAssets(w, r)
 		}),
 	))
@@ -824,7 +856,12 @@ func (s *Server) HTTPHandler() (http.Handler, error) {
 			}
 			var h http.Handler
 			if proxyServiceHandler.Authorize {
-				h = authHandler(f)
+				h = authHandlerWithUser(func(user *auth.User, w http.ResponseWriter, r *http.Request) {
+					if !authorizePluginRequest(w, r, user) {
+						return
+					}
+					f(w, r)
+				})
 			} else {
 				h = http.HandlerFunc(f)
 			}
