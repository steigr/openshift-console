diff --git a/pkg/server/plugin_impersonation_test.go b/pkg/server/plugin_impersonation_test.go
new file mode 100644
index 00000000..f04b4644
--- /dev/null
+++ b/pkg/server/plugin_impersonation_test.go
@@ -0,0 +1,123 @@
+package server
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/openshift/console/pkg/auth"
+)
+
+func TestAuthorizePluginRequest(t *testing.T) {
+	tokenFile := filepath.Join(t.TempDir(), "token")
+	if err := os.WriteFile(tokenFile, []byte("console-sa-token"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	defer func(saAuth bool, file string, plugins bool) {
+		serviceAccountTokenAuth = saAuth
+		serviceAccountTokenFile = file
+		pluginImpersonation = plugins
+	}(serviceAccountTokenAuth, serviceAccountTokenFile, pluginImpersonation)
+	serviceAccountTokenFile = tokenFile
+
+	alice := &auth.User{
+		ID:       "alice-id",
+		Username: "alice",
+		Email:    "alice@example.com",
+		Groups:   []string{"devs"},
+		Token:    "alice-oidc-token",
+	}
+
+	tests := []struct {
+		name                string
+		serviceAccountToken bool
+		pluginImpersonation bool
+		header              http.Header
+		wantStatus          int
+		wantAuthorization   string
+		wantImpersonateUser string
+		wantGroups          []string
+	}{
+		{
+			name:                "disabled leaves the user's own token on the request",
+			serviceAccountToken: true,
+			wantAuthorization:   "Bearer alice-oidc-token",
+		},
+		{
+			name:                "disabled still forwards client-supplied impersonation",
+			serviceAccountToken: true,
+			header:              http.Header{"Impersonate-User": {"bob@example.com"}},
+			wantAuthorization:   "Bearer alice-oidc-token",
+			wantImpersonateUser: "bob@example.com",
+		},
+		{
+			name:                "enabled swaps in the service account token and impersonates the session user",
+			serviceAccountToken: true,
+			pluginImpersonation: true,
+			wantAuthorization:   "Bearer console-sa-token",
+			wantImpersonateUser: "alice@example.com",
+			wantGroups:          []string{"devs"},
+		},
+		{
+			name:                "enabled refuses client-supplied impersonation",
+			serviceAccountToken: true,
+			pluginImpersonation: true,
+			header:              http.Header{"Impersonate-User": {"system:admin"}},
+			wantStatus:          http.StatusForbidden,
+		},
+		{
+			name:                "enabled without service-account-token auth changes nothing",
+			pluginImpersonation: true,
+			header:              http.Header{"Impersonate-User": {"bob@example.com"}},
+			wantAuthorization:   "Bearer alice-oidc-token",
+			wantImpersonateUser: "bob@example.com",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			serviceAccountTokenAuth = tt.serviceAccountToken
+			pluginImpersonation = tt.pluginImpersonation
+
+			r := httptest.NewRequest(http.MethodGet, "/api/plugins/demo/api/v1/things", nil)
+			r.Header.Set("Authorization", "Bearer alice-oidc-token")
+			for key, values := range tt.header {
+				r.Header[key] = values
+			}
+			w := httptest.NewRecorder()
+
+			ok := authorizePluginRequest(w, r, alice)
+
+			if tt.wantStatus != 0 {
+				if ok || w.Code != tt.wantStatus {
+					t.Fatalf("got ok=%v status=%d, want the request refused with %d", ok, w.Code, tt.wantStatus)
+				}
+				if r.Header.Get("Authorization") == "Bearer console-sa-token" {
+					t.Errorf("refused request carries the service account token")
+				}
+				return
+			}
+			if !ok {
+				t.Fatalf("request refused with %d: %s", w.Code, w.Body.String())
+			}
+			if got := r.Header.Get("Authorization"); got != tt.wantAuthorization {
+				t.Errorf("Authorization = %q, want %q", got, tt.wantAuthorization)
+			}
+			if got := r.Header.Get("Impersonate-User"); got != tt.wantImpersonateUser {
+				t.Errorf("Impersonate-User = %q, want %q", got, tt.wantImpersonateUser)
+			}
+			if got := r.Header.Values("Impersonate-Group"); len(got) != len(tt.wantGroups) {
+				t.Errorf("Impersonate-Group = %q, want %q", got, tt.wantGroups)
+			} else {
+				for i, group := range tt.wantGroups {
+					if got[i] != group {
+						t.Errorf("Impersonate-Group = %q, want %q", got, tt.wantGroups)
+						break
+					}
+				}
+			}
+		})
+	}
+}
