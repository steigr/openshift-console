From fa822c63dc5c4520bcc50c77f92fe9d0b25c774f Mon Sep 17 00:00:00 2001
From: Port Bot <port@local>
Date: Wed, 26 Aug 2026 12:55:29 +0200
Subject: [PATCH] 0005: user roles and group memberships (Impersonate-Group
 headers)

Group matchers are --user-auth-oidc-group-matcher /
--user-auth-oidc-exclude-group-matcher flags from the start.
---
 cmd/bridge/config/auth/authoptions.go | 11 +++++++
 pkg/server/server.go                  | 44 +++++++++++++++++++++++++++
 pkg/serverutils/match_string.go       | 19 ++++++++++++
 3 files changed, 74 insertions(+)
 create mode 100644 pkg/serverutils/match_string.go

diff --git a/cmd/bridge/config/auth/authoptions.go b/cmd/bridge/config/auth/authoptions.go
index 866c1a2a..f63d7304 100644
--- a/cmd/bridge/config/auth/authoptions.go
+++ b/cmd/bridge/config/auth/authoptions.go
@@ -50,6 +50,10 @@ type AuthOptions struct {
 	// for the user's own OIDC token on outgoing k8s API calls (impersonation
 	// headers still carry the real user's identity).
 	ServiceAccountToken bool
+	// OIDCGroupMatcher/OIDCExcludeGroupMatcher optionally filter which of the
+	// authenticated user's groups get forwarded as Impersonate-Group headers.
+	OIDCGroupMatcher        string
+	OIDCExcludeGroupMatcher string
 }
 
 type CompletedOptions struct {
@@ -73,6 +77,8 @@ type completedOptions struct {
 
 	PreferredUserIdentifier string
 	ServiceAccountToken     bool
+	OIDCGroupMatcher        string
+	OIDCExcludeGroupMatcher string
 }
 
 func NewAuthOptions() *AuthOptions {
@@ -96,6 +102,8 @@ func (c *AuthOptions) AddFlags(fs *flag.FlagSet) {
 
 	fs.StringVar(&c.PreferredUserIdentifier, "user-auth-preferred-user-identifier", "username", "Which user attribute the k8s proxy's Impersonate-User header is derived from. 'username' (default) uses the user's email; anything else falls back to a UUID built from the user's ID.")
 	fs.BoolVar(&c.ServiceAccountToken, "user-auth-service-account-token", false, "Substitute the in-cluster service account token for the user's own OIDC token on outgoing k8s API calls. Impersonate-User/-Group headers still carry the real user's identity.")
+	fs.StringVar(&c.OIDCGroupMatcher, "user-auth-oidc-group-matcher", "", "Regular expression allow-list: only groups matching this pattern are forwarded as Impersonate-Group headers. Empty (default) forwards every group.")
+	fs.StringVar(&c.OIDCExcludeGroupMatcher, "user-auth-oidc-exclude-group-matcher", "", "Regular expression deny-list: groups matching this pattern are never forwarded as Impersonate-Group headers.")
 }
 
 func (c *AuthOptions) ApplyConfig(config *serverconfig.Auth) {
@@ -142,6 +150,8 @@ func (c *AuthOptions) Complete() (*CompletedOptions, error) {
 		StaticUserBearerToken:    c.StaticUserBearerToken,
 		PreferredUserIdentifier:  c.PreferredUserIdentifier,
 		ServiceAccountToken:      c.ServiceAccountToken,
+		OIDCGroupMatcher:         c.OIDCGroupMatcher,
+		OIDCExcludeGroupMatcher:  c.OIDCExcludeGroupMatcher,
 	}
 
 	if len(c.IssuerURL) > 0 {
@@ -241,6 +251,7 @@ func (c *completedOptions) ApplyTo(
 	oauth2.SetServiceAccountTokenAuth(c.ServiceAccountToken)
 	proxy.SetServiceAccountTokenAuth(c.ServiceAccountToken)
 	server.SetServiceAccountTokenAuth(c.ServiceAccountToken)
+	server.SetOIDCGroupMatchers(c.OIDCGroupMatcher, c.OIDCExcludeGroupMatcher)
 
 	useSecureCookies := srv.BaseURL.Scheme == "https"
 
diff --git a/pkg/server/server.go b/pkg/server/server.go
index 4e1471bf..9c2d8847 100644
--- a/pkg/server/server.go
+++ b/pkg/server/server.go
@@ -293,6 +293,49 @@ func injectImpersonateUserHeader(r *http.Request, user *auth.User) {
 	r.Header.Add("Impersonate-User", impersonateUserID)
 }
 
+// oidcGroupMatcher/oidcExcludeGroupMatcher optionally filter which of the
+// authenticated user's groups get forwarded as Impersonate-Group headers.
+// Empty (the default) forwards every group.
+var (
+	oidcGroupMatcher        string
+	oidcExcludeGroupMatcher string
+)
+
+// SetOIDCGroupMatchers sets the allow-list and deny-list regular expressions
+// used by injectImpersonateGroupHeaders. Set via the
+// --user-auth-oidc-group-matcher / --user-auth-oidc-exclude-group-matcher
+// flags.
+func SetOIDCGroupMatchers(groupMatcher, excludeGroupMatcher string) {
+	oidcGroupMatcher = groupMatcher
+	oidcExcludeGroupMatcher = excludeGroupMatcher
+}
+
+// injectImpersonateGroupHeaders forwards the authenticated user's groups as
+// `Impersonate-Group` request headers, optionally filtered by the
+// --user-auth-oidc-group-matcher (allow-list) and
+// --user-auth-oidc-exclude-group-matcher (deny-list) regular expressions.
+// When neither is set all groups are forwarded. No-op unless
+// --user-auth-service-account-token is enabled.
+func injectImpersonateGroupHeaders(r *http.Request, user *auth.User) {
+	if !serviceAccountTokenAuth || user == nil || len(user.Groups) == 0 {
+		return
+	}
+	groupMatcher := oidcGroupMatcher
+	excludedGroupMatcher := oidcExcludeGroupMatcher
+	for _, group := range user.Groups {
+		if excludedGroupMatcher == "" && groupMatcher == "" {
+			r.Header.Add("Impersonate-Group", group)
+			continue
+		}
+		if excludedGroupMatcher != "" && serverutils.MatchString(excludedGroupMatcher, group) {
+			continue
+		}
+		if groupMatcher == "" || serverutils.MatchString(groupMatcher, group) {
+			r.Header.Add("Impersonate-Group", group)
+		}
+	}
+}
+
 func disableDirectoryListing(handler http.Handler) http.Handler {
 	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
 		// If the request is for a directory, return a 404.
@@ -433,6 +476,7 @@ func (s *Server) HTTPHandler() (http.Handler, error) {
 		proxy.SingleJoiningSlash(s.BaseURL.Path, k8sProxyEndpoint),
 		authHandlerWithUser(func(user *auth.User, w http.ResponseWriter, r *http.Request) {
 			injectImpersonateUserHeader(r, user)
+			injectImpersonateGroupHeaders(r, user)
 			k8sProxy.ServeHTTP(w, r)
 		}),
 	))
diff --git a/pkg/serverutils/match_string.go b/pkg/serverutils/match_string.go
new file mode 100644
index 00000000..5412d3e1
--- /dev/null
+++ b/pkg/serverutils/match_string.go
@@ -0,0 +1,19 @@
+package serverutils
+
+import (
+	"regexp"
+
+	"k8s.io/klog/v2"
+)
+
+// MatchString checks if the given string matches the provided regex pattern.
+// Returns true if the pattern matches, false otherwise.
+// If the pattern is invalid, it returns false and logs an error.
+func MatchString(pattern, s string) bool {
+	matched, err := regexp.MatchString(pattern, s)
+	if err != nil {
+		klog.Errorf("Invalid regex pattern %q: %v", pattern, err)
+		return false
+	}
+	return matched
+}
