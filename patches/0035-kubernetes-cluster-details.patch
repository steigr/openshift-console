diff --git a/frontend/public/components/dashboard/dashboards-page/cluster-dashboard/__tests__/kubernetes-details.spec.tsx b/frontend/public/components/dashboard/dashboards-page/cluster-dashboard/__tests__/kubernetes-details.spec.tsx
