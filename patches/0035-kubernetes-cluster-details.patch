@@ -0,0 +1,72 @@
+import {
+  compareVersions,
+  parseVersion,
+  parseVersionPolicy,
+  parseVersionsBehind,
+  VersionPolicy,
+} from '../kubernetes-release';
+
+describe('parseVersion', () => {
+  it('parses release, pre-release and distribution versions', () => {
+    expect(parseVersion('v1.34.1')).toEqual([1, 34, 1]);
+    expect(parseVersion('1.35.0-rc.1')).toEqual([1, 35, 0]);
+    expect(parseVersion('v1.33.4+k3s1')).toEqual([1, 33, 4]);
+  });
+
+  it('rejects anything else', () => {
+    expect(parseVersion('')).toBeUndefined();
+    expect(parseVersion('v1.34')).toBeUndefined();
+    expect(parseVersion(undefined)).toBeUndefined();
+  });
+});
+
+describe('parseVersionPolicy / parseVersionsBehind', () => {
+  it('defaults to the strictest policy', () => {
+    expect(parseVersionPolicy(undefined)).toBe(VersionPolicy.Patch);
+    expect(parseVersionPolicy('bogus')).toBe(VersionPolicy.Patch);
+    expect(parseVersionPolicy(' Minor ')).toBe(VersionPolicy.Minor);
+    expect(parseVersionsBehind(undefined)).toBe(0);
+    expect(parseVersionsBehind('-1')).toBe(0);
+    expect(parseVersionsBehind('two')).toBe(0);
+    expect(parseVersionsBehind('2')).toBe(2);
+  });
+});
+
+describe('compareVersions', () => {
+  const upToDate = { upToDate: true, withinPolicy: true };
+  const within = { upToDate: false, withinPolicy: true };
+  const outside = { upToDate: false, withinPolicy: false };
+
+  it('treats the latest release and anything newer as up to date', () => {
+    expect(compareVersions('v1.34.1', 'v1.34.1')).toEqual(upToDate);
+    expect(compareVersions('v1.34.1+k3s1', 'v1.34.1')).toEqual(upToDate);
+    expect(compareVersions('v1.35.0-rc.1', 'v1.34.9')).toEqual(upToDate);
+  });
+
+  it('patch: requires the latest minor, allowing versionsBehind patches', () => {
+    expect(compareVersions('v1.34.0', 'v1.34.1')).toEqual(outside);
+    expect(compareVersions('v1.34.0', 'v1.34.2', VersionPolicy.Patch, 2)).toEqual(within);
+    expect(compareVersions('v1.34.0', 'v1.34.3', VersionPolicy.Patch, 2)).toEqual(outside);
+    expect(compareVersions('v1.33.9', 'v1.34.0', VersionPolicy.Patch, 5)).toEqual(outside);
+  });
+
+  it('minor: ignores patches, allowing versionsBehind minors', () => {
+    expect(compareVersions('v1.34.0', 'v1.34.5', VersionPolicy.Minor)).toEqual(within);
+    expect(compareVersions('v1.33.0', 'v1.34.5', VersionPolicy.Minor)).toEqual(outside);
+    expect(compareVersions('v1.33.0', 'v1.34.5', VersionPolicy.Minor, 1)).toEqual(within);
+    expect(compareVersions('v1.32.9', 'v1.34.5', VersionPolicy.Minor, 1)).toEqual(outside);
+    expect(compareVersions('v1.32.9', 'v1.34.5', VersionPolicy.Minor, 2)).toEqual(within);
+    expect(compareVersions('v0.99.0', 'v1.0.0', VersionPolicy.Minor, 2)).toEqual(outside);
+  });
+
+  it('major: ignores minors and patches', () => {
+    expect(compareVersions('v1.20.0', 'v1.34.5', VersionPolicy.Major)).toEqual(within);
+    expect(compareVersions('v1.20.0', 'v2.0.0', VersionPolicy.Major)).toEqual(outside);
+    expect(compareVersions('v1.20.0', 'v2.0.0', VersionPolicy.Major, 1)).toEqual(within);
+  });
+
+  it('gives no verdict on an unparseable version', () => {
+    expect(compareVersions('', 'v1.34.1')).toBeUndefined();
+    expect(compareVersions('v1.34.1', 'latest')).toBeUndefined();
+  });
+});
