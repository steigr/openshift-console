+package server
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func serveKubernetesRelease(t *testing.T, h *kubernetesReleaseHandler) (int, string) {
+	t.Helper()
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, kubernetesReleaseEndpoint, nil))
+	var body struct {
+		Version string `json:"version"`
+	}
+	_ = json.Unmarshal(rec.Body.Bytes(), &body)
+	return rec.Code, body.Version
+}
+
+func TestKubernetesReleaseHandler(t *testing.T) {
+	var hits atomic.Int32
+	body := "v1.34.1\n"
+	status := http.StatusOK
+	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		hits.Add(1)
+		w.WriteHeader(status)
+		_, _ = w.Write([]byte(body))
+	}))
+	defer upstream.Close()
+
+	h := newKubernetesReleaseHandler(upstream.URL)
+
+	code, version := serveKubernetesRelease(t, h)
+	if code != http.StatusOK || version != "v1.34.1" {
+		t.Fatalf("got %d %q, want 200 v1.34.1", code, version)
+	}
+
+	// Cached: a second request does not reach upstream.
+	serveKubernetesRelease(t, h)
+	if n := hits.Load(); n != 1 {
+		t.Fatalf("upstream hit %d times, want 1", n)
+	}
+
+	// Once expired, a failing upstream keeps serving the last good version.
+	status = http.StatusInternalServerError
+	h.expires = time.Time{}
+	code, version = serveKubernetesRelease(t, h)
+	if code != http.StatusOK || version != "v1.34.1" {
+		t.Fatalf("got %d %q after upstream failure, want the cached v1.34.1", code, version)
+	}
+	if n := hits.Load(); n != 2 {
+		t.Fatalf("upstream hit %d times, want 2", n)
+	}
+}
+
+func TestKubernetesReleaseHandlerErrors(t *testing.T) {
+	for name, tc := range map[string]struct {
+		status int
+		body   string
+	}{
+		"not found":     {http.StatusNotFound, "v1.34.1"},
+		"not a version": {http.StatusOK, "<html>captive portal</html>"},
+		"empty":         {http.StatusOK, ""},
+	} {
+		t.Run(name, func(t *testing.T) {
+			upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.WriteHeader(tc.status)
+				_, _ = w.Write([]byte(tc.body))
+			}))
+			defer upstream.Close()
+			if code, _ := serveKubernetesRelease(t, newKubernetesReleaseHandler(upstream.URL)); code != http.StatusBadGateway {
+				t.Fatalf("got %d, want 502", code)
+			}
+		})
+	}
+}
+
+func TestKubernetesReleaseHandlerNormalizes(t *testing.T) {
+	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, _ = w.Write([]byte("1.35.0-rc.1"))
+	}))
+	defer upstream.Close()
+	if _, version := serveKubernetesRelease(t, newKubernetesReleaseHandler(upstream.URL)); version != "v1.35.0-rc.1" {
+		t.Fatalf("got %q, want v1.35.0-rc.1", version)
+	}
+}
+
+func TestKubernetesReleaseHandlerDisabled(t *testing.T) {
+	if code, _ := serveKubernetesRelease(t, newKubernetesReleaseHandler("")); code != http.StatusNotFound {
+		t.Fatalf("got %d, want 404", code)
+	}
+}
+
+func TestKubernetesReleaseHandlerUnsupportedScheme(t *testing.T) {
+	if code, _ := serveKubernetesRelease(t, newKubernetesReleaseHandler("ftp://example.com/stable.txt")); code != http.StatusBadGateway {
+		t.Fatalf("got %d, want 502", code)
+	}
+}
+
+// fakeRegistry serves /v2/<repo>/tags/list in two pages behind an anonymous bearer-token
+// challenge, as GHCR and Docker Hub do.
+func fakeRegistry(t *testing.T, pages [][]string) *httptest.Server {
+	t.Helper()
+	var srv *httptest.Server
+	srv = httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
+		case "/token":
+			if r.URL.Query().Get("scope") != "repository:kubernetes/kube-apiserver:pull" {
+				http.Error(w, "bad scope", http.StatusBadRequest)
+				return
+			}
+			_, _ = w.Write([]byte(`{"token":"anon"}`))
+		case "/v2/kubernetes/kube-apiserver/tags/list":
+			if r.Header.Get("Authorization") != "Bearer anon" {
+				w.Header().Set("WWW-Authenticate", `Bearer realm="`+srv.URL+`/token",service="fake",scope="repository:kubernetes/kube-apiserver:pull"`)
+				w.WriteHeader(http.StatusUnauthorized)
+				return
+			}
+			page := 0
+			if r.URL.Query().Get("last") != "" {
+				page = 1
+			}
+			if page+1 < len(pages) {
+				w.Header().Set("Link", `</v2/kubernetes/kube-apiserver/tags/list?last=x&n=3>; rel="next"`)
+			}
+			_ = json.NewEncoder(w).Encode(map[string]any{"tags": pages[page]})
+		default:
+			http.NotFound(w, r)
+		}
+	}))
+	return srv
+}
+
+func TestKubernetesReleaseHandlerOCI(t *testing.T) {
+	registry := fakeRegistry(t, [][]string{
+		{"sha256-0007b259.sig", "v1.9.9", "v1.34.2"},
+		{"1.34.10", "v1.35.0-rc.0", "v1.34.11-k3s1", "v1.34.12-rc1-k3s1", "latest"},
+	})
+	defer registry.Close()
+	source := "oci://" + strings.TrimPrefix(registry.URL, "https://") + "/kubernetes/kube-apiserver"
+
+	for name, tc := range map[string]struct {
+		source string
+		want   string
+	}{
+		"releases only":         {source, "v1.34.10"},
+		"all pre-releases":      {source + "?prerelease=.*", "v1.35.0-rc.0"},
+		"matching pre-releases": {source + `?prerelease=k3s\d+`, "v1.34.11-k3s1"},
+	} {
+		t.Run(name, func(t *testing.T) {
+			h := newKubernetesReleaseHandler(tc.source)
+			h.client = registry.Client()
+			if code, version := serveKubernetesRelease(t, h); code != http.StatusOK || version != tc.want {
+				t.Fatalf("got %d %q, want 200 %q", code, version, tc.want)
+			}
+		})
+	}
+}
+
+func TestKubernetesReleaseHandlerOCINoVersions(t *testing.T) {
+	registry := fakeRegistry(t, [][]string{{"latest", "main"}})
+	defer registry.Close()
+	h := newKubernetesReleaseHandler("oci://" + strings.TrimPrefix(registry.URL, "https://") + "/kubernetes/kube-apiserver")
+	h.client = registry.Client()
+	if code, _ := serveKubernetesRelease(t, h); code != http.StatusBadGateway {
+		t.Fatalf("got %d, want 502", code)
+	}
+}
+
+func TestOCITagsURL(t *testing.T) {
+	for in, want := range map[string]string{
+		"oci://registry.k8s.io/kube-apiserver": "https://registry.k8s.io/v2/kube-apiserver/tags/list",
+		"oci://ghcr.io/org/team/image":         "https://ghcr.io/v2/org/team/image/tags/list",
+		"oci://docker.io/rancher/k3s":          "https://registry-1.docker.io/v2/rancher/k3s/tags/list",
+		"oci://docker.io/alpine":               "https://registry-1.docker.io/v2/library/alpine/tags/list",
+		"oci://localhost:5000/kube-apiserver/": "https://localhost:5000/v2/kube-apiserver/tags/list",
+		"oci://registry.k8s.io/":               "",
+		"oci://registry.k8s.io/pause:3.10":     "",
+	} {
+		u, _ := url.Parse(in)
+		got, err := ociTagsURL(u)
+		switch {
+		case want == "" && err == nil:
+			t.Errorf("%s: got %s, want an error", in, got)
+		case want != "" && (err != nil || got.String() != want):
+			t.Errorf("%s: got %v %v, want %s", in, got, err, want)
+		}
+	}
+}
