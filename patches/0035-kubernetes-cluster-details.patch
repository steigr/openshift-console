diff --git a/pkg/server/kubernetes_release.go b/pkg/server/kubernetes_release.go
new file mode 100644
index 00000000..88b0e649
--- /dev/null
+++ b/pkg/server/kubernetes_release.go
@@ -0,0 +1,131 @@
+package server
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"regexp"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/openshift/console/pkg/serverutils"
+	"k8s.io/klog/v2"
+)
+
+const (
+	kubernetesReleaseEndpoint = "/api/console/kubernetes-release"
+
+	// dl.k8s.io itself serves stable.txt with max-age=86400; an hour is plenty fresh for a
+	// dashboard hint and keeps a fleet of browsers from turning into a fleet of requests.
+	kubernetesReleaseTTL = time.Hour
+	// A failure is retried sooner, so a transient outage or a proxy being fixed shows up
+	// without waiting out a whole TTL, but not on every dashboard load.
+	kubernetesReleaseErrorTTL = 5 * time.Minute
+	kubernetesReleaseTimeout  = 10 * time.Second
+)
+
+// stable.txt holds a single line such as "v1.34.1".
+var kubernetesReleaseVersionRE = regexp.MustCompile(`^v?\d+\.\d+\.\d+(?:[-+][0-9A-Za-z.+-]*)?$`)
+
+// kubernetesReleaseHandler serves the latest Kubernetes release, read from a stable.txt-style
+// URL (one version per document, dl.k8s.io/release/stable.txt by default) and cached. It is
+// fetched by bridge rather than the browser so the request goes through the cluster's egress
+// (HTTPS_PROXY), does not depend on the page's Content-Security-Policy, and can point at a
+// mirror on a disconnected cluster. An empty URL disables it: the endpoint then answers 404,
+// which the frontend takes as "don't show the row".
+type kubernetesReleaseHandler struct {
+	url    string
+	client *http.Client
+
+	mu      sync.Mutex
+	version string
+	err     error
+	expires time.Time
+}
+
+func newKubernetesReleaseHandler(url string) *kubernetesReleaseHandler {
+	return &kubernetesReleaseHandler{
+		url: url,
+		client: &http.Client{
+			Transport: http.DefaultTransport.(*http.Transport).Clone(),
+			Timeout:   kubernetesReleaseTimeout,
+		},
+	}
+}
+
+func (h *kubernetesReleaseHandler) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	if h.url == "" {
+		serverutils.SendResponse(w, http.StatusNotFound, serverutils.ApiError{Err: "Kubernetes release check is disabled"})
+		return
+	}
+	if r.Method != http.MethodGet {
+		w.Header().Set("Allow", http.MethodGet)
+		serverutils.SendResponse(w, http.StatusMethodNotAllowed, serverutils.ApiError{Err: "Invalid method: only GET is allowed"})
+		return
+	}
+	version, err := h.latest(r.Context())
+	if err != nil {
+		serverutils.SendResponse(w, http.StatusBadGateway, serverutils.ApiError{Err: err.Error()})
+		return
+	}
+	serverutils.SendResponse(w, http.StatusOK, struct {
+		Version string `json:"version"`
+	}{
+		Version: version,
+	})
+}
+
+// latest returns the cached release, refreshing it once expired. Concurrent callers wait for
+// the one refresh in progress instead of each issuing their own.
+func (h *kubernetesReleaseHandler) latest(ctx context.Context) (string, error) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if time.Now().Before(h.expires) {
+		return h.version, h.err
+	}
+	// Detached from the request: the result is shared, so one caller going away must not
+	// fail it for everyone waiting on the lock.
+	version, err := h.fetch(context.WithoutCancel(ctx))
+	if err != nil {
+		klog.Warningf("failed to fetch the latest Kubernetes release from %s: %v", h.url, err)
+		h.err = err
+		h.expires = time.Now().Add(kubernetesReleaseErrorTTL)
+		// Keep serving the last good version, if there is one, rather than an error.
+		if h.version != "" {
+			return h.version, nil
+		}
+		return "", err
+	}
+	h.version, h.err = version, nil
+	h.expires = time.Now().Add(kubernetesReleaseTTL)
+	return version, nil
+}
+
+func (h *kubernetesReleaseHandler) fetch(ctx context.Context) (string, error) {
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, h.url, nil)
+	if err != nil {
+		return "", err
+	}
+	resp, err := h.client.Do(req)
+	if err != nil {
+		return "", err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return "", fmt.Errorf("unexpected status %s", resp.Status)
+	}
+	body, err := io.ReadAll(io.LimitReader(resp.Body, 256))
+	if err != nil {
+		return "", err
+	}
+	version := strings.TrimSpace(string(body))
+	if !kubernetesReleaseVersionRE.MatchString(version) {
+		return "", fmt.Errorf("response is not a version: %q", version)
+	}
+	if !strings.HasPrefix(version, "v") {
+		version = "v" + version
+	}
+	return version, nil
+}
diff --git a/pkg/server/kubernetes_release_test.go b/pkg/server/kubernetes_release_test.go
new file mode 100644
index 00000000..34691517
--- /dev/null
+++ b/pkg/server/kubernetes_release_test.go
@@ -0,0 +1,95 @@
+package server
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func serveKubernetesRelease(t *testing.T, h *kubernetesReleaseHandler) (int, string) {
+	t.Helper()
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, kubernetesReleaseEndpoint, nil))
+	var body struct {
+		Version string `json:"version"`
+	}
+	_ = json.Unmarshal(rec.Body.Bytes(), &body)
+	return rec.Code, body.Version
+}
+
+func TestKubernetesReleaseHandler(t *testing.T) {
+	var hits atomic.Int32
+	body := "v1.34.1\n"
+	status := http.StatusOK
+	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		hits.Add(1)
+		w.WriteHeader(status)
+		_, _ = w.Write([]byte(body))
+	}))
+	defer upstream.Close()
+
+	h := newKubernetesReleaseHandler(upstream.URL)
+
+	code, version := serveKubernetesRelease(t, h)
+	if code != http.StatusOK || version != "v1.34.1" {
+		t.Fatalf("got %d %q, want 200 v1.34.1", code, version)
+	}
+
+	// Cached: a second request does not reach upstream.
+	serveKubernetesRelease(t, h)
+	if n := hits.Load(); n != 1 {
+		t.Fatalf("upstream hit %d times, want 1", n)
+	}
+
+	// Once expired, a failing upstream keeps serving the last good version.
+	status = http.StatusInternalServerError
+	h.expires = time.Time{}
+	code, version = serveKubernetesRelease(t, h)
+	if code != http.StatusOK || version != "v1.34.1" {
+		t.Fatalf("got %d %q after upstream failure, want the cached v1.34.1", code, version)
+	}
+	if n := hits.Load(); n != 2 {
+		t.Fatalf("upstream hit %d times, want 2", n)
+	}
+}
+
+func TestKubernetesReleaseHandlerErrors(t *testing.T) {
+	for name, tc := range map[string]struct {
+		status int
+		body   string
+	}{
+		"not found":     {http.StatusNotFound, "v1.34.1"},
+		"not a version": {http.StatusOK, "<html>captive portal</html>"},
+		"empty":         {http.StatusOK, ""},
+	} {
+		t.Run(name, func(t *testing.T) {
+			upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.WriteHeader(tc.status)
+				_, _ = w.Write([]byte(tc.body))
+			}))
+			defer upstream.Close()
+			if code, _ := serveKubernetesRelease(t, newKubernetesReleaseHandler(upstream.URL)); code != http.StatusBadGateway {
+				t.Fatalf("got %d, want 502", code)
+			}
+		})
+	}
+}
+
+func TestKubernetesReleaseHandlerNormalizes(t *testing.T) {
+	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, _ = w.Write([]byte("1.35.0-rc.1"))
+	}))
+	defer upstream.Close()
+	if _, version := serveKubernetesRelease(t, newKubernetesReleaseHandler(upstream.URL)); version != "v1.35.0-rc.1" {
+		t.Fatalf("got %q, want v1.35.0-rc.1", version)
+	}
+}
+
+func TestKubernetesReleaseHandlerDisabled(t *testing.T) {
+	if code, _ := serveKubernetesRelease(t, newKubernetesReleaseHandler("")); code != http.StatusNotFound {
+		t.Fatalf("got %d, want 404", code)
+	}
+}
