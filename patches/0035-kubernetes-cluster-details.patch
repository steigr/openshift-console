diff --git a/pkg/server/kubernetes_release.go b/pkg/server/kubernetes_release.go
new file mode 100644
index 00000000..931a7eec
--- /dev/null
+++ b/pkg/server/kubernetes_release.go
@@ -0,0 +1,374 @@
+package server
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"regexp"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/openshift/console/pkg/serverutils"
+	"k8s.io/apimachinery/pkg/util/version"
+	"k8s.io/klog/v2"
+)
+
+const (
+	kubernetesReleaseEndpoint = "/api/console/kubernetes-release"
+
+	// dl.k8s.io itself serves stable.txt with max-age=86400; an hour is plenty fresh for a
+	// dashboard hint and keeps a fleet of browsers from turning into a fleet of requests.
+	kubernetesReleaseTTL = time.Hour
+	// A failure is retried sooner, so a transient outage or a proxy being fixed shows up
+	// without waiting out a whole TTL, but not on every dashboard load.
+	kubernetesReleaseErrorTTL = 5 * time.Minute
+	kubernetesReleaseTimeout  = 30 * time.Second
+
+	// registry.k8s.io/kube-apiserver alone has well over a thousand tags (signatures and
+	// attestations included), and registries page at anything from 50 to 10000 a page.
+	ociTagsMaxPages    = 100
+	ociTagsMaxPageSize = 8 << 20
+)
+
+// stable.txt holds a single line such as "v1.34.1".
+var kubernetesReleaseVersionRE = regexp.MustCompile(`^v?\d+\.\d+\.\d+(?:[-+][0-9A-Za-z.+-]*)?$`)
+
+// kubernetesReleaseHandler serves the latest Kubernetes release and caches it. The source is
+// either
+//
+//   - an http(s) URL of a document holding a single version, like dl.k8s.io/release/stable.txt
+//     (the default), or
+//   - oci://<registry>/<repository>, whose tags are listed through the OCI distribution API and
+//     the highest semantic version among them is taken (e.g. oci://registry.k8s.io/kube-apiserver).
+//     Pre-releases are skipped, except those whose pre-release part fully matches the regular
+//     expression in an optional ?prerelease= parameter -- which a distribution tagging its
+//     releases as pre-releases needs: oci://docker.io/rancher/k3s?prerelease=k3s\d+ takes
+//     v1.34.1-k3s1 but not v1.34.1-rc1-k3s1.
+//   - aks://<region>, the newest version Azure Kubernetes Service offers in that region (e.g.
+//     aks://westeurope), read from the AKS Release Tracker's public feed. Preview versions are
+//     skipped unless the URL carries ?preview=true.
+//
+// It is fetched by bridge rather than the browser so the request goes through the cluster's
+// egress (HTTPS_PROXY), does not depend on the page's Content-Security-Policy, and can point at
+// a mirror on a disconnected cluster. An empty source disables it: the endpoint then answers
+// 404, which the frontend takes as "don't show the row".
+type kubernetesReleaseHandler struct {
+	source string
+	client *http.Client
+	// aksFeedURL is the AKS Release Tracker's feed; a field so tests can point it elsewhere.
+	aksFeedURL string
+
+	mu      sync.Mutex
+	version string
+	err     error
+	expires time.Time
+	// Validators of the document version was derived from, for a conditional refresh. Only the
+	// AKS feed uses them: it is ~22 MB, served uncompressed, and changes a few times a week.
+	etag         string
+	lastModified string
+}
+
+func newKubernetesReleaseHandler(source string) *kubernetesReleaseHandler {
+	return &kubernetesReleaseHandler{
+		source:     source,
+		aksFeedURL: aksReleaseFeedURL,
+		client: &http.Client{
+			Transport: http.DefaultTransport.(*http.Transport).Clone(),
+			Timeout:   kubernetesReleaseTimeout,
+		},
+	}
+}
+
+func (h *kubernetesReleaseHandler) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	if h.source == "" {
+		serverutils.SendResponse(w, http.StatusNotFound, serverutils.ApiError{Err: "Kubernetes release check is disabled"})
+		return
+	}
+	if r.Method != http.MethodGet {
+		w.Header().Set("Allow", http.MethodGet)
+		serverutils.SendResponse(w, http.StatusMethodNotAllowed, serverutils.ApiError{Err: "Invalid method: only GET is allowed"})
+		return
+	}
+	version, err := h.latest(r.Context())
+	if err != nil {
+		serverutils.SendResponse(w, http.StatusBadGateway, serverutils.ApiError{Err: err.Error()})
+		return
+	}
+	serverutils.SendResponse(w, http.StatusOK, struct {
+		Version string `json:"version"`
+	}{
+		Version: version,
+	})
+}
+
+// latest returns the cached release, refreshing it once expired. Concurrent callers wait for
+// the one refresh in progress instead of each issuing their own.
+func (h *kubernetesReleaseHandler) latest(ctx context.Context) (string, error) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if time.Now().Before(h.expires) {
+		return h.version, h.err
+	}
+	// Detached from the request: the result is shared, so one caller going away must not
+	// fail it for everyone waiting on the lock.
+	version, err := h.fetch(context.WithoutCancel(ctx))
+	if err != nil {
+		klog.Warningf("failed to fetch the latest Kubernetes release from %s: %v", h.source, err)
+		h.err = err
+		h.expires = time.Now().Add(kubernetesReleaseErrorTTL)
+		// Keep serving the last good version, if there is one, rather than an error.
+		if h.version != "" {
+			return h.version, nil
+		}
+		return "", err
+	}
+	h.version, h.err = version, nil
+	h.expires = time.Now().Add(kubernetesReleaseTTL)
+	return version, nil
+}
+
+func (h *kubernetesReleaseHandler) fetch(ctx context.Context) (string, error) {
+	source, err := url.Parse(h.source)
+	if err != nil {
+		return "", err
+	}
+	switch source.Scheme {
+	case "oci":
+		return h.fetchOCI(ctx, source)
+	case "aks":
+		return h.fetchAKS(ctx, source)
+	case "http", "https":
+		return h.fetchDocument(ctx, source)
+	default:
+		return "", fmt.Errorf("unsupported scheme %q, want https://, oci:// or aks://", source.Scheme)
+	}
+}
+
+func (h *kubernetesReleaseHandler) fetchDocument(ctx context.Context, source *url.URL) (string, error) {
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, source.String(), nil)
+	if err != nil {
+		return "", err
+	}
+	resp, err := h.client.Do(req)
+	if err != nil {
+		return "", err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return "", fmt.Errorf("unexpected status %s", resp.Status)
+	}
+	body, err := io.ReadAll(io.LimitReader(resp.Body, 256))
+	if err != nil {
+		return "", err
+	}
+	version := strings.TrimSpace(string(body))
+	if !kubernetesReleaseVersionRE.MatchString(version) {
+		return "", fmt.Errorf("response is not a version: %q", version)
+	}
+	return withVPrefix(version), nil
+}
+
+func withVPrefix(version string) string {
+	if strings.HasPrefix(version, "v") {
+		return version
+	}
+	return "v" + version
+}
+
+// ociTagsURL turns oci://<registry>/<repository> into the distribution API's tag list URL,
+// applying Docker Hub's conventions (docker.io is served from registry-1.docker.io, and a
+// single-segment repository lives under library/).
+func ociTagsURL(source *url.URL) (*url.URL, error) {
+	host := source.Host
+	repository := strings.Trim(source.Path, "/")
+	if host == "" || repository == "" {
+		return nil, fmt.Errorf("want oci://<registry>/<repository>, got %q", source.Redacted())
+	}
+	if strings.Contains(repository, ":") || strings.Contains(repository, "@") {
+		return nil, fmt.Errorf("%q names a tag or digest; give the repository alone", source.Redacted())
+	}
+	switch host {
+	case "docker.io", "index.docker.io":
+		host = "registry-1.docker.io"
+		if !strings.Contains(repository, "/") {
+			repository = "library/" + repository
+		}
+	}
+	return &url.URL{Scheme: "https", Host: host, Path: "/v2/" + repository + "/tags/list"}, nil
+}
+
+func (h *kubernetesReleaseHandler) fetchOCI(ctx context.Context, source *url.URL) (string, error) {
+	next, err := ociTagsURL(source)
+	if err != nil {
+		return "", err
+	}
+	var prerelease *regexp.Regexp
+	if expr := rawQueryParam(source, "prerelease"); expr != "" {
+		if prerelease, err = regexp.Compile("^(?:" + expr + ")$"); err != nil {
+			return "", fmt.Errorf("prerelease: %w", err)
+		}
+	}
+
+	var latest *version.Version
+	var latestTag string
+	token := ""
+	for page := 0; next != nil; page++ {
+		if page == ociTagsMaxPages {
+			return "", fmt.Errorf("more than %d pages of tags", ociTagsMaxPages)
+		}
+		var tags []string
+		tags, next, token, err = h.fetchOCITagsPage(ctx, next, token)
+		if err != nil {
+			return "", err
+		}
+		for _, tag := range tags {
+			v, err := version.ParseSemantic(tag)
+			if err != nil || (v.PreRelease() != "" && (prerelease == nil || !prerelease.MatchString(v.PreRelease()))) {
+				continue
+			}
+			if latest == nil || v.GreaterThan(latest) {
+				latest, latestTag = v, tag
+			}
+		}
+	}
+	if latest == nil {
+		return "", fmt.Errorf("no semantic version among the tags of %s", source.Redacted())
+	}
+	return withVPrefix(latestTag), nil
+}
+
+// rawQueryParam reads a query parameter without form decoding, which would turn the `+` of a
+// regular expression into a space.
+func rawQueryParam(u *url.URL, name string) string {
+	for _, pair := range strings.Split(u.RawQuery, "&") {
+		if key, value, _ := strings.Cut(pair, "="); key == name {
+			if unescaped, err := url.PathUnescape(value); err == nil {
+				return unescaped
+			}
+			return value
+		}
+	}
+	return ""
+}
+
+// fetchOCITagsPage fetches one page of a tag list, answering a bearer-token challenge
+// anonymously if the registry poses one, and returns the next page's URL from the Link header.
+func (h *kubernetesReleaseHandler) fetchOCITagsPage(ctx context.Context, pageURL *url.URL, token string) ([]string, *url.URL, string, error) {
+	resp, err := h.getOCI(ctx, pageURL, token)
+	if err != nil {
+		return nil, nil, token, err
+	}
+	if resp.StatusCode == http.StatusUnauthorized && token == "" {
+		challenge := resp.Header.Get("WWW-Authenticate")
+		// Retry against wherever the request ended up: registry.k8s.io redirects to a
+		// regional backend, and that is the host whose challenge this is.
+		pageURL = resp.Request.URL
+		resp.Body.Close()
+		if token, err = h.ociToken(ctx, challenge); err != nil {
+			return nil, nil, "", err
+		}
+		if resp, err = h.getOCI(ctx, pageURL, token); err != nil {
+			return nil, nil, token, err
+		}
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return nil, nil, token, fmt.Errorf("listing tags: unexpected status %s", resp.Status)
+	}
+	var body struct {
+		Tags []string `json:"tags"`
+	}
+	if err := json.NewDecoder(io.LimitReader(resp.Body, ociTagsMaxPageSize)).Decode(&body); err != nil {
+		return nil, nil, token, fmt.Errorf("listing tags: %w", err)
+	}
+	return body.Tags, nextLink(resp.Request.URL, resp.Header.Get("Link")), token, nil
+}
+
+func (h *kubernetesReleaseHandler) getOCI(ctx context.Context, u *url.URL, token string) (*http.Response, error) {
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, u.String(), nil)
+	if err != nil {
+		return nil, err
+	}
+	req.Header.Set("Accept", "application/json")
+	if token != "" {
+		req.Header.Set("Authorization", "Bearer "+token)
+	}
+	return h.client.Do(req)
+}
+
+var authParamRE = regexp.MustCompile(`(\w+)="([^"]*)"`)
+
+// ociToken obtains an anonymous pull token for a `Bearer realm=...,service=...,scope=...`
+// challenge, the token flow Docker Hub, GHCR, Quay, Harbor and the cloud registries share.
+func (h *kubernetesReleaseHandler) ociToken(ctx context.Context, challenge string) (string, error) {
+	scheme, params, _ := strings.Cut(challenge, " ")
+	if !strings.EqualFold(scheme, "Bearer") {
+		return "", fmt.Errorf("listing tags: registry requires %q authentication", scheme)
+	}
+	realm := ""
+	query := url.Values{}
+	for _, m := range authParamRE.FindAllStringSubmatch(params, -1) {
+		switch m[1] {
+		case "realm":
+			realm = m[2]
+		case "service", "scope":
+			query.Set(m[1], m[2])
+		}
+	}
+	realmURL, err := url.Parse(realm)
+	if err != nil || realmURL.Scheme != "https" {
+		return "", fmt.Errorf("listing tags: unusable token realm %q", realm)
+	}
+	realmURL.RawQuery = query.Encode()
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, realmURL.String(), nil)
+	if err != nil {
+		return "", err
+	}
+	resp, err := h.client.Do(req)
+	if err != nil {
+		return "", err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return "", fmt.Errorf("fetching registry token: unexpected status %s", resp.Status)
+	}
+	var body struct {
+		Token       string `json:"token"`
+		AccessToken string `json:"access_token"`
+	}
+	if err := json.NewDecoder(io.LimitReader(resp.Body, 1<<20)).Decode(&body); err != nil {
+		return "", fmt.Errorf("fetching registry token: %w", err)
+	}
+	if body.Token != "" {
+		return body.Token, nil
+	}
+	if body.AccessToken != "" {
+		return body.AccessToken, nil
+	}
+	return "", fmt.Errorf("fetching registry token: response has no token")
+}
+
+var linkNextRE = regexp.MustCompile(`<([^>]+)>\s*;\s*rel="?next"?`)
+
+// nextLink resolves the `Link: </v2/...?last=x&n=y>; rel="next"` pagination header against the
+// page it came with. Only same-host links are followed, so the bearer token stays with the
+// registry that issued it.
+func nextLink(base *url.URL, header string) *url.URL {
+	m := linkNextRE.FindStringSubmatch(header)
+	if m == nil {
+		return nil
+	}
+	ref, err := url.Parse(m[1])
+	if err != nil {
+		return nil
+	}
+	next := base.ResolveReference(ref)
+	if next.Host != base.Host || next.Scheme != base.Scheme {
+		return nil
+	}
+	return next
+}
diff --git a/pkg/server/kubernetes_release_aks.go b/pkg/server/kubernetes_release_aks.go
new file mode 100644
index 00000000..836f0f10
--- /dev/null
+++ b/pkg/server/kubernetes_release_aks.go
@@ -0,0 +1,226 @@
+package server
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+
+	"k8s.io/apimachinery/pkg/util/version"
+)
+
+// aksReleaseFeedURL is the document the AKS Release Tracker (releases.aks.azure.com) renders
+// from. It is not a documented API, which is why parsing is limited to the few fields needed
+// and fails loudly rather than guessing when they move.
+const aksReleaseFeedURL = "https://releases.aks.azure.com/parsed_data.json"
+
+// The feed is ~22 MB today; this only bounds what a broken or hostile response can make bridge
+// read, nothing of it is buffered beyond one region's entry.
+const aksReleaseFeedMaxSize = 256 << 20
+
+// aksRegionStatus is one region's entry under
+// Sections.KubernetesSupportedVersions.Components.<component>.RegionalStatuses.<geography>[].
+type aksRegionStatus struct {
+	RegionName string `json:"RegionName"`
+	Current    struct {
+		KubernetesVersionList []struct {
+			// "1.36.4", or "1.33.13(LTS)" for a long-term-support version.
+			VersionName string `json:"VersionName"`
+			IsPreview   bool   `json:"IsPreview"`
+		} `json:"KubernetesVersionList"`
+	} `json:"Current"`
+}
+
+// normalizeAKSRegion maps the feed's display names ("West Europe") and Azure's region names
+// ("westeurope") onto one another.
+func normalizeAKSRegion(region string) string {
+	return strings.ToLower(strings.ReplaceAll(region, " ", ""))
+}
+
+func (h *kubernetesReleaseHandler) fetchAKS(ctx context.Context, source *url.URL) (string, error) {
+	region := source.Host
+	if region == "" || strings.Trim(source.Path, "/") != "" {
+		return "", fmt.Errorf("want aks://<region>, got %q", source.Redacted())
+	}
+	includePreview := source.Query().Get("preview") == "true"
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, h.aksFeedURL, nil)
+	if err != nil {
+		return "", err
+	}
+	// Ask only for a changed feed. The validators belong to the document the cached version came
+	// from, so they are only sent while there is one to fall back on.
+	if h.version != "" {
+		if h.etag != "" {
+			req.Header.Set("If-None-Match", h.etag)
+		}
+		if h.lastModified != "" {
+			req.Header.Set("If-Modified-Since", h.lastModified)
+		}
+	}
+	resp, err := h.client.Do(req)
+	if err != nil {
+		return "", err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode == http.StatusNotModified && h.version != "" {
+		return h.version, nil
+	}
+	if resp.StatusCode != http.StatusOK {
+		return "", fmt.Errorf("unexpected status %s", resp.Status)
+	}
+	status, err := findAKSRegion(io.LimitReader(resp.Body, aksReleaseFeedMaxSize), region)
+	if err != nil {
+		return "", err
+	}
+	latest, err := latestAKSVersion(status, includePreview)
+	if err != nil {
+		return "", err
+	}
+	h.etag, h.lastModified = resp.Header.Get("ETag"), resp.Header.Get("Last-Modified")
+	return latest, nil
+}
+
+func latestAKSVersion(status *aksRegionStatus, includePreview bool) (string, error) {
+	var latest *version.Version
+	for _, v := range status.Current.KubernetesVersionList {
+		if v.IsPreview && !includePreview {
+			continue
+		}
+		name, _, _ := strings.Cut(v.VersionName, "(")
+		parsed, err := version.ParseSemantic(strings.TrimSpace(name))
+		if err != nil {
+			continue
+		}
+		if latest == nil || parsed.GreaterThan(latest) {
+			latest = parsed
+		}
+	}
+	if latest == nil {
+		return "", fmt.Errorf("AKS offers no Kubernetes version in region %q", status.RegionName)
+	}
+	return "v" + latest.String(), nil
+}
+
+var errAKSRegionFound = errors.New("found")
+
+// findAKSRegion streams the feed and decodes only the region entries under
+// Sections.KubernetesSupportedVersions, one at a time, stopping at the one asked for. Every other
+// section -- add-ons, node images, CVEs, most of the 22 MB -- is skipped token by token, so
+// memory use is bounded by a single region's entry (tens of KB) instead of the document.
+func findAKSRegion(r io.Reader, region string) (*aksRegionStatus, error) {
+	dec := json.NewDecoder(r)
+	want := normalizeAKSRegion(region)
+	var found *aksRegionStatus
+	only := func(name string, next func() error) func(string) error {
+		return func(key string) error {
+			if key != name {
+				return skipJSONValue(dec)
+			}
+			return next()
+		}
+	}
+	err := walkJSONObject(dec, only("Sections", func() error {
+		return walkJSONObject(dec, only("KubernetesSupportedVersions", func() error {
+			return walkJSONObject(dec, only("Components", func() error {
+				return walkJSONObject(dec, func(string) error { // per component
+					return walkJSONObject(dec, only("RegionalStatuses", func() error {
+						return walkJSONObject(dec, func(string) error { // per geography
+							return walkJSONArray(dec, func() error {
+								var status aksRegionStatus
+								if err := dec.Decode(&status); err != nil {
+									return err
+								}
+								if normalizeAKSRegion(status.RegionName) == want {
+									found = &status
+									return errAKSRegionFound
+								}
+								return nil
+							})
+						})
+					}))
+				})
+			}))
+		}))
+	}))
+	switch {
+	case errors.Is(err, errAKSRegionFound):
+		return found, nil
+	case err != nil:
+		return nil, fmt.Errorf("reading the AKS release feed: %w", err)
+	default:
+		return nil, fmt.Errorf("region %q is not in the AKS release feed", region)
+	}
+}
+
+func expectJSONDelim(dec *json.Decoder, want json.Delim) error {
+	tok, err := dec.Token()
+	if err != nil {
+		return err
+	}
+	if d, ok := tok.(json.Delim); !ok || d != want {
+		return fmt.Errorf("expected %q, got %v", want, tok)
+	}
+	return nil
+}
+
+// walkJSONObject reads an object, calling field for each key; field must consume the value.
+func walkJSONObject(dec *json.Decoder, field func(key string) error) error {
+	if err := expectJSONDelim(dec, '{'); err != nil {
+		return err
+	}
+	for dec.More() {
+		tok, err := dec.Token()
+		if err != nil {
+			return err
+		}
+		key, ok := tok.(string)
+		if !ok {
+			return fmt.Errorf("expected an object key, got %v", tok)
+		}
+		if err := field(key); err != nil {
+			return err
+		}
+	}
+	return expectJSONDelim(dec, '}')
+}
+
+// walkJSONArray reads an array, calling element for each element; element must consume it.
+func walkJSONArray(dec *json.Decoder, element func() error) error {
+	if err := expectJSONDelim(dec, '['); err != nil {
+		return err
+	}
+	for dec.More() {
+		if err := element(); err != nil {
+			return err
+		}
+	}
+	return expectJSONDelim(dec, ']')
+}
+
+// skipJSONValue consumes one value without keeping it, unlike decoding into a json.RawMessage,
+// which buffers the whole value first.
+func skipJSONValue(dec *json.Decoder) error {
+	depth := 0
+	for {
+		tok, err := dec.Token()
+		if err != nil {
+			return err
+		}
+		if d, ok := tok.(json.Delim); ok {
+			switch d {
+			case '{', '[':
+				depth++
+			case '}', ']':
+				depth--
+			}
+		}
+		if depth == 0 {
+			return nil
+		}
+	}
+}
