@@ -0,0 +1,88 @@
+import { render, screen, waitFor } from '@testing-library/react';
+import { DescriptionList } from '@patternfly/react-core';
+import { coFetchJSON } from '@console/shared/src/utils/console-fetch';
+import { useK8sWatchResource } from '../../../../utils/k8s-watch-hook';
+import { KubernetesDetailItems } from '../kubernetes-details';
+
+jest.mock('../../../../utils/k8s-watch-hook', () => ({
+  useK8sWatchResource: jest.fn(),
+}));
+
+jest.mock('@console/shared/src/utils/console-fetch', () => ({
+  coFetchJSON: jest.fn(),
+}));
+
+const mockWatch = useK8sWatchResource as jest.Mock;
+const mockFetch = (coFetchJSON as unknown) as jest.Mock;
+
+const respond = (version: unknown, latest: unknown) =>
+  mockFetch.mockImplementation((url: string) => {
+    const response = url.endsWith('api/console/kubernetes-release') ? latest : version;
+    return response instanceof Error ? Promise.reject(response) : Promise.resolve(response);
+  });
+
+const notFound = Object.assign(new Error('not found'), { response: { status: 404 } });
+
+const renderItems = () =>
+  render(
+    <DescriptionList>
+      <KubernetesDetailItems />
+    </DescriptionList>,
+  );
+
+describe('KubernetesDetailItems', () => {
+  beforeEach(() => jest.clearAllMocks());
+
+  it('shows only the details the Secret has, and the versions', async () => {
+    mockWatch.mockReturnValue([
+      {
+        data: {
+          clusterID: btoa('abc-123'),
+          infrastructureProvider: btoa(' '),
+          versionPolicy: btoa('minor'),
+        },
+      },
+      true,
+      undefined,
+    ]);
+    respond({ gitVersion: 'v1.36.2' }, { version: 'v1.36.4' });
+    renderItems();
+
+    expect(await screen.findByText('v1.36.4')).toBeInTheDocument();
+    expect(screen.getByText('abc-123')).toBeInTheDocument();
+    expect(screen.getByText('v1.36.2')).toBeInTheDocument();
+    expect(screen.queryByText('Cluster API address')).not.toBeInTheDocument();
+    expect(screen.queryByText('Infrastructure provider')).not.toBeInTheDocument();
+    expect(screen.getByText('Within update policy')).toBeInTheDocument();
+  });
+
+  it('shows no details when the Secret cannot be read', async () => {
+    mockWatch.mockReturnValue([undefined, false, { response: { status: 403 } }]);
+    respond({ gitVersion: 'v1.35.0' }, { version: 'v1.36.4' });
+    renderItems();
+
+    expect(await screen.findByText('Update recommended')).toBeInTheDocument();
+    expect(screen.queryByText('Cluster ID')).not.toBeInTheDocument();
+  });
+
+  it('hides the latest version when bridge has the check switched off', async () => {
+    mockWatch.mockReturnValue([undefined, false, { response: { status: 404 } }]);
+    respond({ gitVersion: 'v1.36.4' }, notFound);
+    renderItems();
+
+    expect(await screen.findByText('v1.36.4')).toBeInTheDocument();
+    await waitFor(() => expect(screen.queryByText('Latest version')).not.toBeInTheDocument());
+  });
+
+  it('says so when the latest version cannot be fetched', async () => {
+    mockWatch.mockReturnValue([undefined, false, { response: { status: 404 } }]);
+    respond(
+      { gitVersion: 'v1.36.4' },
+      Object.assign(new Error('bad gateway'), { response: { status: 502 } }),
+    );
+    renderItems();
+
+    expect(await screen.findByText('Latest version')).toBeInTheDocument();
+    expect(await screen.findByText('Not available')).toBeInTheDocument();
+  });
+});
diff --git a/frontend/public/components/dashboard/dashboards-page/cluster-dashboard/__tests__/kubernetes-release.spec.ts b/frontend/public/components/dashboard/dashboards-page/cluster-dashboard/__tests__/kubernetes-release.spec.ts
