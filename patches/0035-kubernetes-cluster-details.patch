+)
+
+// A trimmed-down feed with the shape of releases.aks.azure.com/parsed_data.json: unrelated
+// sections around the one that matters (holding nested arrays and objects the skipper has to get
+// through), regions under several geographies, previews and LTS suffixes.
+const aksTestFeed = `{
+  "LastUpdateTime": "2026-10-08T23:06:20Z",
+  "Sections": {
+    "AKSAddon": {"Components": {"x": {"RegionalStatuses": {"Europe": [{"RegionName": "West Europe", "Current": {"KubernetesVersionList": [{"VersionName": "9.9.9"}]}}]}}}},
+    "KubernetesSupportedVersions": {
+      "SectionName": "KubernetesSupportedVersions",
+      "DefaultComponent": "KubernetesVersions",
+      "Components": {
+        "KubernetesVersions": {
+          "ComponentName": "KubernetesVersions",
+          "RegionalStatuses": {
+            "Africa": [
+              {"RegionName": "UAE North", "InProgress": false, "Current": {"Version": "<a>1.36.4</a>", "KubernetesVersionList": [
+                {"VersionName": "1.36.4", "IsPreview": false, "IsLTS": false}
+              ]}}
+            ],
+            "Europe": [
+              {"RegionName": "Germany West Central", "Current": {"KubernetesVersionList": [
+                {"VersionName": "1.35.8", "IsPreview": false}
+              ]}},
+              {"RegionName": "West Europe", "Recent": [{"Version": "1.36.3"}], "Current": {"KubernetesVersionList": [
+                {"VersionName": "1.37.0", "IsPreview": true, "IsLTS": false},
+                {"VersionName": "1.36.4", "IsPreview": false, "IsLTS": false},
+                {"VersionName": "1.36.10", "IsPreview": false, "IsLTS": false},
+                {"VersionName": "1.33.13(LTS)", "IsPreview": false, "IsLTS": true}
+              ]}}
+            ]
+          }
+        }
+      }
+    },
+    "WindowsImage": {"Components": {}}
+  }
+}`
+
+func TestFindAKSRegion(t *testing.T) {
+	for region, want := range map[string]string{
+		"westeurope":         "v1.36.10",
+		"West Europe":        "v1.36.10",
+		"germanywestcentral": "v1.35.8",
+		"uaenorth":           "v1.36.4",
+	} {
+		status, err := findAKSRegion(strings.NewReader(aksTestFeed), region)
+		if err != nil {
+			t.Fatalf("%s: %v", region, err)
+		}
+		if got, err := latestAKSVersion(status, false); err != nil || got != want {
+			t.Errorf("%s: got %q %v, want %q", region, got, err, want)
+		}
+	}
+
+	status, _ := findAKSRegion(strings.NewReader(aksTestFeed), "westeurope")
+	if got, _ := latestAKSVersion(status, true); got != "v1.37.0" {
+		t.Errorf("with previews: got %q, want v1.37.0", got)
+	}
+
+	if _, err := findAKSRegion(strings.NewReader(aksTestFeed), "atlantis"); err == nil {
+		t.Error("unknown region: want an error")
+	}
+	if _, err := findAKSRegion(strings.NewReader(`{"Sections": {"KubernetesSupportedVersions": [`), "westeurope"); err == nil {
+		t.Error("malformed feed: want an error")
+	}
+}
+
+func TestKubernetesReleaseHandlerAKS(t *testing.T) {
+	var full, notModified atomic.Int32
+	feed := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Header.Get("If-None-Match") == `"v1"` {
+			notModified.Add(1)
+			w.WriteHeader(http.StatusNotModified)
+			return
+		}
+		full.Add(1)
+		w.Header().Set("ETag", `"v1"`)
+		w.Header().Set("Last-Modified", "Thu, 08 Oct 2026 23:06:20 GMT")
+		_, _ = w.Write([]byte(aksTestFeed))
+	}))
+	defer feed.Close()
+
+	h := newKubernetesReleaseHandler("aks://westeurope")
+	h.aksFeedURL = feed.URL
+	if code, version := serveKubernetesRelease(t, h); code != http.StatusOK || version != "v1.36.10" {
+		t.Fatalf("got %d %q, want 200 v1.36.10", code, version)
+	}
+
+	// Once expired, the refresh is conditional and a 304 keeps the version.
+	h.expires = time.Time{}
+	if code, version := serveKubernetesRelease(t, h); code != http.StatusOK || version != "v1.36.10" {
+		t.Fatalf("after 304: got %d %q, want 200 v1.36.10", code, version)
+	}
+	if full.Load() != 1 || notModified.Load() != 1 {
+		t.Fatalf("got %d full and %d conditional fetches, want 1 and 1", full.Load(), notModified.Load())
+	}
+
+	// With previews, from a fresh handler.
+	h = newKubernetesReleaseHandler("aks://westeurope?preview=true")
+	h.aksFeedURL = feed.URL
+	if _, version := serveKubernetesRelease(t, h); version != "v1.37.0" {
+		t.Fatalf("with previews: got %q, want v1.37.0", version)
+	}
+
+	for _, bad := range []string{"aks://atlantis", "aks:///westeurope", "aks://westeurope/extra"} {
+		h = newKubernetesReleaseHandler(bad)
+		h.aksFeedURL = feed.URL
+		if code, _ := serveKubernetesRelease(t, h); code != http.StatusBadGateway {
+			t.Errorf("%s: got %d, want 502", bad, code)
+		}
+	}
+}
diff --git a/pkg/server/kubernetes_release_test.go b/pkg/server/kubernetes_release_test.go
