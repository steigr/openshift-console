diff --git a/frontend/public/components/dashboard/dashboards-page/cluster-dashboard/kubernetes-details.tsx b/frontend/public/components/dashboard/dashboards-page/cluster-dashboard/kubernetes-details.tsx
new file mode 100644
index 00000000..a4222073
--- /dev/null
+++ b/frontend/public/components/dashboard/dashboards-page/cluster-dashboard/kubernetes-details.tsx
@@ -0,0 +1,151 @@
+import type { FC } from 'react';
+import { useEffect, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import {
+  GreenCheckCircleIcon,
+  YellowExclamationTriangleIcon,
+} from '@console/shared/src/components/status/icons';
+import { coFetchJSON } from '@console/shared/src/utils/console-fetch';
+import { OverviewDetailItem } from '@console/internal/components/overview/OverviewDetailItem';
+import type { WatchK8sResource } from '@console/dynamic-plugin-sdk';
+import { ConfigMapModel } from '../../../../models';
+import type { ConfigMapKind } from '../../../../module/k8s';
+import { k8sVersion } from '../../../../module/status';
+import { useK8sWatchResource } from '../../../utils/k8s-watch-hook';
+import {
+  CLUSTER_DETAILS_NAME,
+  CLUSTER_DETAILS_NAMESPACE,
+  ClusterDetailsKey,
+  compareVersions,
+  parseVersionPolicy,
+  parseVersionsBehind,
+} from './kubernetes-release';
+
+const clusterDetailsResource: WatchK8sResource = {
+  kind: ConfigMapModel.kind,
+  namespace: CLUSTER_DETAILS_NAMESPACE,
+  name: CLUSTER_DETAILS_NAME,
+  isList: false,
+};
+
+type FetchState<T> = { data?: T; error?: unknown; disabled?: boolean };
+
+const useFetchOnce = <T,>(fetcher: () => Promise<T>): FetchState<T> => {
+  const [state, setState] = useState<FetchState<T>>({});
+  useEffect(() => {
+    let mounted = true;
+    fetcher().then(
+      (data) => mounted && setState({ data }),
+      // bridge answers 404 when the release check is switched off (--kubernetes-release-url='').
+      (error) => mounted && setState({ error, disabled: error?.response?.status === 404 }),
+    );
+    return () => {
+      mounted = false;
+    };
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+  return state;
+};
+
+const fetchLatestRelease = () =>
+  coFetchJSON(`${window.SERVER_FLAGS.basePath}api/console/kubernetes-release`) as Promise<{
+    version?: string;
+  }>;
+
+const LatestVersion: FC<{ current?: string; latest: string; details?: Record<string, string> }> = ({
+  current,
+  latest,
+  details,
+}) => {
+  const { t } = useTranslation();
+  const comparison = current
+    ? compareVersions(
+        current,
+        latest,
+        parseVersionPolicy(details?.[ClusterDetailsKey.VersionPolicy]),
+        parseVersionsBehind(details?.[ClusterDetailsKey.VersionsBehind]),
+      )
+    : undefined;
+  return (
+    <>
+      <span className="co-select-to-copy">{latest}</span>
+      {comparison && (
+        <div data-test="latest-version-status">
+          {comparison.withinPolicy ? (
+            <GreenCheckCircleIcon className="co-icon-space-r" />
+          ) : (
+            <YellowExclamationTriangleIcon className="co-icon-space-r" />
+          )}
+          {comparison.upToDate
+            ? t('public~Up to date')
+            : comparison.withinPolicy
+            ? t('public~Within update policy')
+            : t('public~Update recommended')}
+        </div>
+      )}
+    </>
+  );
+};
+
+/**
+ * The Details card's items when not running on OpenShift: the cluster's own description from the
+ * cluster-details ConfigMap, each item shown only when the ConfigMap has it, then the
+ * kube-apiserver's version and the latest Kubernetes release.
+ */
+export const KubernetesDetailItems: FC = () => {
+  const { t } = useTranslation();
+  const [clusterDetails, clusterDetailsLoaded, clusterDetailsError] = useK8sWatchResource<
+    ConfigMapKind
+  >(clusterDetailsResource);
+  const version = useFetchOnce<{ gitVersion?: string }>(k8sVersion);
+  const latest = useFetchOnce(fetchLatestRelease);
+
+  // Missing or unreadable (no RBAC) both just mean there is nothing to show.
+  const details = clusterDetailsLoaded && !clusterDetailsError ? clusterDetails?.data : undefined;
+  const items: [string, ClusterDetailsKey][] = [
+    [t('public~Cluster API address'), ClusterDetailsKey.APIAddress],
+    [t('public~Cluster ID'), ClusterDetailsKey.ClusterID],
+    [t('public~Infrastructure provider'), ClusterDetailsKey.InfrastructureProvider],
+  ];
+  const gitVersion = version.data?.gitVersion;
+  const latestVersion = latest.data?.version;
+
+  return (
+    <>
+      {items
+        .filter(([, key]) => details?.[key]?.trim())
+        .map(([title, key]) => (
+          <OverviewDetailItem key={key} title={title} valueClassName="co-select-to-copy">
+            {details[key].trim()}
+          </OverviewDetailItem>
+        ))}
+      <OverviewDetailItem
+        title={t('public~Kubernetes version')}
+        error={
+          version.error || (version.data && !gitVersion) ? t('public~Not available') : undefined
+        }
+        isLoading={!version.data && !version.error}
+        valueClassName="co-select-to-copy"
+      >
+        {gitVersion}
+      </OverviewDetailItem>
+      {!latest.disabled && (
+        <OverviewDetailItem
+          title={t('public~Latest version')}
+          error={
+            latest.error || (latest.data && !latestVersion) ? t('public~Not available') : undefined
+          }
+          // Waiting for the cluster's version and the policy too keeps the status line from
+          // popping in or flipping late.
+          isLoading={
+            (!latest.data && !latest.error) ||
+            (!version.data && !version.error) ||
+            (!clusterDetailsLoaded && !clusterDetailsError)
+          }
+        >
+          <LatestVersion current={gitVersion} latest={latestVersion} details={details} />
+        </OverviewDetailItem>
+      )}
+    </>
+  );
+};
diff --git a/frontend/public/components/dashboard/dashboards-page/cluster-dashboard/kubernetes-release.ts b/frontend/public/components/dashboard/dashboards-page/cluster-dashboard/kubernetes-release.ts
new file mode 100644
index 00000000..a98dc4c8
--- /dev/null
+++ b/frontend/public/components/dashboard/dashboards-page/cluster-dashboard/kubernetes-release.ts
@@ -0,0 +1,97 @@
+/**
+ * Cluster details for a cluster that is not OpenShift, which has no ClusterVersion or
+ * Infrastructure resource to read them from. An administrator publishes them in this ConfigMap
+ * instead. kube-public is the namespace Kubernetes reserves for exactly this kind of
+ * cluster-wide, readable-by-everyone information (kubeadm's cluster-info lives there), though
+ * every user still needs RBAC to read this particular ConfigMap.
+ */
+export const CLUSTER_DETAILS_NAMESPACE = 'kube-public';
+export const CLUSTER_DETAILS_NAME = 'cluster-details';
+
+export enum ClusterDetailsKey {
+  APIAddress = 'apiAddress',
+  ClusterID = 'clusterID',
+  InfrastructureProvider = 'infrastructureProvider',
+  /** How the cluster's version is compared with the latest release: major, minor or patch. */
+  VersionPolicy = 'versionPolicy',
+  /** How many releases, at the granularity of versionPolicy, the cluster may lag behind. */
+  VersionsBehind = 'versionsBehind',
+}
+
+export enum VersionPolicy {
+  Major = 'major',
+  Minor = 'minor',
+  Patch = 'patch',
+}
+
+export type VersionComparison = {
+  /** The cluster runs the latest release or something newer. */
+  upToDate: boolean;
+  /** The cluster is behind by no more than the policy allows. */
+  withinPolicy: boolean;
+};
+
+type ParsedVersion = [number, number, number];
+
+/** Parses the numeric part of `v1.34.1`, `1.34.1-rc.0` or `v1.34.1+k3s1`. */
+export const parseVersion = (version: string): ParsedVersion | undefined => {
+  const match = /^v?(\d+)\.(\d+)\.(\d+)/.exec(version?.trim() ?? '');
+  return match ? [Number(match[1]), Number(match[2]), Number(match[3])] : undefined;
+};
+
+export const parseVersionPolicy = (policy: string | undefined): VersionPolicy =>
+  Object.values(VersionPolicy).find((p) => p === policy?.trim().toLowerCase()) ??
+  VersionPolicy.Patch;
+
+export const parseVersionsBehind = (behind: string | undefined): number => {
+  const n = Number.parseInt(behind ?? '', 10);
+  return Number.isFinite(n) && n >= 0 ? n : 0;
+};
+
+/**
+ * Compares the cluster's version with the latest release. The policy decides which part of the
+ * version counts and how far behind is acceptable:
+ *
+ * - `major`: only the major version counts; `versionsBehind` majors back is fine.
+ * - `minor`: the latest major is required; `versionsBehind` minors back is fine, patches are
+ *   ignored.
+ * - `patch`: the latest minor is required; `versionsBehind` patches back is fine.
+ *
+ * Pre-release and build suffixes are ignored, so `v1.34.1+k3s1` counts as `v1.34.1`.
+ */
+export const compareVersions = (
+  current: string,
+  latest: string,
+  policy: VersionPolicy = VersionPolicy.Patch,
+  versionsBehind = 0,
+): VersionComparison | undefined => {
+  const cur = parseVersion(current);
+  const lat = parseVersion(latest);
+  if (!cur || !lat) {
+    return undefined;
+  }
+  const firstDifference = [0, 1, 2].find((i) => cur[i] !== lat[i]);
+  if (firstDifference === undefined || cur[firstDifference] > lat[firstDifference]) {
+    return { upToDate: true, withinPolicy: true };
+  }
+  const significant = {
+    [VersionPolicy.Major]: 0,
+    [VersionPolicy.Minor]: 1,
+    [VersionPolicy.Patch]: 2,
+  }[policy];
+  // Behind only below the part the policy compares (an older patch under a minor policy) is
+  // still current as far as the policy is concerned.
+  if (firstDifference > significant) {
+    return { upToDate: false, withinPolicy: true };
+  }
+  // Behind in a coarser part than the policy compares (an older minor under a patch policy) is
+  // outside it whatever the numbers: how many patches lie between v1.33.9 and v1.34.1 is
+  // unknowable from the two versions alone.
+  if (firstDifference < significant) {
+    return { upToDate: false, withinPolicy: false };
+  }
+  return {
+    upToDate: false,
+    withinPolicy: lat[significant] - cur[significant] <= versionsBehind,
+  };
+};
