--- a/pkg/server/server.go
+++ b/pkg/server/server.go
@@ -272,6 +272,30 @@ func injectImpersonateUserHeader(r *http.Request, user *auth.User) {
 	r.Header.Add("Impersonate-User", impersonateUserID)
 }
 
+// injectImpersonateGroupHeaders forwards the authenticated user's groups as
+// `Impersonate-Group` request headers, optionally filtered by the
+// OIDC_GROUP_MATCHER (allow-list) and OIDC_EXCLUDE_GROUP_MATCHER (deny-list)
+// regular expressions. When neither variable is set all groups are forwarded.
+func injectImpersonateGroupHeaders(r *http.Request, user *auth.User) {
+	if user == nil || len(user.Groups) == 0 {
+		return
+	}
+	groupMatcher := os.Getenv("OIDC_GROUP_MATCHER")
+	excludedGroupMatcher := os.Getenv("OIDC_EXCLUDE_GROUP_MATCHER")
+	for _, group := range user.Groups {
+		if excludedGroupMatcher == "" && groupMatcher == "" {
+			r.Header.Add("Impersonate-Group", group)
+			continue
+		}
+		if excludedGroupMatcher != "" && serverutils.MatchString(excludedGroupMatcher, group) {
+			continue
+		}
+		if groupMatcher == "" || serverutils.MatchString(groupMatcher, group) {
+			r.Header.Add("Impersonate-Group", group)
+		}
+	}
+}
