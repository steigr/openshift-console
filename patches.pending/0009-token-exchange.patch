diff --git a/pkg/auth/oauth2/token_exchange.go b/pkg/auth/oauth2/token_exchange.go
new file mode 100644
index 00000000..dd01361c
--- /dev/null
+++ b/pkg/auth/oauth2/token_exchange.go
@@ -0,0 +1,203 @@
+package oauth2
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"strings"
+	"sync"
+	"time"
+
+	"k8s.io/klog/v2"
+)
+
+// tokenExchangeMode selects between the standard OAuth2 Token Exchange
+// (RFC 8693) and the Azure AD on-behalf-of flow.
+type tokenExchangeMode string
+
+const (
+	tokenExchangeModeRFC8693 tokenExchangeMode = "rfc8693"
+	tokenExchangeModeAADOBO  tokenExchangeMode = "aad-obo"
+
+	tokenExchangeCacheSkew = 30 * time.Second
+)
+
+type cachedToken struct {
+	token  string
+	expiry time.Time
+}
+
+// tokenExchanger exchanges the user's authenticator-issued access token for an
+// access token usable against the upstream cluster API (e.g. AKS). Results
+// are cached in-memory keyed by a hash of the inputs and evicted on expiry.
+type tokenExchanger struct {
+	mu    sync.Mutex
+	cache map[string]cachedToken
+}
+
+func newTokenExchanger() *tokenExchanger {
+	return &tokenExchanger{cache: map[string]cachedToken{}}
+}
+
+type tokenExchangeResponse struct {
+	AccessToken     string `json:"access_token"`
+	IssuedTokenType string `json:"issued_token_type"`
+	TokenType       string `json:"token_type"`
+	ExpiresIn       int    `json:"expires_in"`
+	Scope           string `json:"scope"`
+}
+
+func tokenExchangeCacheKey(mode, subjectToken, audience, scope string) string {
+	h := sha256.Sum256([]byte(mode + "|" + subjectToken + "|" + audience + "|" + scope))
+	return hex.EncodeToString(h[:])
+}
+
+// exchange exchanges subjectToken for a fresh access token. tokenURL, clientID
+// and clientSecret provide defaults pulled from the OIDC client config and
+// may be overridden by AUTH_TOKEN_EXCHANGE_* environment variables.
+func (t *tokenExchanger) exchange(
+	ctx context.Context,
+	httpClient *http.Client,
+	tokenURL, clientID, clientSecret, subjectToken string,
+) (string, time.Time, error) {
+	if subjectToken == "" {
+		return "", time.Time{}, fmt.Errorf("token exchange: empty subject token")
+	}
+
+	mode := tokenExchangeMode(strings.ToLower(os.Getenv("AUTH_TOKEN_EXCHANGE_MODE")))
+	if mode == "" {
+		mode = tokenExchangeModeRFC8693
+	}
+	audience := os.Getenv("AUTH_TOKEN_EXCHANGE_AUDIENCE")
+	scope := os.Getenv("AUTH_TOKEN_EXCHANGE_SCOPE")
+
+	key := tokenExchangeCacheKey(string(mode), subjectToken, audience, scope)
+	t.mu.Lock()
+	if entry, ok := t.cache[key]; ok && time.Now().Before(entry.expiry.Add(-tokenExchangeCacheSkew)) {
+		token, expiry := entry.token, entry.expiry
+		t.mu.Unlock()
+		return token, expiry, nil
+	}
+	t.mu.Unlock()
+
+	if v := os.Getenv("AUTH_TOKEN_EXCHANGE_TOKEN_URL"); v != "" {
+		tokenURL = v
+	}
+	if v := os.Getenv("AUTH_TOKEN_EXCHANGE_CLIENT_ID"); v != "" {
+		clientID = v
+	}
+	if v := os.Getenv("AUTH_TOKEN_EXCHANGE_CLIENT_SECRET"); v != "" {
+		clientSecret = v
+	}
+	if v := os.Getenv("AUTH_TOKEN_EXCHANGE_CLIENT_SECRET_FILE"); v != "" {
+		if buf, err := os.ReadFile(v); err == nil {
+			clientSecret = strings.TrimSpace(string(buf))
+		} else {
+			klog.Warningf("token exchange: failed to read client secret file %q: %v", v, err)
+		}
+	}
+	if tokenURL == "" {
+		return "", time.Time{}, fmt.Errorf("token exchange: token URL is empty (set AUTH_TOKEN_EXCHANGE_TOKEN_URL)")
+	}
+
+	form := url.Values{}
+	switch mode {
+	case tokenExchangeModeAADOBO:
+		form.Set("grant_type", "urn:ietf:params:oauth:grant-type:jwt-bearer")
+		form.Set("assertion", subjectToken)
+		form.Set("requested_token_use", "on_behalf_of")
+		obScope := scope
+		if obScope == "" && audience != "" {
+			obScope = audience + "/.default"
+		}
+		if obScope != "" {
+			form.Set("scope", obScope)
+		}
+		if clientID != "" {
+			form.Set("client_id", clientID)
+		}
+		if clientSecret != "" {
+			form.Set("client_secret", clientSecret)
+		}
+	case tokenExchangeModeRFC8693:
+		form.Set("grant_type", "urn:ietf:params:oauth:grant-type:token-exchange")
+		form.Set("subject_token", subjectToken)
+		subjType := os.Getenv("AUTH_TOKEN_EXCHANGE_SUBJECT_TOKEN_TYPE")
+		if subjType == "" {
+			subjType = "urn:ietf:params:oauth:token-type:access_token"
+		}
+		form.Set("subject_token_type", subjType)
+		if audience != "" {
+			form.Set("audience", audience)
+		}
+		if scope != "" {
+			form.Set("scope", scope)
+		}
+		if rtt := os.Getenv("AUTH_TOKEN_EXCHANGE_REQUESTED_TOKEN_TYPE"); rtt != "" {
+			form.Set("requested_token_type", rtt)
+		}
+		if cn := os.Getenv("AUTH_TOKEN_EXCHANGE_CONNECTOR_ID"); cn != "" {
+			form.Set("connector_id", cn)
+		}
+	default:
+		return "", time.Time{}, fmt.Errorf("token exchange: unknown mode %q (use %q or %q)", mode, tokenExchangeModeRFC8693, tokenExchangeModeAADOBO)
+	}
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, tokenURL, strings.NewReader(form.Encode()))
+	if err != nil {
+		return "", time.Time{}, fmt.Errorf("token exchange: build request: %w", err)
+	}
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	req.Header.Set("Accept", "application/json")
+	// RFC 8693 prefers HTTP Basic for client auth; AAD OBO expects credentials
+	// in the form body (Microsoft's documented pattern).
+	if mode == tokenExchangeModeRFC8693 && clientID != "" {
+		req.SetBasicAuth(clientID, clientSecret)
+	}
+
+	if httpClient == nil {
+		httpClient = http.DefaultClient
+	}
+	resp, err := httpClient.Do(req)
+	if err != nil {
+		return "", time.Time{}, fmt.Errorf("token exchange: request failed: %w", err)
+	}
+	defer resp.Body.Close()
+	body, _ := io.ReadAll(io.LimitReader(resp.Body, 1<<20))
+	if resp.StatusCode != http.StatusOK {
+		return "", time.Time{}, fmt.Errorf("token exchange: %d %s", resp.StatusCode, strings.TrimSpace(string(body)))
+	}
+
+	var ter tokenExchangeResponse
+	if err := json.Unmarshal(body, &ter); err != nil {
+		return "", time.Time{}, fmt.Errorf("token exchange: parse response: %w", err)
+	}
+	if ter.AccessToken == "" {
+		return "", time.Time{}, fmt.Errorf("token exchange: response missing access_token")
+	}
+
+	expiresIn := ter.ExpiresIn
+	if expiresIn <= 0 {
+		expiresIn = 300
+	}
+	expiry := time.Now().Add(time.Duration(expiresIn) * time.Second)
+
+	t.mu.Lock()
+	now := time.Now()
+	for k, v := range t.cache {
+		if now.After(v.expiry) {
+			delete(t.cache, k)
+		}
+	}
+	t.cache[key] = cachedToken{token: ter.AccessToken, expiry: expiry}
+	t.mu.Unlock()
+
+	klog.V(4).Infof("token exchange: succeeded mode=%s expires_in=%d", mode, expiresIn)
+	return ter.AccessToken, expiry, nil
+}
