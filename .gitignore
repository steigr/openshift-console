.idea
config.local.mk

# openshift/console clone+patch build target (see `make build-console`)
/console/

# upstream plugin clones (see `make frontend-source-*`)
/plugins/*/upstream/
# The contents rather than the directory itself, so a plugin whose backend
# embeds dist/ can commit a placeholder there (its own .gitignore re-includes
# it) and `go build ./...` works in a fresh checkout.
/plugins/*/dist/*
/plugins/*/node_modules/
/.playwright-mcp
