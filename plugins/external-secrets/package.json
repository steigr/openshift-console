{
  "name": "external-secrets-console-plugin",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rm -rf dist",
    "dev": "NODE_ENV=development NODE_OPTIONS=--max-old-space-size=4096 rm -rf dist && npm run ts-node -- ./node_modules/.bin/webpack serve --progress",
    "build": "npm run clean && NODE_ENV=production npm run ts-node -- node_modules/.bin/webpack",
    "build-dev": "npm run clean && npm run ts-node -- node_modules/.bin/webpack",
    "start": "npm run ts-node -- node_modules/.bin/webpack serve",
    "ts-node": "ts-node -O '{\"module\":\"commonjs\"}'",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-i18next": "^11.7.3",
    "react-router-dom-v5-compat": "^6.22.2"
  },
  "devDependencies": {
    "@openshift-console/dynamic-plugin-sdk": "4.20.0",
    "@openshift-console/dynamic-plugin-sdk-internal": "4.20.0",
    "@openshift-console/dynamic-plugin-sdk-webpack": "4.20.0",
    "@patternfly/react-core": "~6.4.0",
    "@patternfly/react-icons": "~6.4.0",
    "@patternfly/react-table": "~6.4.0",
    "@types/node": "^18.0.0",
    "@types/react": "^17.0.37",
    "@types/react-dom": "^17.0.11",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^6.7.1",
    "esbuild-loader": "^4.4.2",
    "style-loader": "^3.3.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "typescript": "5.7.x",
    "webpack": "^5.104.1",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "^5.2.3"
  }
}
