{
  "name": "node-logging-console-plugin",
  "version": "0.0.1",
  "private": true,
  "repository": "git@github.com:netztronaut/console-node-logging-plugin.git",
  "license": "Apache-2.0",
  "scripts": {
    "clean": "mkdir -p dist && find dist -mindepth 1 ! -name placeholder.txt -delete",
    "build": "yarn clean && NODE_ENV=production yarn webpack",
    "build-dev": "yarn clean && yarn webpack",
    "coverage": "jest --coverage",
    "start": "yarn webpack serve --progress",
    "start-console": "./start-console.sh",
    "i18n": "./i18n-scripts/build-i18n.sh && node ./i18n-scripts/set-english-defaults.js",
    "test": "LANG=en_US.UTF-8 jest",
    "lint": "eslint src --fix --max-warnings 0",
    "webpack": "node -r ts-node/register ./node_modules/.bin/webpack"
  },
  "devDependencies": {
    "@openshift-console/dynamic-plugin-sdk": "4.22.0-prerelease.3",
    "@openshift-console/dynamic-plugin-sdk-internal": "4.22.0-prerelease.3",
    "@openshift-console/dynamic-plugin-sdk-webpack": "4.22.0-prerelease.3",
    "@patternfly/react-core": "^6.4.3",
    "@swc/core": "^1.15.40",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.28",
    "comment-json": "^4.2.5",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "globals": "^17.6.0",
    "i18next": "^25.8.18",
    "i18next-parser": "^9.4.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "pluralize": "^8.0.0",
    "prettier": "^3.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "~16.5.8",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "webpack-dev-server": "^5.2.4"
  },
  "consolePlugin": {
    "name": "node-logging-console-plugin",
    "version": "0.0.1",
    "displayName": "Node Logging Plugin",
    "description": "OpenShift Console plugin that makes the Node details Logs tab work on non-OpenShift kubelets by serving systemd journal logs through a node-logs-api DaemonSet.",
    "exposedModules": {
      "fetchPatch": "./fetch-patch"
    },
    "dependencies": {
      "@console/pluginAPI": ">=4.22.0-0"
    }
  },
  "packageManager": "yarn@4.14.1"
}
