+/**
+ * Perses shows times in the zone the URL names (`tz`, set from the dashboard's time zone picker)
+ * and otherwise in the browser's own ('local'), a default TimeRangeProviderWithQueryParams fixes
+ * internally. Console's time zone preference takes the place of that default, overriding the
+ * provider it sets up; the toolbar's picker uses the same default (persesTimeZone).
+ */
+export const persesTimeZone = (): string => getTimeZone() ?? 'local';
+
+const PreferredTimeZoneProvider = ({ children }: { children: React.ReactNode }) => {
+  const { timeZone } = useTimeZoneParams(persesTimeZone());
+  return <TimeZoneProvider timeZone={timeZone}>{children}</TimeZoneProvider>;
+};
+
 interface PersesPrometheusDatasourceWrapperProps {
   queries: Definition<UnknownSpec>[];
   dashboardResource?: DashboardResource;
