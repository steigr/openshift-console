index 0000000..10972de
--- /dev/null
+++ b/src/utils/components/ExternalDnsCell/ExternalDnsCell.tsx
@@ -0,0 +1,64 @@
+import React, { FC } from 'react';
+
+import { Label, Spinner, Tooltip } from '@patternfly/react-core';
+import { computeSyncStatus, ExternalDnsLookupResults } from '@utils/hooks/useExternalDns';
+
+type ExternalDnsCellProps = {
+  // Where this resource's own status says its DNS target should point (see
+  // getServiceExpectedAddresses/getIngressExpectedAddresses/
+  // getRouteExpectedAddresses) - the same set applies to every hostname of
+  // this resource, since they should all point at the one thing it exposes.
+  expectedAddresses?: string[];
+  hostnames: string[];
+  loading: boolean;
+  results: ExternalDnsLookupResults;
+};
+
+const ExternalDnsCell: FC<ExternalDnsCellProps> = ({
+  expectedAddresses,
+  hostnames,
+  loading,
+  results,
+}) => {
+  if (!hostnames || hostnames.length === 0) {
+    return <>-</>;
+  }
+  if (loading) {
+    return <Spinner aria-label="Checking external-dns ownership" size="sm" />;
+  }
+
+  const managedHostnames = hostnames.filter((hostname) => results[hostname]?.managed);
+  if (managedHostnames.length === 0) {
+    return <>-</>;
+  }
+
+  return (
+    <>
+      {managedHostnames.map((hostname) => {
+        const result = results[hostname];
+        const ownerId = result?.ownerId;
+        const syncStatus = computeSyncStatus(result?.addresses, expectedAddresses);
+        const outOfSync = syncStatus === 'out-of-sync';
+
+        const tooltip = outOfSync
+          ? `${hostname}: managed by ${ownerId || 'external-dns'}, but out of sync - resolves to ${
+              result?.addresses?.join(', ') || 'nothing'
+            }, expected ${expectedAddresses?.join(', ')}`
+          : `${hostname}: managed by ${ownerId || 'external-dns'}`;
+
+        return (
+          <div key={hostname}>
+            <Tooltip content={tooltip}>
+              <Label color={outOfSync ? 'orange' : 'green'} isCompact>
+                {hostname}
+                {outOfSync ? ' (out of sync)' : ''}
+              </Label>
+            </Tooltip>
+          </div>
+        );
+      })}
+    </>
+  );
+};
+
+export default ExternalDnsCell;
diff --git a/src/utils/hooks/useExternalDns.tsx b/src/utils/hooks/useExternalDns.tsx
new file mode 100644
index 0000000..769a19d
--- /dev/null
+++ b/src/utils/hooks/useExternalDns.tsx
@@ -0,0 +1,252 @@
+import { useEffect, useMemo, useState } from 'react';
+
+import { consoleFetchJSON, useFlag } from '@openshift-console/dynamic-plugin-sdk';
+
+// Declared by the external-dns-console-plugin's `console.flag/model`
+// extension (steigr/openshift-console's plugins/external-dns) once the
+// DNSEndpoint CRD is present on the cluster. Any plugin can read it, not
+// just the one that declared it - if that plugin isn't installed at all the
+// flag simply stays unset and useExternalDnsColumn below returns false.
+const EXTERNAL_DNS_FLAG = 'EXTERNAL_DNS';
+
+const HOSTNAME_ANNOTATION = 'external-dns.alpha.kubernetes.io/hostname';
+const INTERNAL_HOSTNAME_ANNOTATION = 'external-dns.alpha.kubernetes.io/internal-hostname';
+const EXCLUDE_ANNOTATION = 'external-dns.alpha.kubernetes.io/exclude';
+
+const splitHostnames = (value: string): string[] =>
+  value
+    .split(',')
+    .map((h) => h.trim())
+    .filter(Boolean);
+
+// Base shape every DNS-candidate-source object satisfies - kept loose (and
+// reused as the useExternalDnsColumnData generic constraint below) so any
+// concrete K8s resource type structurally matches without a cast.
+export type DnsCandidateSource = {
+  metadata?: { annotations?: Record<string, string>; uid?: string };
+};
+
+const annotationHostnames = (obj: DnsCandidateSource) => {
+  const annotations = obj.metadata?.annotations || {};
+  if (annotations[EXCLUDE_ANNOTATION] === 'true') {
+    return [];
+  }
+  return [
+    ...(annotations[HOSTNAME_ANNOTATION] ? splitHostnames(annotations[HOSTNAME_ANNOTATION]) : []),
+    ...(annotations[INTERNAL_HOSTNAME_ANNOTATION]
+      ? splitHostnames(annotations[INTERNAL_HOSTNAME_ANNOTATION])
+      : []),
+  ];
+};
+
+// Candidate hostnames external-dns would publish for a Service - only an
+// explicit hostname annotation is a reliable signal here. A bare
+// LoadBalancer Service is only DNS-managed when external-dns runs with a
+// cluster-wide --fqdn-template, which isn't visible from the object itself.
+export const getServiceCandidateHostnames = (obj: DnsCandidateSource): string[] =>
+  Array.from(new Set(annotationHostnames(obj)));
+
+export const getIngressCandidateHostnames = (
+  obj: { spec?: { rules?: { host?: string }[] } } & DnsCandidateSource,
+): string[] => {
+  const ruleHosts = (obj.spec?.rules || []).map((rule) => rule.host).filter(Boolean) as string[];
+  return Array.from(new Set([...annotationHostnames(obj), ...ruleHosts]));
+};
+
+export const getRouteCandidateHostnames = (
+  obj: { spec?: { host?: string } } & DnsCandidateSource,
+): string[] => {
+  const routeHost = obj.spec?.host;
+  return Array.from(new Set([...annotationHostnames(obj), ...(routeHost ? [routeHost] : [])]));
+};
+
+// Where this resource's own status says its DNS target should point -
+// compared (via computeSyncStatus) against the hostname's actual resolved
+// addresses to catch a record that's drifted out of sync. undefined means
+// "no reliable signal to compare against", not "nothing is wrong".
+type LoadBalancerIngress = { hostname?: string; ip?: string };
+type WithLoadBalancerStatus = {
+  status?: { loadBalancer?: { ingress?: LoadBalancerIngress[] } };
+} & DnsCandidateSource;
+
+const expectedAddressesFromLoadBalancer = (obj: WithLoadBalancerStatus): string[] | undefined => {
+  const addrs = (obj.status?.loadBalancer?.ingress || [])
+    .map((i) => i.ip || i.hostname)
+    .filter(Boolean) as string[];
+  return addrs.length > 0 ? addrs : undefined;
+};
+
+export const getServiceExpectedAddresses = expectedAddressesFromLoadBalancer;
+export const getIngressExpectedAddresses = expectedAddressesFromLoadBalancer;
+
+export const getRouteExpectedAddresses = (
+  obj: { status?: { ingress?: { routerCanonicalHostname?: string }[] } } & DnsCandidateSource,
+): string[] | undefined => {
+  // Routes have no LB status of their own - the router's
+  // routerCanonicalHostname (when set) is the documented signal for what a
+  // CNAME record for this Route should target.
+  const addrs = (obj.status?.ingress || [])
+    .map((i) => i.routerCanonicalHostname)
+    .filter(Boolean) as string[];
+  return addrs.length > 0 ? addrs : undefined;
+};
+
+export type SyncStatus = 'in-sync' | 'out-of-sync' | 'unknown';
+
+// Compares a hostname's actual resolved addresses against where the owning
+// resource expects it to point. "unknown" (not a mismatch) when either side
+// has nothing to compare.
+export const computeSyncStatus = (
+  resolvedAddresses: string[] | undefined,
+  expectedAddresses: string[] | undefined,
+): SyncStatus => {
+  if (!resolvedAddresses?.length || !expectedAddresses?.length) {
+    return 'unknown';
+  }
+  const resolved = new Set(resolvedAddresses.map((a) => a.toLowerCase()));
+  const matches = expectedAddresses.some((a) => resolved.has(a.toLowerCase()));
+  return matches ? 'in-sync' : 'out-of-sync';
+};
+
+// The backend's lookup checks the TXT registry-ownership record for a
+// hostname (managed/ownerId) and separately resolves its current A/AAAA
+// records (addresses), so the caller can compare those against
+// getExpectedAddresses above.
+export type ExternalDnsHostnameResult = {
+  addresses?: string[];
+  error?: string;
+  hostname: string;
+  managed: boolean;
+  ownerId?: string;
+};
+
+export type ExternalDnsLookupResults = Record<string, ExternalDnsHostnameResult>;
+
+// Must match the external-dns-console-plugin's pluginMetadata.name - Console
+// proxies a loaded dynamic plugin's backend routes at /api/plugins/<name>/...
+const LOOKUP_PATH = '/api/plugins/external-dns-console-plugin/api/v1/lookup';
+
+// Sentinel the backend's {resolver} path segment accepts to mean "use your
+// own configured default resolver" - pass a different DoH endpoint URL as
+// `resolver` to override it (e.g. an internal resolver that can see a
+// private/split-horizon zone the public default can't).
+const DEFAULT_RESOLVER = 'default';
+
+// base64url-encodes a UTF-8 string with no padding, matching Go's
+// base64.RawURLEncoding on the backend.
+const toBase64Url = (value: string): string => {
+  const bytes = new TextEncoder().encode(value);
+  let binary = '';
+  bytes.forEach((b) => {
+    binary += String.fromCharCode(b);
+  });
+  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+};
+
+// Checks external-dns registry TXT ownership for a batch of candidate
+// hostnames via the external-dns plugin's backend REST endpoint. The
+// resolver override and hostname list both travel as trailing path
+// segments, not query params or a POST body: Console's bridge proxies
+// /api/plugins/<name>/... requests with a bare GET and drops the original
+// request's query string entirely (pkg/plugins/handlers.go's
+// HandlePluginAssets is built for static assets, not a general API proxy).
+// The hostname list itself is a base64url-encoded JSON string array, not a
+// raw comma-joined string, so it's an explicit, unambiguous payload.
+export const useExternalDnsRecords = (
+  hostnames: string[],
+  resolver: string = DEFAULT_RESOLVER,
+): [ExternalDnsLookupResults, boolean] => {
+  const [results, setResults] = useState<ExternalDnsLookupResults>({});
+  const [loading, setLoading] = useState(false);
+  const key = useMemo(() => Array.from(new Set(hostnames)).sort().join(','), [hostnames]);
+
+  useEffect(() => {
+    if (!key) {
+      setResults({});
+      return undefined;
+    }
+    let cancelled = false;
+    setLoading(true);
+    const payload = toBase64Url(JSON.stringify(key.split(',')));
+    const resolverSegment = encodeURIComponent(resolver || DEFAULT_RESOLVER);
+    consoleFetchJSON(`${LOOKUP_PATH}/${resolverSegment}/${payload}`)
+      .then((res: ExternalDnsLookupResults) => {
+        if (!cancelled) {
+          setResults(res || {});
+        }
+      })
+      .catch(() => {
+        if (!cancelled) {
+          setResults({});
+        }
+      })
+      .finally(() => {
+        if (!cancelled) {
+          setLoading(false);
+        }
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, [key, resolver]);
+
+  return [results, loading];
+};
+
+// Whether the DNS column should render at all - gated on the external-dns
+// plugin actually being installed (EXTERNAL_DNS_FLAG), so this plugin has no
+// hard dependency on it.
+export const useExternalDnsColumnEnabled = (): boolean => !!useFlag(EXTERNAL_DNS_FLAG);
+
+// Combines the flag gate, per-object candidate-hostname computation, and the
+// batched backend lookup into one hook a list page's column data can use
+// directly: hostnamesByUid feeds ExternalDnsCell per row, one shared
+// useExternalDnsRecords call covers the whole page.
+export const useExternalDnsColumnData = <T extends DnsCandidateSource>(
+  objs: T[],
+  getCandidateHostnames: (obj: T) => string[],
+  getExpectedAddresses: (obj: T) => string[] | undefined,
+): {
+  enabled: boolean;
+  expectedAddressesByUid: Map<string, string[]>;
+  hostnamesByUid: Map<string, string[]>;
+  loading: boolean;
+  results: ExternalDnsLookupResults;
+} => {
+  const enabled = useExternalDnsColumnEnabled();
+
+  const hostnamesByUid = useMemo(() => {
+    const map = new Map<string, string[]>();
+    if (enabled) {
+      (objs || []).forEach((obj) => {
+        if (obj.metadata?.uid) {
+          map.set(obj.metadata.uid, getCandidateHostnames(obj));
+        }
+      });
+    }
+    return map;
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [objs, enabled]);
+
+  const expectedAddressesByUid = useMemo(() => {
+    const map = new Map<string, string[]>();
+    if (enabled) {
+      (objs || []).forEach((obj) => {
+        const addrs = obj.metadata?.uid ? getExpectedAddresses(obj) : undefined;
+        if (addrs && obj.metadata?.uid) {
+          map.set(obj.metadata.uid, addrs);
+        }
+      });
+    }
+    return map;
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [objs, enabled]);
+
+  const allHostnames = useMemo(
+    () => Array.from(new Set(Array.from(hostnamesByUid.values()).flat())),
+    [hostnamesByUid],
+  );
+  const [results, loading] = useExternalDnsRecords(allHostnames);
+
+  return { enabled, expectedAddressesByUid, hostnamesByUid, loading, results };
+};
