+import React, { FC, useMemo } from 'react';
+
+import { useK8sModels, useK8sWatchResource } from '@openshift-console/dynamic-plugin-sdk';
+import {
+  DescriptionList as DL,
+  Grid,
+  GridItem,
+  Label,
+  LabelGroup,
+  PageSection,
+} from '@patternfly/react-core';
+import { Table, Tbody, Td, Th, Thead, Tr } from '@patternfly/react-table';
+import { DetailsItem } from '@utils/components/DetailsItem/DetailsItem';
+import DetailsSectionTitle from '@utils/components/DetailsSectionTitle/DetailsSectionTitle';
+import EmptyBox from '@utils/components/EmptyBox/EmptyBox';
+import Loading from '@utils/components/Loading/Loading';
+import ConditionLabels from '@utils/components/ResourceDetails/ConditionLabels';
+import ConditionsSection from '@utils/components/ResourceDetails/ConditionsSection';
+import MetadataSection from '@utils/components/ResourceDetails/MetadataSection';
+import RefLink from '@utils/components/ResourceDetails/RefLink';
+import {
+  findPreferredModel,
+  modelToGroupVersionKind,
+} from '@utils/components/ResourceDetails/utils';
+import { useNetworkingTranslation } from '@utils/hooks/useNetworkingTranslation';
+import { isEmpty } from '@utils/utils';
+import { Gateway, GATEWAY_API_GROUP, GatewayClass } from '@views/gatewayapi/details/utils/types';
+
+const featureName = (feature: { name?: string } | string): string =>
+  typeof feature === 'string' ? feature : feature?.name;
+
+type GatewayClassDetailsTabProps = {
+  obj: GatewayClass;
+};
+
+const GatewayClassDetailsTab: FC<GatewayClassDetailsTabProps> = ({ obj: gatewayClass }) => {
+  const { t } = useNetworkingTranslation();
+  const [models] = useK8sModels();
+  const className = gatewayClass?.metadata?.name;
+
+  const gatewayWatch = useMemo(() => {
+    const groupVersionKind = modelToGroupVersionKind(
+      findPreferredModel(models, GATEWAY_API_GROUP, 'Gateway'),
+    );
+
+    return groupVersionKind ? { groupVersionKind, isList: true } : null;
+  }, [models]);
+
+  const [gateways, gatewaysLoaded] = useK8sWatchResource<Gateway[]>(gatewayWatch);
+
+  const classGateways = useMemo(
+    () =>
+      gatewaysLoaded
+        ? (gateways || []).filter((gateway) => gateway?.spec?.gatewayClassName === className)
+        : [],
+    [className, gateways, gatewaysLoaded],
+  );
+
+  if (!gatewayClass) return <Loading />;
+
+  const supportedFeatures = (gatewayClass?.status?.supportedFeatures || [])
+    .map(featureName)
+    .filter(Boolean);
+
+  return (
+    <>
+      <PageSection>
+        <DetailsSectionTitle titleText={t('{{kind}} details', { kind: gatewayClass?.kind })} />
+        <Grid hasGutter>
+          <GridItem lg={6} sm={12}>
+            <MetadataSection obj={gatewayClass} />
+          </GridItem>
+          <GridItem lg={6} sm={12}>
+            <DL>
+              <DetailsItem label={t('Controller')} obj={gatewayClass} path="spec.controllerName" />
+              <DetailsItem label={t('Description')} obj={gatewayClass} path="spec.description" />
+              {gatewayClass?.spec?.parametersRef && (
+                <DetailsItem label={t('Parameters')} obj={gatewayClass} path="spec.parametersRef">
+                  <RefLink reference={gatewayClass.spec.parametersRef} />
+                </DetailsItem>
+              )}
+              <DetailsItem
+                label={t('Supported features')}
+                obj={gatewayClass}
+                path="status.supportedFeatures"
+              >
+                {isEmpty(supportedFeatures) ? (
+                  '-'
+                ) : (
+                  <LabelGroup numLabels={8}>
+                    {supportedFeatures.map((feature) => (
+                      <Label isCompact key={feature}>
+                        {feature}
+                      </Label>
+                    ))}
+                  </LabelGroup>
+                )}
+              </DetailsItem>
+            </DL>
+          </GridItem>
+        </Grid>
+      </PageSection>
+      <PageSection>
+        <DetailsSectionTitle titleText={t('Gateways')} />
+        <p className="co-m-pane__explanation">{t('The Gateways this class is responsible for.')}</p>
+        {isEmpty(classGateways) ? (
+          <EmptyBox label={t('Gateways')} />
+        ) : (
+          <Table gridBreakPoint="">
+            <Thead>
+              <Tr>
+                <Th>{t('Name')}</Th>
+                <Th visibility={['hidden', 'visibleOnSm']}>{t('Namespace')}</Th>
+                <Th visibility={['hidden', 'visibleOnMd']}>{t('Listeners')}</Th>
+                <Th>{t('Status')}</Th>
+              </Tr>
+            </Thead>
+            <Tbody>
+              {classGateways.map((gateway) => (
+                <Tr key={`${gateway?.metadata?.namespace}/${gateway?.metadata?.name}`}>
+                  <Td>
+                    <RefLink
+                      reference={{
+                        group: GATEWAY_API_GROUP,
+                        kind: 'Gateway',
+                        name: gateway?.metadata?.name,
+                        namespace: gateway?.metadata?.namespace,
+                      }}
+                    />
+                  </Td>
+                  <Td visibility={['hidden', 'visibleOnSm']}>{gateway?.metadata?.namespace}</Td>
+                  <Td visibility={['hidden', 'visibleOnMd']}>
+                    {(gateway?.spec?.listeners || []).length}
+                  </Td>
+                  <Td>
+                    <ConditionLabels conditions={gateway?.status?.conditions} />
+                  </Td>
+                </Tr>
+              ))}
+            </Tbody>
+          </Table>
+        )}
+      </PageSection>
+      <PageSection>
+        <ConditionsSection conditions={gatewayClass?.status?.conditions} />
+      </PageSection>
+    </>
+  );
+};
+
+export default GatewayClassDetailsTab;
