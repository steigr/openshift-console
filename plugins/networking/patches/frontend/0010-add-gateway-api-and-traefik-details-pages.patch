index 0000000..abaaf1b
--- /dev/null
+++ b/src/views/traefik/details/tabs/IngressRouteDetailsTab.tsx
@@ -0,0 +1,137 @@
+import React, { FC } from 'react';
+
+import { DescriptionList as DL, Grid, GridItem, PageSection } from '@patternfly/react-core';
+import { DetailsItem } from '@utils/components/DetailsItem/DetailsItem';
+import DetailsSectionTitle from '@utils/components/DetailsSectionTitle/DetailsSectionTitle';
+import Loading from '@utils/components/Loading/Loading';
+import MetadataSection from '@utils/components/ResourceDetails/MetadataSection';
+import RefLink from '@utils/components/ResourceDetails/RefLink';
+import { useNetworkingTranslation } from '@utils/hooks/useNetworkingTranslation';
+import { isEmpty } from '@utils/utils';
+import TraefikRoutesSection from '@views/traefik/details/components/TraefikRoutesSection';
+import { TRAEFIK_GROUP, TraefikIngressRoute } from '@views/traefik/details/utils/types';
+
+type IngressRouteDetailsTabProps = {
+  middlewareKind?: string;
+  obj: TraefikIngressRoute;
+  showMatch?: boolean;
+};
+
+/**
+ * Traefik's own routing object. `entryPoints` play the part Gateway API gives
+ * to `parentRefs` - they name listeners on the Traefik instance rather than a
+ * Kubernetes object - while newer Traefik also accepts real `parentRefs`
+ * pointing at Gateways.
+ */
+const IngressRouteDetailsTab: FC<IngressRouteDetailsTabProps> = ({
+  middlewareKind,
+  obj: ingressRoute,
+  showMatch,
+}) => {
+  const { t } = useNetworkingTranslation();
+
+  if (!ingressRoute) return <Loading />;
+
+  const namespace = ingressRoute?.metadata?.namespace;
+  const entryPoints = ingressRoute?.spec?.entryPoints;
+  const parentRefs = ingressRoute?.spec?.parentRefs;
+  const tls = ingressRoute?.spec?.tls;
+
+  return (
+    <>
+      <PageSection>
+        <DetailsSectionTitle titleText={t('{{kind}} details', { kind: ingressRoute?.kind })} />
+        <Grid hasGutter>
+          <GridItem lg={6} sm={12}>
+            <MetadataSection obj={ingressRoute} />
+          </GridItem>
+          <GridItem lg={6} sm={12}>
+            <DL>
+              <DetailsItem label={t('Entry points')} obj={ingressRoute} path="spec.entryPoints">
+                {isEmpty(entryPoints) ? t('All entry points') : entryPoints.join(', ')}
+              </DetailsItem>
+              <DetailsItem
+                label={t('Ingress class')}
+                obj={ingressRoute}
+                path="spec.ingressClassName"
+              />
+              {!isEmpty(parentRefs) && (
+                <DetailsItem label={t('Parent Gateways')} obj={ingressRoute} path="spec.parentRefs">
+                  {parentRefs.map((parentRef) => (
+                    <RefLink
+                      defaultNamespace={namespace}
+                      key={`${parentRef?.namespace || ''}/${parentRef?.name}`}
+                      reference={{
+                        group: 'gateway.networking.k8s.io',
+                        kind: 'Gateway',
+                        name: parentRef?.name,
+                        namespace: parentRef?.namespace,
+                      }}
+                    />
+                  ))}
+                </DetailsItem>
+              )}
+              {tls && (
+                <>
+                  <DetailsItem
+                    label={t('TLS certificate')}
+                    obj={ingressRoute}
+                    path="spec.tls.secretName"
+                  >
+                    {tls?.secretName ? (
+                      <RefLink
+                        defaultNamespace={namespace}
+                        reference={{ kind: 'Secret', name: tls.secretName }}
+                      />
+                    ) : (
+                      tls?.certResolver || t('Default certificate')
+                    )}
+                  </DetailsItem>
+                  {tls?.options?.name && (
+                    <DetailsItem
+                      label={t('TLS options')}
+                      obj={ingressRoute}
+                      path="spec.tls.options"
+                    >
+                      <RefLink
+                        defaultNamespace={namespace}
+                        reference={{
+                          group: TRAEFIK_GROUP,
+                          kind: 'TLSOption',
+                          name: tls.options.name,
+                          namespace: tls.options.namespace,
+                        }}
+                      />
+                    </DetailsItem>
+                  )}
+                  {tls?.store?.name && (
+                    <DetailsItem label={t('TLS store')} obj={ingressRoute} path="spec.tls.store">
+                      <RefLink
+                        defaultNamespace={namespace}
+                        reference={{
+                          group: TRAEFIK_GROUP,
+                          kind: 'TLSStore',
+                          name: tls.store.name,
+                          namespace: tls.store.namespace,
+                        }}
+                      />
+                    </DetailsItem>
+                  )}
+                </>
+              )}
+            </DL>
+          </GridItem>
+        </Grid>
+      </PageSection>
+      <PageSection>
+        <TraefikRoutesSection
+          ingressRoute={ingressRoute}
+          middlewareKind={middlewareKind}
+          showMatch={showMatch}
+        />
+      </PageSection>
+    </>
+  );
+};
+
+export default IngressRouteDetailsTab;
