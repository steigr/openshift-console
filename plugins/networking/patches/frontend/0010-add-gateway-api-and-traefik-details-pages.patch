@@ -0,0 +1,137 @@
+import React, { FC, useMemo } from 'react';
+
+import { useK8sModels, useK8sWatchResources } from '@openshift-console/dynamic-plugin-sdk';
+import { Table, Tbody, Td, Th, Thead, Tr } from '@patternfly/react-table';
+import DetailsSectionTitle from '@utils/components/DetailsSectionTitle/DetailsSectionTitle';
+import EmptyBox from '@utils/components/EmptyBox/EmptyBox';
+import Loading from '@utils/components/Loading/Loading';
+import ConditionLabels from '@utils/components/ResourceDetails/ConditionLabels';
+import RefLink from '@utils/components/ResourceDetails/RefLink';
+import {
+  findPreferredModel,
+  modelToGroupVersionKind,
+} from '@utils/components/ResourceDetails/utils';
+import { useNetworkingTranslation } from '@utils/hooks/useNetworkingTranslation';
+import { isEmpty } from '@utils/utils';
+import {
+  Gateway,
+  GATEWAY_API_GROUP,
+  GatewayApiRoute,
+  ROUTE_KINDS,
+} from '@views/gatewayapi/details/utils/types';
+import { allParentRefs, findParentStatus } from '@views/gatewayapi/details/utils/utils';
+
+type AttachedRoutesSectionProps = {
+  gateway: Gateway;
+};
+
+/**
+ * The reverse of a route's `parentRefs`: every route, of any kind, that names
+ * this Gateway as a parent. Gateway status only reports a count per listener,
+ * so the routes themselves have to be found by watching them.
+ */
+const AttachedRoutesSection: FC<AttachedRoutesSectionProps> = ({ gateway }) => {
+  const { t } = useNetworkingTranslation();
+  const [models, modelsInFlight] = useK8sModels();
+  const gatewayName = gateway?.metadata?.name;
+  const gatewayNamespace = gateway?.metadata?.namespace;
+
+  const watches = useMemo(
+    () =>
+      Object.fromEntries(
+        ROUTE_KINDS.map((kind) => [
+          kind,
+          modelToGroupVersionKind(findPreferredModel(models, GATEWAY_API_GROUP, kind)),
+        ])
+          .filter(([, groupVersionKind]) => Boolean(groupVersionKind))
+          .map(([kind, groupVersionKind]) => [kind, { groupVersionKind, isList: true }]),
+      ),
+    [models],
+  );
+
+  const watchResults = useK8sWatchResources<{ [key: string]: GatewayApiRoute[] }>(watches);
+
+  // Keyed by kind, because list items do not carry `kind` of their own.
+  const rows = useMemo(
+    () =>
+      Object.entries(watchResults || {}).flatMap(([kind, result]) =>
+        (result?.loaded && !result?.loadError ? result.data || [] : []).flatMap((route) =>
+          allParentRefs(route)
+            .filter(
+              (parentRef) =>
+                parentRef?.kind === 'Gateway' &&
+                parentRef?.name === gatewayName &&
+                parentRef?.namespace === gatewayNamespace,
+            )
+            .map((parentRef) => ({ kind, parentRef, route })),
+        ),
+      ),
+    [gatewayName, gatewayNamespace, watchResults],
+  );
+
+  if (modelsInFlight) return <Loading />;
+
+  return (
+    <>
+      <DetailsSectionTitle titleText={t('Attached routes')} />
+      <p className="co-m-pane__explanation">
+        {t('The routes that name this Gateway as a parent, across all namespaces.')}
+      </p>
+      {isEmpty(rows) ? (
+        <EmptyBox label={t('attached routes')} />
+      ) : (
+        <Table gridBreakPoint="">
+          <Thead>
+            <Tr>
+              <Th>{t('Name')}</Th>
+              <Th visibility={['hidden', 'visibleOnSm']}>{t('Kind')}</Th>
+              <Th visibility={['hidden', 'visibleOnMd']}>{t('Namespace')}</Th>
+              <Th visibility={['hidden', 'visibleOnMd']}>{t('Hostnames')}</Th>
+              <Th visibility={['hidden', 'visibleOnLg']}>{t('Section')}</Th>
+              <Th>{t('Status')}</Th>
+            </Tr>
+          </Thead>
+          <Tbody>
+            {rows.map(({ kind, parentRef, route }) => (
+              <Tr
+                key={`${kind}/${route?.metadata?.namespace}/${route?.metadata?.name}/${
+                  parentRef?.sectionName || ''
+                }`}
+              >
+                <Td>
+                  <RefLink
+                    reference={{
+                      group: GATEWAY_API_GROUP,
+                      kind,
+                      name: route?.metadata?.name,
+                      namespace: route?.metadata?.namespace,
+                    }}
+                  />
+                </Td>
+                <Td visibility={['hidden', 'visibleOnSm']}>{kind}</Td>
+                <Td visibility={['hidden', 'visibleOnMd']}>{route?.metadata?.namespace}</Td>
+                <Td className="co-break-word" visibility={['hidden', 'visibleOnMd']}>
+                  {isEmpty(route?.spec?.hostnames) ? '*' : route.spec.hostnames.join(', ')}
+                </Td>
+                <Td visibility={['hidden', 'visibleOnLg']}>{parentRef?.sectionName || '-'}</Td>
+                <Td>
+                  <ConditionLabels
+                    conditions={
+                      findParentStatus(
+                        route?.status?.parents,
+                        parentRef,
+                        route?.metadata?.namespace,
+                      )?.conditions
+                    }
+                  />
+                </Td>
+              </Tr>
+            ))}
+          </Tbody>
+        </Table>
+      )}
+    </>
+  );
+};
+
+export default AttachedRoutesSection;
