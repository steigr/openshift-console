diff --git a/src/utils/components/ResourceDetails/ConditionLabels.tsx b/src/utils/components/ResourceDetails/ConditionLabels.tsx
new file mode 100644
index 0000000..39ed3eb
--- /dev/null
+++ b/src/utils/components/ResourceDetails/ConditionLabels.tsx
@@ -0,0 +1,75 @@
+import React, { FC, ReactElement } from 'react';
+
+import { Label, LabelGroup, Tooltip } from '@patternfly/react-core';
+import {
+  CheckCircleIcon,
+  ExclamationCircleIcon,
+  OutlinedQuestionCircleIcon,
+} from '@patternfly/react-icons';
+import { useNetworkingTranslation } from '@utils/hooks/useNetworkingTranslation';
+import { isEmpty } from '@utils/utils';
+
+import { ResourceCondition } from './types';
+
+type LabelAppearance = {
+  color: 'green' | 'grey' | 'red';
+  icon: ReactElement;
+};
+
+const appearanceForStatus = (status: string): LabelAppearance => {
+  switch (status) {
+    case 'False':
+      return { color: 'red', icon: <ExclamationCircleIcon /> };
+    case 'True':
+      return { color: 'green', icon: <CheckCircleIcon /> };
+    default:
+      return { color: 'grey', icon: <OutlinedQuestionCircleIcon /> };
+  }
+};
+
+type ConditionLabelsProps = {
+  conditions: ResourceCondition[];
+};
+
+/**
+ * A compact, in-table rendering of a condition list: one label per condition
+ * type, coloured by its status, with reason and message behind a tooltip. Used
+ * where a full conditions table would not fit, e.g. one row per parentRef.
+ */
+const ConditionLabels: FC<ConditionLabelsProps> = ({ conditions }) => {
+  const { t } = useNetworkingTranslation();
+
+  if (isEmpty(conditions)) return <>-</>;
+
+  return (
+    <LabelGroup numLabels={5}>
+      {conditions.map((condition) => {
+        const { color, icon } = appearanceForStatus(condition?.status);
+        const message = condition?.message?.trim();
+
+        return (
+          <Tooltip
+            content={
+              <>
+                <div>
+                  {t('Status')}: {condition?.status || '-'}
+                </div>
+                <div>
+                  {t('Reason')}: {condition?.reason || '-'}
+                </div>
+                {message && <div className="co-pre-line">{message}</div>}
+              </>
+            }
+            key={condition?.type}
+          >
+            <Label color={color} icon={icon} isCompact>
+              {condition?.type}
+            </Label>
+          </Tooltip>
+        );
+      })}
+    </LabelGroup>
+  );
+};
+
+export default ConditionLabels;
