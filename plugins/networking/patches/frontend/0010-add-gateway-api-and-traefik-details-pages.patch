+import React, { FC } from 'react';
+
+import ResourceDetailsPage from '@utils/components/ResourceDetails/ResourceDetailsPage';
+
+import IngressRouteDetailsTab from './tabs/IngressRouteDetailsTab';
+import TraefikServiceDetailsTab from './tabs/TraefikServiceDetailsTab';
+import { TRAEFIK_GROUP } from './utils/types';
+
+/** Props Console passes to a `console.page/resource/details` component. */
+type PageProps = {
+  name: string;
+  namespace?: string;
+};
+
+const HTTPIngressRouteDetailsTab: FC<{ obj: any }> = ({ obj }) => (
+  <IngressRouteDetailsTab obj={obj} showMatch />
+);
+
+const TCPIngressRouteDetailsTab: FC<{ obj: any }> = ({ obj }) => (
+  <IngressRouteDetailsTab middlewareKind="MiddlewareTCP" obj={obj} showMatch />
+);
+
+const UDPIngressRouteDetailsTab: FC<{ obj: any }> = ({ obj }) => (
+  <IngressRouteDetailsTab obj={obj} showMatch={false} />
+);
+
+const traefikDetailsPage =
+  (kind: string, DetailsTab: FC<{ obj: any }>): FC<PageProps> =>
+  ({ name, namespace }) => (
+    <ResourceDetailsPage
+      DetailsTab={DetailsTab}
+      group={TRAEFIK_GROUP}
+      kind={kind}
+      name={name}
+      namespace={namespace}
+    />
+  );
+
+export const IngressRouteDetailsPage = traefikDetailsPage(
+  'IngressRoute',
+  HTTPIngressRouteDetailsTab,
+);
+export const IngressRouteTCPDetailsPage = traefikDetailsPage(
+  'IngressRouteTCP',
+  TCPIngressRouteDetailsTab,
+);
+export const IngressRouteUDPDetailsPage = traefikDetailsPage(
+  'IngressRouteUDP',
+  UDPIngressRouteDetailsTab,
+);
+export const TraefikServiceDetailsPage = traefikDetailsPage(
+  'TraefikService',
+  TraefikServiceDetailsTab,
+);
diff --git a/src/views/traefik/details/tabs/IngressRouteDetailsTab.tsx b/src/views/traefik/details/tabs/IngressRouteDetailsTab.tsx
