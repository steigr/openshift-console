index 0000000..ead792c
--- /dev/null
+++ b/src/views/gatewayapi/details/utils/utils.ts
@@ -0,0 +1,111 @@
+import { ObjectRef, ResourceCondition } from '@utils/components/ResourceDetails/types';
+import { isSameRef } from '@utils/components/ResourceDetails/utils';
+import { t } from '@utils/hooks/useNetworkingTranslation';
+import { isEmpty } from '@utils/utils';
+
+import {
+  GATEWAY_API_GROUP,
+  GatewayApiRoute,
+  HTTPHeaderMatch,
+  RouteFilter,
+  RouteMatch,
+  RouteParentStatus,
+} from './types';
+
+/** A `parentRef` defaults to a Gateway in the route's own namespace. */
+export const normalizeParentRef = (ref: ObjectRef, routeNamespace: string): ObjectRef => ({
+  ...ref,
+  group: ref?.group ?? GATEWAY_API_GROUP,
+  kind: ref?.kind || 'Gateway',
+  namespace: ref?.namespace || routeNamespace,
+});
+
+/** A `backendRef` defaults to a core Service in the route's own namespace. */
+export const normalizeBackendRef = (ref: ObjectRef, routeNamespace: string): ObjectRef => ({
+  ...ref,
+  group: ref?.group ?? '',
+  kind: ref?.kind || 'Service',
+  namespace: ref?.namespace || routeNamespace,
+});
+
+/**
+ * The controller writes one `status.parents[]` entry per parentRef it accepted.
+ * Match it back to the spec entry so each row can show its own conditions.
+ */
+export const findParentStatus = (
+  parents: RouteParentStatus[],
+  ref: ObjectRef,
+  routeNamespace: string,
+): RouteParentStatus =>
+  (parents || []).find((parent) =>
+    isSameRef(
+      normalizeParentRef(parent?.parentRef, routeNamespace),
+      normalizeParentRef(ref, routeNamespace),
+      routeNamespace,
+    ),
+  );
+
+/**
+ * Every parentRef worth a row: the ones the route asks for, plus any the
+ * controller reported back that the spec no longer lists.
+ */
+export const allParentRefs = (route: GatewayApiRoute): ObjectRef[] => {
+  const routeNamespace = route?.metadata?.namespace;
+  const specRefs = (route?.spec?.parentRefs || []).map((ref) =>
+    normalizeParentRef(ref, routeNamespace),
+  );
+  const statusRefs = (route?.status?.parents || [])
+    .map((parent) => normalizeParentRef(parent?.parentRef, routeNamespace))
+    .filter(
+      (statusRef) =>
+        statusRef?.name &&
+        !specRefs.some((specRef) => isSameRef(specRef, statusRef, routeNamespace)),
+    );
+
+  return [...specRefs, ...statusRefs];
+};
+
+const headerMatchLabel = (header: HTTPHeaderMatch): string =>
+  `${header?.name}${header?.type === 'RegularExpression' ? ' =~ ' : '='}${header?.value}`;
+
+/** A one-line-per-entry summary of a rule's match conditions. */
+export const describeMatch = (match: RouteMatch): string[] => {
+  const parts: string[] = [];
+
+  if (match?.path?.value) {
+    parts.push(`${match.path.type || 'PathPrefix'}: ${match.path.value}`);
+  }
+
+  if (typeof match?.method === 'string') {
+    parts.push(match.method);
+  } else if (match?.method) {
+    // GRPCRoute matches a service/method pair rather than an HTTP verb.
+    parts.push(`${match.method.service || '*'}/${match.method.method || '*'}`);
+  }
+
+  (match?.headers || []).forEach((header) =>
+    parts.push(
+      t('Header {{match}}', {
+        match: headerMatchLabel(header),
+      }),
+    ),
+  );
+
+  (match?.queryParams || []).forEach((param) =>
+    parts.push(
+      t('Query {{match}}', {
+        match: headerMatchLabel(param),
+      }),
+    ),
+  );
+
+  return isEmpty(parts) ? [t('Any')] : parts;
+};
+
+/** The reference a filter points at, if it points at an object at all. */
+export const filterRef = (filter: RouteFilter): ObjectRef =>
+  filter?.extensionRef || filter?.requestMirror?.backendRef;
+
+/** `True`/`False`/`Unknown` for a condition type, or undefined when absent. */
+export const conditionStatus = (conditions: ResourceCondition[], type: string): string =>
+  (conditions || []).find((condition) => condition?.type === type)?.status;
