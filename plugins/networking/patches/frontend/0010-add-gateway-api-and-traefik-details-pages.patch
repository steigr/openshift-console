+            <MetadataSection obj={gateway} />
+          </GridItem>
+          <GridItem lg={6} sm={12}>
+            <DL>
+              <DetailsItem label={t('Gateway class')} obj={gateway} path="spec.gatewayClassName">
+                <RefLink
+                  reference={{
+                    group: GATEWAY_API_GROUP,
+                    kind: 'GatewayClass',
+                    name: gateway?.spec?.gatewayClassName,
+                  }}
+                />
+              </DetailsItem>
+              <DetailsItem label={t('Addresses')} obj={gateway} path="status.addresses">
+                {isEmpty(addresses) ? (
+                  '-'
+                ) : (
+                  <ul className="pf-v6-u-p-0">
+                    {addresses.map((address) => (
+                      <li key={`${address?.type}/${address?.value}`}>
+                        {address?.value}
+                        {address?.type && ` (${address.type})`}
+                      </li>
+                    ))}
+                  </ul>
+                )}
+              </DetailsItem>
+              <DetailsItem label={t('Listeners')} obj={gateway} path="spec.listeners">
+                {(gateway?.spec?.listeners || []).length}
+              </DetailsItem>
+              {parametersRef && (
+                <DetailsItem
+                  label={t('Infrastructure parameters')}
+                  obj={gateway}
+                  path="spec.infrastructure.parametersRef"
+                >
+                  <RefLink
+                    defaultNamespace={gateway?.metadata?.namespace}
+                    reference={parametersRef}
+                  />
+                </DetailsItem>
+              )}
+            </DL>
+          </GridItem>
+        </Grid>
+      </PageSection>
+      <PageSection>
+        <ListenersSection gateway={gateway} />
+      </PageSection>
+      <PageSection>
+        <AttachedRoutesSection gateway={gateway} />
+      </PageSection>
+      <PageSection>
