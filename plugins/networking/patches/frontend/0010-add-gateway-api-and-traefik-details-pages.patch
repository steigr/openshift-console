@@ -0,0 +1,101 @@
+import React, { FC, ReactNode } from 'react';
+
+import { NamespaceModel } from '@kubevirt-ui/kubevirt-api/console';
+import {
+  getGroupVersionKindForModel,
+  getGroupVersionKindForResource,
+  K8sResourceKind,
+  ResourceLink,
+  Timestamp,
+  useAccessReview,
+  useAnnotationsModal,
+  useK8sModel,
+  useLabelsModal,
+} from '@openshift-console/dynamic-plugin-sdk';
+import { DescriptionList as DL } from '@patternfly/react-core';
+import { DetailsItem } from '@utils/components/DetailsItem/DetailsItem';
+import { LabelList } from '@utils/components/DetailsItem/LabelList';
+import { OwnerReferences } from '@utils/components/OwnerReference/owner-references';
+import { useNetworkingTranslation } from '@utils/hooks/useNetworkingTranslation';
+import {
+  getAnnotations,
+  getCreationTimestamp,
+  getLabels,
+  getName,
+  getNamespace,
+} from '@utils/resources/shared';
+
+type MetadataSectionProps = {
+  /** Extra items appended after `Annotations` and before `Created at`. */
+  children?: ReactNode;
+  obj: K8sResourceKind;
+};
+
+/**
+ * The `Name`/`Namespace`/`Labels`/`Annotations`/`Created at`/`Owner` block
+ * Console renders for every resource, driven by the model discovered for the
+ * object itself rather than by a hardcoded one, so it works for any CRD.
+ */
+const MetadataSection: FC<MetadataSectionProps> = ({ children, obj }) => {
+  const { t } = useNetworkingTranslation();
+  const annotationsModalLauncher = useAnnotationsModal(obj);
+  const labelsModalLauncher = useLabelsModal(obj);
+  const [model] = useK8sModel(obj ? getGroupVersionKindForResource(obj) : '');
+  const namespace = getNamespace(obj);
+
+  const [canUpdate] = useAccessReview({
+    group: model?.apiGroup,
+    name: getName(obj),
+    namespace,
+    resource: model?.plural,
+    verb: 'patch',
+  });
+
+  return (
+    <DL>
+      <DetailsItem label={t('Name')} obj={obj} path="metadata.name" />
+      {namespace && (
+        <DetailsItem label={t('Namespace')} obj={obj} path="metadata.namespace">
+          <ResourceLink
+            groupVersionKind={getGroupVersionKindForModel(NamespaceModel)}
+            name={namespace}
+          />
+        </DetailsItem>
+      )}
+      <DetailsItem
+        canEdit={canUpdate}
+        editAsGroup
+        label={t('Labels')}
+        obj={obj}
+        onEdit={labelsModalLauncher}
+        path="metadata.labels"
+        valueClassName="co-editable-label-group"
+      >
+        <LabelList
+          groupVersionKind={model && getGroupVersionKindForModel(model)}
+          labels={getLabels(obj)}
+        />
+      </DetailsItem>
+      <DetailsItem
+        canEdit={canUpdate}
+        label={t('Annotations')}
+        obj={obj}
+        onEdit={annotationsModalLauncher}
+        path="metadata.annotations"
+      >
+        {t('{{count}} annotation', {
+          count: Object.keys(getAnnotations(obj, {})).length,
+        })}
+      </DetailsItem>
+      {children}
+      <DetailsItem label={t('Created at')} obj={obj} path="metadata.creationTimestamp">
+        <Timestamp timestamp={getCreationTimestamp(obj)} />
+      </DetailsItem>
+      <DetailsItem label={t('Owner')} obj={obj} path="metadata.ownerReferences">
+        <OwnerReferences resource={obj} />
+      </DetailsItem>
+    </DL>
+  );
+};
+
+export default MetadataSection;
diff --git a/src/utils/components/ResourceDetails/RefLink.tsx b/src/utils/components/ResourceDetails/RefLink.tsx
new file mode 100644
index 0000000..ab993cd
--- /dev/null
+++ b/src/utils/components/ResourceDetails/RefLink.tsx
@@ -0,0 +1,65 @@
+import React, { FC, useMemo } from 'react';
+
+import {
+  K8sGroupVersionKind,
+  ResourceLink,
+  useK8sModels,
+} from '@openshift-console/dynamic-plugin-sdk';
+
+import { ObjectRef } from './types';
+import { findPreferredModel, modelToGroupVersionKind } from './utils';
+
+/**
+ * Resolve the group/version/kind for a reference that only carries group and
+ * kind (which is all Gateway API and Traefik references ever carry).
+ */
+export const useRefGroupVersionKind = (group: string, kind: string): K8sGroupVersionKind => {
+  const [models] = useK8sModels();
+
+  return useMemo(
+    () => modelToGroupVersionKind(findPreferredModel(models, group, kind)),
+    [group, kind, models],
+  );
+};
+
+type RefLinkProps = {
+  /** Group to assume when the reference omits one. Gateway API defaults to `""` (core). */
+  defaultGroup?: string;
+  /** Kind to assume when the reference omits one, e.g. `Service` for a backendRef. */
+  defaultKind?: string;
+  /** Namespace to assume when the reference omits one - usually the owning object's. */
+  defaultNamespace?: string;
+  reference: ObjectRef;
+};
+
+/**
+ * A ResourceLink for a Gateway API style reference. Falls back to plain text
+ * when Console has no model for the referenced kind, which happens whenever a
+ * reference points at a CRD that is not installed (or not readable).
+ */
+const RefLink: FC<RefLinkProps> = ({
+  defaultGroup = '',
+  defaultKind,
+  defaultNamespace,
+  reference,
+}) => {
+  const group = reference?.group ?? defaultGroup;
+  const kind = reference?.kind || defaultKind;
+  const groupVersionKind = useRefGroupVersionKind(group, kind);
+
+  if (!reference?.name) return <>-</>;
+
+  if (!groupVersionKind) {
+    return <>{kind ? `${kind}/${reference.name}` : reference.name}</>;
+  }
+
+  return (
+    <ResourceLink
+      groupVersionKind={groupVersionKind}
+      name={reference.name}
+      namespace={reference.namespace || defaultNamespace}
+    />
+  );
+};
+
+export default RefLink;
diff --git a/src/utils/components/ResourceDetails/ResourceDetailsPage.tsx b/src/utils/components/ResourceDetails/ResourceDetailsPage.tsx
new file mode 100644
index 0000000..73464ea
--- /dev/null
+++ b/src/utils/components/ResourceDetails/ResourceDetailsPage.tsx
@@ -0,0 +1,174 @@
+import React, { ComponentType, FC, Suspense, useMemo } from 'react';
+import { useLocation } from 'react-router';
+
+import {
+  HorizontalNav,
+  K8sGroupVersionKind,
+  K8sModel,
+  K8sResourceKind,
+  ResourceYAMLEditor,
+  useK8sModel,
+  useK8sModels,
+  useK8sWatchResource,
+} from '@openshift-console/dynamic-plugin-sdk';
+import { Title } from '@patternfly/react-core';
+import ActionsDropdown from '@utils/components/ActionsDropdown/ActionsDropdown';
+import DetailsPageTitle from '@utils/components/DetailsPageTitle/DetailsPageTitle';
+import Loading from '@utils/components/Loading/Loading';
+import StatusBox from '@utils/components/StatusBox/StatusBox';
+import { useLastNamespacePath } from '@utils/hooks/useLastNamespacePath';
+import { useNetworkingTranslation } from '@utils/hooks/useNetworkingTranslation';
+import { getName } from '@utils/resources/shared';
+
+import useResourceActions from './useResourceActions';
+import { findPreferredModel, modelToGroupVersionKind } from './utils';
+
+/** Props `HorizontalNav` passes down to every page it renders. */
+export type ResourceDetailsTabProps = {
+  obj: K8sResourceKind;
+};
+
+const ResourceYAMLTab: FC<ResourceDetailsTabProps> = ({ obj }) => {
+  if (!obj) return <Loading />;
+
+  return (
+    <Suspense fallback={<Loading />}>
+      <ResourceYAMLEditor initialResource={obj} />
+    </Suspense>
+  );
+};
+
+/**
+ * The `group~version~kind` Console put in the URL, for the group/kind this page
+ * is registered for.
+ *
+ * It matters which *version* the page watches: other plugins attach their tabs
+ * with `console.tab/horizontalNav`, which Console matches against the watched
+ * object's own apiVersion. Watching a version other than the one the user
+ * navigated to would silently drop those tabs - the cert-manager `Certificate`
+ * tab on a `v1alpha2` TLSRoute, say.
+ */
+const useUrlGroupVersionKind = (group: string, kind: string): K8sGroupVersionKind => {
+  const { pathname } = useLocation();
+
+  return useMemo(() => {
+    const reference = pathname.split('/').find((segment) => segment.includes('~'));
+    const [urlGroup, urlVersion, urlKind] = (reference || '').split('~');
+
+    if (urlKind !== kind || (urlGroup || '') !== (group || '') || !urlVersion) return null;
+
+    return { group: urlGroup || undefined, kind: urlKind, version: urlVersion };
+  }, [group, kind, pathname]);
+};
+
+type ResourceDetailsPageTitleProps = {
+  model: K8sModel;
+  obj: K8sResourceKind;
+};
+
+const ResourceDetailsPageTitle: FC<ResourceDetailsPageTitleProps> = ({ model, obj }) => {
+  const { t } = useNetworkingTranslation();
+  const namespacePath = useLastNamespacePath();
+  const [actions] = useResourceActions(model, obj);
+
+  const reference = [model?.apiGroup, model?.apiVersion, model?.kind].filter(Boolean).join('~');
+  const listPath = model?.namespaced
+    ? `/k8s/${namespacePath}/${reference}`
+    : `/k8s/cluster/${reference}`;
+
+  return (
+    <DetailsPageTitle
+      breadcrumbs={[
+        { name: model?.labelPlural || model?.kind, to: listPath },
+        { name: t('{{kind}} details', { kind: model?.kind }) },
+      ]}
+    >
+      <Title className="co-resource-item__resource-name" headingLevel="h1">
+        <span className="co-m-resource-icon co-m-resource-icon--lg">{model?.abbr}</span>
+        {getName(obj)}
+      </Title>
+      <ActionsDropdown actions={actions} id="resource-actions" />
+    </DetailsPageTitle>
+  );
+};
+
+type ResourceDetailsPageProps = {
+  /** Body of the `Details` tab. `HorizontalNav` hands it the watched object. */
+  DetailsTab: ComponentType<ResourceDetailsTabProps>;
+  group: string;
+  kind: string;
+  name: string;
+  namespace?: string;
+};
+
+/**
+ * A details page for a resource Console only knows through API discovery.
+ *
+ * The page is registered per served api version - Console matches a
+ * `console.page/resource/details` extension against the exact
+ * `group~version~kind` in the URL - and watches the version the URL names, so a
+ * CRD that still serves `v1alpha2` next to `v1` behaves the same either way.
+ * When the URL carries no reference the preferred version stands in.
+ *
+ * Tabs contributed by other plugins through `console.tab/horizontalNav` - the
+ * cert-manager `Certificate` tab and the external-dns `DNS Settings` tab, for
+ * these kinds - are merged in by `HorizontalNav` itself.
+ */
+const ResourceDetailsPage: FC<ResourceDetailsPageProps> = ({
+  DetailsTab,
+  group,
+  kind,
+  name,
+  namespace,
+}) => {
+  const { t } = useNetworkingTranslation();
+  const [models, modelsInFlight] = useK8sModels();
+  const urlGroupVersionKind = useUrlGroupVersionKind(group, kind);
+
+  const groupVersionKind = useMemo(
+    () => urlGroupVersionKind || modelToGroupVersionKind(findPreferredModel(models, group, kind)),
+    [group, kind, models, urlGroupVersionKind],
+  );
+
+  const [model] = useK8sModel(groupVersionKind || '');
+
+  const watchResource = useMemo(
+    () =>
+      groupVersionKind && model
+        ? {
+            groupVersionKind,
+            name,
+            namespace: model.namespaced ? namespace : undefined,
+          }
+        : null,
+    [groupVersionKind, model, name, namespace],
+  );
+
+  const [obj, loaded, error] = useK8sWatchResource<K8sResourceKind>(watchResource);
+
+  const pages = useMemo(
+    () => [
+      { component: DetailsTab, href: '', name: t('Details') },
+      { component: ResourceYAMLTab, href: 'yaml', name: t('YAML') },
+    ],
+    [DetailsTab, t],
+  );
+
+  if (!model) {
+    return (
+      <StatusBox
+        error={modelsInFlight ? null : { message: t('No model found for {{kind}}', { kind }) }}
+        loaded={!modelsInFlight}
+      />
+    );
+  }
+
+  return (
+    <StatusBox error={error} loaded={loaded}>
+      <ResourceDetailsPageTitle model={model} obj={obj} />
+      <HorizontalNav pages={pages} resource={obj} />
+    </StatusBox>
+  );
+};
+
+export default ResourceDetailsPage;
diff --git a/src/utils/components/ResourceDetails/types.ts b/src/utils/components/ResourceDetails/types.ts
new file mode 100644
index 0000000..b70877b
--- /dev/null
+++ b/src/utils/components/ResourceDetails/types.ts
@@ -0,0 +1,30 @@
+/**
+ * Types shared by the generic (CRD backed) details pages: Gateway API and
+ * Traefik resources describe their relations with the same handful of shapes.
+ */
+
+/** A `metav1.Condition` as reported by Gateway API status subresources. */
+export type ResourceCondition = {
+  lastTransitionTime?: string;
+  message?: string;
+  observedGeneration?: number;
+  reason?: string;
+  status?: string;
+  type?: string;
+};
+
+/**
+ * A reference to another object. Gateway API spells this out in several
+ * flavours (`ParentReference`, `BackendRef`, `SecretObjectReference`,
+ * `LocalPolicyTargetReference`, ...) which all share group/kind/name and add
+ * optional namespace/section/port/weight on top.
+ */
+export type ObjectRef = {
+  group?: string;
+  kind?: string;
+  name?: string;
+  namespace?: string;
+  port?: number;
+  sectionName?: string;
+  weight?: number;
+};
diff --git a/src/utils/components/ResourceDetails/useResourceActions.ts b/src/utils/components/ResourceDetails/useResourceActions.ts
new file mode 100644
index 0000000..f23633b
--- /dev/null
+++ b/src/utils/components/ResourceDetails/useResourceActions.ts
@@ -0,0 +1,60 @@
+import { useNavigate } from 'react-router';
+
+import {
+  Action,
+  K8sModel,
+  K8sResourceKind,
+  useActiveNamespace,
+  useAnnotationsModal,
+  useDeleteModal,
+  useLabelsModal,
+} from '@openshift-console/dynamic-plugin-sdk';
+import { useNetworkingTranslation } from '@utils/hooks/useNetworkingTranslation';
+import { asAccessReview, getResourceURL } from '@utils/resources/shared';
+
+/**
+ * The actions Console offers on any resource - edit labels/annotations, edit
+ * YAML, delete - built from the discovered model so the same hook serves every
+ * CRD backed details page.
+ */
+const useResourceActions = (model: K8sModel, obj: K8sResourceKind): [actions: Action[]] => {
+  const { t } = useNetworkingTranslation();
+  const [activeNamespace] = useActiveNamespace();
+  const navigate = useNavigate();
+  const launchDeleteModal = useDeleteModal(obj);
+  const launchLabelsModal = useLabelsModal(obj);
+  const launchAnnotationsModal = useAnnotationsModal(obj);
+
+  const kind = model?.kind;
+
+  const actions: Action[] = [
+    {
+      accessReview: asAccessReview(model, obj, 'update'),
+      cta: launchLabelsModal,
+      id: 'edit-labels',
+      label: t('Edit labels'),
+    },
+    {
+      accessReview: asAccessReview(model, obj, 'update'),
+      cta: launchAnnotationsModal,
+      id: 'edit-annotations',
+      label: t('Edit annotations'),
+    },
+    {
+      accessReview: asAccessReview(model, obj, 'update'),
+      cta: () => navigate(getResourceURL({ activeNamespace, model, path: 'yaml', resource: obj })),
+      id: 'edit-resource',
+      label: t('Edit {{kind}}', { kind }),
+    },
+    {
+      accessReview: asAccessReview(model, obj, 'delete'),
+      cta: launchDeleteModal,
+      id: 'delete-resource',
+      label: t('Delete {{kind}}', { kind }),
