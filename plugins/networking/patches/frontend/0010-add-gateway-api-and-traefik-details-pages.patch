@@ -0,0 +1,61 @@
+import { K8sResourceCommon } from '@openshift-console/dynamic-plugin-sdk';
+
+export const TRAEFIK_GROUP = 'traefik.io';
+
+/**
+ * A service reference inside an IngressRoute or TraefikService. `kind`
+ * defaults to `Service`; Traefik also allows `TraefikService`, which is how
+ * weighted and mirrored backends are chained together.
+ */
+export type TraefikServiceRef = {
+  kind?: string;
+  middlewares?: TraefikMiddlewareRef[];
+  name?: string;
+  namespace?: string;
+  percent?: number;
+  port?: number | string;
+  scheme?: string;
+  serversTransport?: string;
+  strategy?: string;
+  weight?: number;
+};
+
+export type TraefikMiddlewareRef = {
+  name?: string;
+  namespace?: string;
+};
+
+export type TraefikRoute = {
+  kind?: string;
+  match?: string;
+  middlewares?: TraefikMiddlewareRef[];
+  priority?: number;
+  services?: TraefikServiceRef[];
+  syntax?: string;
+};
+
+export type TraefikTls = {
+  certResolver?: string;
+  domains?: { main?: string; sans?: string[] }[];
+  options?: TraefikMiddlewareRef;
+  passthrough?: boolean;
+  secretName?: string;
+  store?: TraefikMiddlewareRef;
+};
+
+export type TraefikIngressRoute = {
+  spec?: {
+    entryPoints?: string[];
+    ingressClassName?: string;
+    parentRefs?: TraefikMiddlewareRef[];
+    routes?: TraefikRoute[];
+    tls?: TraefikTls;
+  };
+} & K8sResourceCommon;
+
+export type TraefikService = {
+  spec?: {
+    mirroring?: { mirrors?: TraefikServiceRef[] } & TraefikServiceRef;
+    weighted?: { services?: TraefikServiceRef[] };
+  };
+} & K8sResourceCommon;
