+    : gateway?.status?.addresses;
+  const parametersRef = gateway?.spec?.infrastructure?.parametersRef;
+
+  return (
+    <>
+      <PageSection>
+        <DetailsSectionTitle titleText={t('{{kind}} details', { kind: gateway?.kind })} />
