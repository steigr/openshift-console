+import React, { FC } from 'react';
+
+import ResourceDetailsPage from '@utils/components/ResourceDetails/ResourceDetailsPage';
+
+import BackendTLSPolicyDetailsTab from './tabs/BackendTLSPolicyDetailsTab';
+import GatewayClassDetailsTab from './tabs/GatewayClassDetailsTab';
+import GatewayDetailsTab from './tabs/GatewayDetailsTab';
+import ReferenceGrantDetailsTab from './tabs/ReferenceGrantDetailsTab';
+import RouteDetailsTab from './tabs/RouteDetailsTab';
+import { GATEWAY_API_GROUP } from './utils/types';
+
+/** Props Console passes to a `console.page/resource/details` component. */
+type PageProps = {
+  name: string;
+  namespace?: string;
+};
+
+const L7RouteDetailsTab: FC<{ obj: any }> = ({ obj }) => <RouteDetailsTab obj={obj} showMatches />;
+
+const L4RouteDetailsTab: FC<{ obj: any }> = ({ obj }) => <RouteDetailsTab obj={obj} />;
+
+const gatewayApiDetailsPage =
+  (kind: string, DetailsTab: FC<{ obj: any }>): FC<PageProps> =>
+  ({ name, namespace }) => (
+    <ResourceDetailsPage
+      DetailsTab={DetailsTab}
+      group={GATEWAY_API_GROUP}
+      kind={kind}
+      name={name}
+      namespace={namespace}
