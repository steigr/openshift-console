+import React, { FC } from 'react';
+
+import { Table, Tbody, Td, Th, Thead, Tr } from '@patternfly/react-table';
+import DetailsSectionTitle from '@utils/components/DetailsSectionTitle/DetailsSectionTitle';
+import EmptyBox from '@utils/components/EmptyBox/EmptyBox';
+import ConditionLabels from '@utils/components/ResourceDetails/ConditionLabels';
+import RefLink from '@utils/components/ResourceDetails/RefLink';
+import { refKindLabel } from '@utils/components/ResourceDetails/utils';
+import { useNetworkingTranslation } from '@utils/hooks/useNetworkingTranslation';
+import { isEmpty } from '@utils/utils';
+import { GatewayApiRoute } from '@views/gatewayapi/details/utils/types';
+import { allParentRefs, findParentStatus } from '@views/gatewayapi/details/utils/utils';
+
+type ParentRefsSectionProps = {
+  route: GatewayApiRoute;
+};
+
+/**
+ * `spec.parentRefs`: the Gateways (or other parents) this route attaches to,
+ * paired with the matching `status.parents[]` entry so the row also shows
+ * whether the controller accepted the attachment and resolved its references.
+ */
+const ParentRefsSection: FC<ParentRefsSectionProps> = ({ route }) => {
+  const { t } = useNetworkingTranslation();
+  const routeNamespace = route?.metadata?.namespace;
+  const parentRefs = allParentRefs(route);
+
+  return (
+    <>
+      <DetailsSectionTitle titleText={t('Parent references')} />
+      <p className="co-m-pane__explanation">
+        {t(
+          'The Gateways this route attaches to. A route is only served once a parent accepts it and resolves every reference it makes.',
+        )}
+      </p>
+      {isEmpty(parentRefs) ? (
+        <EmptyBox label={t('parent references')} />
+      ) : (
+        <Table gridBreakPoint="">
+          <Thead>
+            <Tr>
+              <Th>{t('Name')}</Th>
+              <Th visibility={['hidden', 'visibleOnMd']}>{t('Kind')}</Th>
+              <Th visibility={['hidden', 'visibleOnMd']}>{t('Namespace')}</Th>
+              <Th visibility={['hidden', 'visibleOnSm']}>{t('Section')}</Th>
+              <Th visibility={['hidden', 'visibleOnLg']}>{t('Port')}</Th>
+              <Th>{t('Status')}</Th>
+              <Th visibility={['hidden', 'visibleOnLg']}>{t('Controller')}</Th>
+            </Tr>
+          </Thead>
+          <Tbody>
+            {parentRefs.map((parentRef) => {
+              const parentStatus = findParentStatus(
+                route?.status?.parents,
+                parentRef,
+                routeNamespace,
+              );
+
+              return (
+                <Tr key={`${parentRef.namespace}/${parentRef.name}/${parentRef.sectionName || ''}`}>
+                  <Td>
+                    <RefLink reference={parentRef} />
+                  </Td>
+                  <Td visibility={['hidden', 'visibleOnMd']}>{refKindLabel(parentRef)}</Td>
+                  <Td visibility={['hidden', 'visibleOnMd']}>{parentRef.namespace || '-'}</Td>
+                  <Td visibility={['hidden', 'visibleOnSm']}>{parentRef.sectionName || '-'}</Td>
+                  <Td visibility={['hidden', 'visibleOnLg']}>{parentRef.port ?? '-'}</Td>
+                  <Td>
+                    <ConditionLabels conditions={parentStatus?.conditions} />
+                  </Td>
+                  <Td className="co-break-word" visibility={['hidden', 'visibleOnLg']}>
+                    {parentStatus?.controllerName || '-'}
+                  </Td>
+                </Tr>
+              );
+            })}
+          </Tbody>
+        </Table>
+      )}
+    </>
+  );
+};
+
+export default ParentRefsSection;
