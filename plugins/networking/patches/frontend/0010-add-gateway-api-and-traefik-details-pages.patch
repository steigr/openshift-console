+import { K8sResourceCommon } from '@openshift-console/dynamic-plugin-sdk';
+import { ObjectRef, ResourceCondition } from '@utils/components/ResourceDetails/types';
+
+export const GATEWAY_API_GROUP = 'gateway.networking.k8s.io';
+
+/** Route kinds that share the `parentRefs` + `rules[].backendRefs` shape. */
+export const ROUTE_KINDS = ['GRPCRoute', 'HTTPRoute', 'TCPRoute', 'TLSRoute', 'UDPRoute'] as const;
+
+export type RouteKind = (typeof ROUTE_KINDS)[number];
+
+export type RouteFilter = {
+  extensionRef?: ObjectRef;
+  requestMirror?: { backendRef?: ObjectRef };
+  type?: string;
+};
+
+export type RouteBackendRef = {
+  filters?: RouteFilter[];
+} & ObjectRef;
+
+export type HTTPHeaderMatch = {
+  name?: string;
+  type?: string;
+  value?: string;
+};
+
+export type RouteMatch = {
+  headers?: HTTPHeaderMatch[];
+  method?: { method?: string; service?: string } | string;
+  path?: { type?: string; value?: string };
+  queryParams?: HTTPHeaderMatch[];
+};
+
+export type RouteRule = {
+  backendRefs?: RouteBackendRef[];
+  filters?: RouteFilter[];
+  matches?: RouteMatch[];
+  name?: string;
+};
+
+export type RouteParentStatus = {
+  conditions?: ResourceCondition[];
+  controllerName?: string;
+  parentRef?: ObjectRef;
+};
+
+export type GatewayApiRoute = {
+  spec?: {
+    hostnames?: string[];
+    parentRefs?: ObjectRef[];
+    rules?: RouteRule[];
+  };
+  status?: {
+    parents?: RouteParentStatus[];
+  };
+} & K8sResourceCommon;
+
+export type GatewayListener = {
+  allowedRoutes?: {
+    kinds?: ObjectRef[];
+    namespaces?: { from?: string; selector?: { matchLabels?: { [key: string]: string } } };
+  };
+  hostname?: string;
+  name?: string;
+  port?: number;
+  protocol?: string;
+  tls?: {
+    certificateRefs?: ObjectRef[];
+    mode?: string;
+    options?: { [key: string]: string };
+  };
+};
+
+export type GatewayListenerStatus = {
+  attachedRoutes?: number;
+  conditions?: ResourceCondition[];
+  name?: string;
+  supportedKinds?: ObjectRef[];
+};
+
+export type GatewayAddress = {
+  type?: string;
+  value?: string;
+};
+
+export type Gateway = {
+  spec?: {
+    addresses?: GatewayAddress[];
+    gatewayClassName?: string;
+    infrastructure?: { parametersRef?: ObjectRef };
+    listeners?: GatewayListener[];
+  };
+  status?: {
+    addresses?: GatewayAddress[];
+    conditions?: ResourceCondition[];
+    listeners?: GatewayListenerStatus[];
+  };
+} & K8sResourceCommon;
+
+export type GatewayClass = {
+  spec?: {
+    controllerName?: string;
+    description?: string;
+    parametersRef?: ObjectRef;
+  };
+  status?: {
+    conditions?: ResourceCondition[];
+    supportedFeatures?: ({ name?: string } | string)[];
+  };
+} & K8sResourceCommon;
+
+export type ReferenceGrant = {
+  spec?: {
+    from?: ObjectRef[];
+    to?: ObjectRef[];
+  };
+} & K8sResourceCommon;
+
+export type BackendTLSPolicy = {
+  spec?: {
+    targetRefs?: ObjectRef[];
+    validation?: {
+      caCertificateRefs?: ObjectRef[];
+      hostname?: string;
+      subjectAltNames?: { hostname?: string; type?: string; uri?: string }[];
+      wellKnownCACertificates?: string;
+    };
+  };
+  status?: {
+    ancestors?: {
+      ancestorRef?: ObjectRef;
+      conditions?: ResourceCondition[];
+      controllerName?: string;
+    }[];
+  };
+} & K8sResourceCommon;
