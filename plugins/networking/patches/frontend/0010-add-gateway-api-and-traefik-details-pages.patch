@@ -0,0 +1,36 @@
+import React, { FC } from 'react';
+
+import RefLink from '@utils/components/ResourceDetails/RefLink';
+import { TRAEFIK_GROUP, TraefikServiceRef } from '@views/traefik/details/utils/types';
+
+type TraefikServiceRefLinkProps = {
+  namespace: string;
+  reference: TraefikServiceRef;
+};
+
+/**
+ * A backend reference in a Traefik IngressRoute: a core Service unless `kind`
+ * says `TraefikService`, in which case it points into `traefik.io`. Names like
+ * `api@internal` are Traefik's own internal services and have no object.
+ */
+const TraefikServiceRefLink: FC<TraefikServiceRefLinkProps> = ({ namespace, reference }) => {
+  const isTraefikService = reference?.kind === 'TraefikService';
+
+  if (!reference?.name) return <>-</>;
+
+  if (reference.name.includes('@')) return <>{reference.name}</>;
+
+  return (
+    <RefLink
+      defaultNamespace={namespace}
+      reference={{
+        group: isTraefikService ? TRAEFIK_GROUP : '',
+        kind: isTraefikService ? 'TraefikService' : 'Service',
+        name: reference.name,
+        namespace: reference.namespace,
+      }}
+    />
+  );
+};
+
+export default TraefikServiceRefLink;
