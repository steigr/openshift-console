@@ -0,0 +1,151 @@
+import React, { FC } from 'react';
+
+import { Label, LabelGroup } from '@patternfly/react-core';
+import { Table, Tbody, Td, Th, Thead, Tr } from '@patternfly/react-table';
+import DetailsSectionTitle from '@utils/components/DetailsSectionTitle/DetailsSectionTitle';
+import EmptyBox from '@utils/components/EmptyBox/EmptyBox';
+import RefLink from '@utils/components/ResourceDetails/RefLink';
+import { ObjectRef } from '@utils/components/ResourceDetails/types';
+import { refKindLabel } from '@utils/components/ResourceDetails/utils';
+import { useNetworkingTranslation } from '@utils/hooks/useNetworkingTranslation';
+import { isEmpty } from '@utils/utils';
+import { GatewayApiRoute, RouteFilter } from '@views/gatewayapi/details/utils/types';
+import {
+  describeMatch,
+  filterRef,
+  normalizeBackendRef,
+} from '@views/gatewayapi/details/utils/utils';
+
+type BackendRow = {
+  backendRef: ObjectRef;
+  filters: RouteFilter[];
+  key: string;
+  matches: string[];
+  rule: string;
+};
+
+const FiltersCell: FC<{ filters: RouteFilter[]; namespace: string }> = ({ filters, namespace }) => {
+  if (isEmpty(filters)) return <>-</>;
+
+  return (
+    <LabelGroup numLabels={4}>
+      {filters.map((filter, index) => {
+        const reference = filterRef(filter);
+
+        return (
+          <Label isCompact key={`${filter?.type}-${index}`}>
+            {filter?.type}
+            {reference && (
+              <>
+                {': '}
+                <RefLink defaultNamespace={namespace} reference={reference} />
+              </>
+            )}
+          </Label>
+        );
+      })}
+    </LabelGroup>
+  );
+};
+
+type BackendRefsSectionProps = {
+  route: GatewayApiRoute;
+  /** HTTPRoute/GRPCRoute rules match on paths and headers; L4 routes do not. */
+  showMatches?: boolean;
+};
+
+/**
+ * `spec.rules[].backendRefs`: what the route actually forwards traffic to,
+ * the Gateway API counterpart of the Services listed on an Ingress details
+ * page. Rule filters are shown alongside because Traefik attaches its
+ * Middlewares through an `ExtensionRef` filter.
+ */
+const BackendRefsSection: FC<BackendRefsSectionProps> = ({ route, showMatches }) => {
+  const { t } = useNetworkingTranslation();
+  const routeNamespace = route?.metadata?.namespace;
+
+  const rows: BackendRow[] = (route?.spec?.rules || []).flatMap((rule, ruleIndex) => {
+    const ruleName = rule?.name || t('Rule {{index}}', { index: ruleIndex + 1 });
+    const matches = (rule?.matches || []).flatMap(describeMatch);
+    const ruleMatches = isEmpty(matches) ? [t('Any')] : matches;
+
+    // A rule may carry no backend at all - a redirect filter, for instance -
+    // and still deserves a row, or the whole rule would vanish from the page.
+    if (isEmpty(rule?.backendRefs)) {
+      return [
+        {
+          backendRef: null,
+          filters: rule?.filters || [],
+          key: `${ruleIndex}-no-backend`,
+          matches: ruleMatches,
+          rule: ruleName,
+        },
+      ];
+    }
+
+    return rule.backendRefs.map((backendRef, backendIndex) => ({
+      backendRef: normalizeBackendRef(backendRef, routeNamespace),
+      filters: [...(rule?.filters || []), ...(backendRef?.filters || [])],
+      key: `${ruleIndex}-${backendIndex}-${backendRef?.name}`,
+      matches: ruleMatches,
+      rule: ruleName,
+    }));
+  });
+
+  return (
+    <>
+      <DetailsSectionTitle titleText={t('Backend references')} />
+      <p className="co-m-pane__explanation">
+        {t('The resources this route forwards matching traffic to, and how it is weighted.')}
+      </p>
+      {isEmpty(rows) ? (
+        <EmptyBox label={t('backend references')} />
+      ) : (
+        <Table gridBreakPoint="">
+          <Thead>
+            <Tr>
+              <Th>{t('Rule')}</Th>
+              {showMatches && <Th visibility={['hidden', 'visibleOnMd']}>{t('Matches')}</Th>}
+              <Th>{t('Backend')}</Th>
+              <Th visibility={['hidden', 'visibleOnLg']}>{t('Kind')}</Th>
+              <Th visibility={['hidden', 'visibleOnSm']}>{t('Port')}</Th>
+              <Th visibility={['hidden', 'visibleOnMd']}>{t('Weight')}</Th>
+              <Th visibility={['hidden', 'visibleOnLg']}>{t('Filters')}</Th>
+            </Tr>
+          </Thead>
+          <Tbody>
+            {rows.map((row) => (
+              <Tr key={row.key}>
+                <Td>{row.rule}</Td>
+                {showMatches && (
+                  <Td className="co-break-word" visibility={['hidden', 'visibleOnMd']}>
+                    {row.matches.map((match) => (
+                      <div key={match}>{match}</div>
+                    ))}
+                  </Td>
+                )}
+                <Td>
+                  {row.backendRef ? (
+                    <RefLink defaultKind="Service" reference={row.backendRef} />
+                  ) : (
+                    t('No backend')
+                  )}
+                </Td>
+                <Td visibility={['hidden', 'visibleOnLg']}>
+                  {row.backendRef ? refKindLabel(row.backendRef, 'Service') : '-'}
+                </Td>
+                <Td visibility={['hidden', 'visibleOnSm']}>{row.backendRef?.port ?? '-'}</Td>
+                <Td visibility={['hidden', 'visibleOnMd']}>{row.backendRef?.weight ?? '-'}</Td>
+                <Td visibility={['hidden', 'visibleOnLg']}>
+                  <FiltersCell filters={row.filters} namespace={routeNamespace} />
+                </Td>
+              </Tr>
+            ))}
+          </Tbody>
+        </Table>
+      )}
+    </>
+  );
+};
+
+export default BackendRefsSection;
