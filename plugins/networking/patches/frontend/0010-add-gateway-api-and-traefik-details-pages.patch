+import React, { FC } from 'react';
+
+import { Grid, GridItem, PageSection } from '@patternfly/react-core';
+import { Table, Tbody, Td, Th, Thead, Tr } from '@patternfly/react-table';
+import DetailsSectionTitle from '@utils/components/DetailsSectionTitle/DetailsSectionTitle';
+import EmptyBox from '@utils/components/EmptyBox/EmptyBox';
+import Loading from '@utils/components/Loading/Loading';
+import MetadataSection from '@utils/components/ResourceDetails/MetadataSection';
+import RefLink from '@utils/components/ResourceDetails/RefLink';
+import { useNetworkingTranslation } from '@utils/hooks/useNetworkingTranslation';
+import { isEmpty } from '@utils/utils';
+import { ReferenceGrant } from '@views/gatewayapi/details/utils/types';
+
+type ReferenceGrantDetailsTabProps = {
+  obj: ReferenceGrant;
+};
+
+/**
+ * A ReferenceGrant is nothing but two reference lists: who may point into this
+ * namespace, and what they are allowed to point at.
+ */
+const ReferenceGrantDetailsTab: FC<ReferenceGrantDetailsTabProps> = ({ obj: referenceGrant }) => {
+  const { t } = useNetworkingTranslation();
+
+  if (!referenceGrant) return <Loading />;
+
+  const namespace = referenceGrant?.metadata?.namespace;
+  const from = referenceGrant?.spec?.from || [];
+  const to = referenceGrant?.spec?.to || [];
+
+  return (
+    <>
+      <PageSection>
+        <DetailsSectionTitle titleText={t('{{kind}} details', { kind: referenceGrant?.kind })} />
+        <Grid hasGutter>
+          <GridItem lg={6} sm={12}>
+            <MetadataSection obj={referenceGrant} />
+          </GridItem>
+        </Grid>
+      </PageSection>
+      <PageSection>
+        <DetailsSectionTitle titleText={t('Granted from')} />
+        <p className="co-m-pane__explanation">
+          {t('The resources allowed to reference into this namespace.')}
+        </p>
+        {isEmpty(from) ? (
+          <EmptyBox label={t('sources')} />
+        ) : (
+          <Table gridBreakPoint="">
+            <Thead>
+              <Tr>
+                <Th>{t('Kind')}</Th>
+                <Th>{t('Group')}</Th>
+                <Th>{t('Namespace')}</Th>
+              </Tr>
+            </Thead>
+            <Tbody>
+              {from.map((source) => (
+                <Tr key={`${source?.group}/${source?.kind}/${source?.namespace}`}>
+                  <Td>{source?.kind || '-'}</Td>
+                  <Td>{source?.group || t('core')}</Td>
+                  <Td>{source?.namespace || '-'}</Td>
+                </Tr>
+              ))}
+            </Tbody>
+          </Table>
+        )}
+      </PageSection>
+      <PageSection>
+        <DetailsSectionTitle titleText={t('Granted to')} />
+        <p className="co-m-pane__explanation">
+          {t(
+            'The resources in this namespace that may be referenced. A row without a name grants every resource of that kind.',
+          )}
+        </p>
+        {isEmpty(to) ? (
+          <EmptyBox label={t('targets')} />
+        ) : (
+          <Table gridBreakPoint="">
+            <Thead>
+              <Tr>
+                <Th>{t('Name')}</Th>
+                <Th>{t('Kind')}</Th>
+                <Th>{t('Group')}</Th>
+              </Tr>
+            </Thead>
+            <Tbody>
+              {to.map((target) => (
+                <Tr key={`${target?.group}/${target?.kind}/${target?.name || '*'}`}>
+                  <Td>
+                    {target?.name ? (
+                      <RefLink defaultNamespace={namespace} reference={target} />
+                    ) : (
+                      t('All')
+                    )}
+                  </Td>
+                  <Td>{target?.kind || '-'}</Td>
+                  <Td>{target?.group || t('core')}</Td>
+                </Tr>
+              ))}
+            </Tbody>
+          </Table>
+        )}
+      </PageSection>
+    </>
+  );
+};
+
+export default ReferenceGrantDetailsTab;
