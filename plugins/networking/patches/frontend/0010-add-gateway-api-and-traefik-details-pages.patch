+import React, { FC } from 'react';
+
+import { K8sResourceCondition } from '@openshift-console/dynamic-plugin-sdk';
+import DetailsSectionTitle from '@utils/components/DetailsSectionTitle/DetailsSectionTitle';
+import { useNetworkingTranslation } from '@utils/hooks/useNetworkingTranslation';
+import Conditions from '@views/routes/details/components/tabs/detailsTab/components/RouteIngressStatusSection/Conditions';
+
+import { ResourceCondition } from './types';
+
+type ConditionsSectionProps = {
+  conditions: ResourceCondition[];
+  title?: string;
+};
+
+/** `status.conditions` as the table Console uses everywhere else. */
+const ConditionsSection: FC<ConditionsSectionProps> = ({ conditions, title }) => {
+  const { t } = useNetworkingTranslation();
+
+  return (
+    <>
+      <DetailsSectionTitle titleText={title || t('Conditions')} />
+      <Conditions conditions={(conditions || []) as K8sResourceCondition[]} />
+    </>
+  );
+};
+
+export default ConditionsSection;
diff --git a/src/utils/components/ResourceDetails/MetadataSection.tsx b/src/utils/components/ResourceDetails/MetadataSection.tsx
