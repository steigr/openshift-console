+import React, { FC } from 'react';
+
+import { DescriptionList as DL, Grid, GridItem, PageSection } from '@patternfly/react-core';
+import { Table, Tbody, Td, Th, Thead, Tr } from '@patternfly/react-table';
+import { DetailsItem } from '@utils/components/DetailsItem/DetailsItem';
+import DetailsSectionTitle from '@utils/components/DetailsSectionTitle/DetailsSectionTitle';
+import EmptyBox from '@utils/components/EmptyBox/EmptyBox';
+import Loading from '@utils/components/Loading/Loading';
+import ConditionLabels from '@utils/components/ResourceDetails/ConditionLabels';
+import MetadataSection from '@utils/components/ResourceDetails/MetadataSection';
+import RefLink from '@utils/components/ResourceDetails/RefLink';
+import { refKindLabel } from '@utils/components/ResourceDetails/utils';
+import { useNetworkingTranslation } from '@utils/hooks/useNetworkingTranslation';
+import { isEmpty } from '@utils/utils';
+import { BackendTLSPolicy } from '@views/gatewayapi/details/utils/types';
+
+type BackendTLSPolicyDetailsTabProps = {
+  obj: BackendTLSPolicy;
+};
+
+/**
+ * A BackendTLSPolicy points at the backends it secures (`spec.targetRefs`) and
+ * at the CA material it validates them with (`spec.validation`); both are
+ * references worth linking.
+ */
+const BackendTLSPolicyDetailsTab: FC<BackendTLSPolicyDetailsTabProps> = ({ obj: policy }) => {
+  const { t } = useNetworkingTranslation();
+
+  if (!policy) return <Loading />;
+
+  const namespace = policy?.metadata?.namespace;
+  const targetRefs = policy?.spec?.targetRefs || [];
+  const caCertificateRefs = policy?.spec?.validation?.caCertificateRefs || [];
+  const ancestors = policy?.status?.ancestors || [];
+
+  return (
+    <>
+      <PageSection>
+        <DetailsSectionTitle titleText={t('{{kind}} details', { kind: policy?.kind })} />
+        <Grid hasGutter>
+          <GridItem lg={6} sm={12}>
+            <MetadataSection obj={policy} />
+          </GridItem>
+          <GridItem lg={6} sm={12}>
+            <DL>
+              <DetailsItem label={t('Hostname')} obj={policy} path="spec.validation.hostname" />
+              <DetailsItem
+                label={t('Well known CA certificates')}
+                obj={policy}
+                path="spec.validation.wellKnownCACertificates"
+              />
+              <DetailsItem
+                label={t('CA certificates')}
+                obj={policy}
+                path="spec.validation.caCertificateRefs"
+              >
+                {isEmpty(caCertificateRefs)
+                  ? '-'
+                  : caCertificateRefs.map((certificateRef) => (
+                      <RefLink
+                        defaultKind="ConfigMap"
+                        defaultNamespace={namespace}
+                        key={certificateRef?.name}
+                        reference={certificateRef}
+                      />
+                    ))}
+              </DetailsItem>
+            </DL>
+          </GridItem>
+        </Grid>
+      </PageSection>
+      <PageSection>
+        <DetailsSectionTitle titleText={t('Target references')} />
+        <p className="co-m-pane__explanation">{t('The backends this policy applies to.')}</p>
+        {isEmpty(targetRefs) ? (
+          <EmptyBox label={t('target references')} />
+        ) : (
+          <Table gridBreakPoint="">
+            <Thead>
+              <Tr>
+                <Th>{t('Name')}</Th>
+                <Th>{t('Kind')}</Th>
+                <Th visibility={['hidden', 'visibleOnSm']}>{t('Section')}</Th>
+              </Tr>
+            </Thead>
+            <Tbody>
+              {targetRefs.map((targetRef) => (
+                <Tr key={`${targetRef?.kind}/${targetRef?.name}/${targetRef?.sectionName || ''}`}>
+                  <Td>
+                    <RefLink
+                      defaultKind="Service"
+                      defaultNamespace={namespace}
+                      reference={targetRef}
+                    />
+                  </Td>
+                  <Td>{refKindLabel(targetRef, 'Service')}</Td>
+                  <Td visibility={['hidden', 'visibleOnSm']}>{targetRef?.sectionName || '-'}</Td>
+                </Tr>
+              ))}
+            </Tbody>
+          </Table>
+        )}
+      </PageSection>
+      <PageSection>
+        <DetailsSectionTitle titleText={t('Ancestors')} />
+        <p className="co-m-pane__explanation">
+          {t('The Gateways through which a controller reported on this policy.')}
+        </p>
+        {isEmpty(ancestors) ? (
+          <EmptyBox label={t('ancestors')} />
+        ) : (
+          <Table gridBreakPoint="">
+            <Thead>
+              <Tr>
+                <Th>{t('Name')}</Th>
+                <Th visibility={['hidden', 'visibleOnSm']}>{t('Kind')}</Th>
+                <Th>{t('Status')}</Th>
+                <Th visibility={['hidden', 'visibleOnMd']}>{t('Controller')}</Th>
+              </Tr>
+            </Thead>
+            <Tbody>
+              {ancestors.map((ancestor) => (
+                <Tr
+                  key={`${ancestor?.ancestorRef?.namespace}/${ancestor?.ancestorRef?.name}/${ancestor?.controllerName}`}
+                >
+                  <Td>
+                    <RefLink
+                      defaultKind="Gateway"
+                      defaultNamespace={namespace}
+                      reference={ancestor?.ancestorRef}
+                    />
+                  </Td>
+                  <Td visibility={['hidden', 'visibleOnSm']}>
+                    {refKindLabel(ancestor?.ancestorRef, 'Gateway')}
+                  </Td>
+                  <Td>
+                    <ConditionLabels conditions={ancestor?.conditions} />
+                  </Td>
+                  <Td className="co-break-word" visibility={['hidden', 'visibleOnMd']}>
+                    {ancestor?.controllerName || '-'}
+                  </Td>
+                </Tr>
+              ))}
+            </Tbody>
+          </Table>
+        )}
+      </PageSection>
+    </>
+  );
+};
+
+export default BackendTLSPolicyDetailsTab;
