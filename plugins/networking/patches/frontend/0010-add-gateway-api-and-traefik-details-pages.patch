diff --git a/src/utils/components/ResourceDetails/utils.ts b/src/utils/components/ResourceDetails/utils.ts
new file mode 100644
index 0000000..59b72e5
--- /dev/null
+++ b/src/utils/components/ResourceDetails/utils.ts
@@ -0,0 +1,59 @@
+import { K8sGroupVersionKind, K8sModel } from '@openshift-console/dynamic-plugin-sdk';
+
+import { ObjectRef } from './types';
+
+/**
+ * Rank an api version the way the apiserver does when it picks a preferred
+ * version: GA beats beta beats alpha, and within a level the higher number
+ * wins. `v1` -> 3000001, `v1beta2` -> 2000102, `v2alpha1` -> 1000201.
+ */
+export const versionRank = (version: string): number => {
+  const match = /^v(\d+)(?:(alpha|beta)(\d+))?$/.exec(version || '');
+
+  if (!match) return -1;
+
+  const [, major, level, minor] = match;
+  const levelRank = { alpha: 1, beta: 2 }[level] ?? 3;
+
+  return levelRank * 1000000 + Number(major) * 100 + Number(minor || 0);
+};
+
+/**
+ * Find the model Console discovered for a group/kind, preferring the version
+ * the apiserver would prefer. Console registers one model per served
+ * group-version-kind, so a CRD that still serves `v1alpha2` next to `v1` shows
+ * up more than once here.
+ */
+export const findPreferredModel = (
+  models: { [key: string]: K8sModel },
+  group: string,
+  kind: string,
+): K8sModel =>
+  Object.values(models || {})
+    .filter((model) => (model?.apiGroup || '') === (group || '') && model?.kind === kind)
+    .sort((a, b) => versionRank(b?.apiVersion) - versionRank(a?.apiVersion))[0];
+
+export const modelToGroupVersionKind = (model: K8sModel): K8sGroupVersionKind =>
+  model && {
+    group: model.apiGroup || undefined,
+    kind: model.kind,
+    version: model.apiVersion,
+  };
+
+/** `true` when both references point at the same object. */
+export const isSameRef = (a: ObjectRef, b: ObjectRef, defaultNamespace?: string): boolean =>
+  (a?.group || '') === (b?.group || '') &&
+  (a?.kind || '') === (b?.kind || '') &&
+  a?.name === b?.name &&
+  (a?.namespace || defaultNamespace) === (b?.namespace || defaultNamespace) &&
+  (a?.sectionName || '') === (b?.sectionName || '') &&
+  (a?.port ?? null) === (b?.port ?? null);
+
+/** Render a reference as `group/Kind` for tables that show the target's type. */
+export const refKindLabel = (ref: ObjectRef, defaultKind?: string): string => {
+  const kind = ref?.kind || defaultKind;
+
+  if (!kind) return '-';
+
+  return ref?.group ? `${kind} (${ref.group})` : kind;
+};
