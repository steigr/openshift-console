+import React, { FC } from 'react';
+
+import { DescriptionList as DL, Grid, GridItem, PageSection } from '@patternfly/react-core';
+import { DetailsItem } from '@utils/components/DetailsItem/DetailsItem';
+import DetailsSectionTitle from '@utils/components/DetailsSectionTitle/DetailsSectionTitle';
+import Loading from '@utils/components/Loading/Loading';
+import MetadataSection from '@utils/components/ResourceDetails/MetadataSection';
+import { useNetworkingTranslation } from '@utils/hooks/useNetworkingTranslation';
+import { isEmpty } from '@utils/utils';
+import BackendRefsSection from '@views/gatewayapi/details/components/BackendRefsSection';
+import ParentRefsSection from '@views/gatewayapi/details/components/ParentRefsSection';
+import { GatewayApiRoute } from '@views/gatewayapi/details/utils/types';
+
+type RouteDetailsTabProps = {
+  obj: GatewayApiRoute;
+  /** HTTPRoute/GRPCRoute rules match on paths and headers; L4 routes do not. */
+  showMatches?: boolean;
+};
+
+/**
+ * The `Details` tab shared by every Gateway API route kind: the usual metadata
+ * block, then what the route attaches to (`parentRefs`) and what it forwards
+ * to (`rules[].backendRefs`).
+ */
+const RouteDetailsTab: FC<RouteDetailsTabProps> = ({ obj: route, showMatches }) => {
+  const { t } = useNetworkingTranslation();
+
+  if (!route) return <Loading />;
+
+  const hostnames = route?.spec?.hostnames;
+
+  return (
+    <>
+      <PageSection>
+        <DetailsSectionTitle titleText={t('{{kind}} details', { kind: route?.kind })} />
+        <Grid hasGutter>
+          <GridItem lg={6} sm={12}>
+            <MetadataSection obj={route} />
+          </GridItem>
+          <GridItem lg={6} sm={12}>
+            <DL>
+              <DetailsItem label={t('Hostnames')} obj={route} path="spec.hostnames">
+                {isEmpty(hostnames) ? (
+                  t('All hostnames')
+                ) : (
+                  <ul className="pf-v6-u-p-0">
+                    {hostnames.map((hostname) => (
+                      <li key={hostname}>{hostname}</li>
+                    ))}
+                  </ul>
+                )}
+              </DetailsItem>
+              <DetailsItem label={t('Rules')} obj={route} path="spec.rules">
+                {(route?.spec?.rules || []).length}
+              </DetailsItem>
+            </DL>
+          </GridItem>
+        </Grid>
+      </PageSection>
+      <PageSection>
+        <ParentRefsSection route={route} />
+      </PageSection>
+      <PageSection>
+        <BackendRefsSection route={route} showMatches={showMatches} />
+      </PageSection>
+    </>
+  );
+};
+
+export default RouteDetailsTab;
