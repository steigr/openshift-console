+import React, { FC } from 'react';
+
+import { Label, LabelGroup } from '@patternfly/react-core';
+import { Table, Tbody, Td, Th, Thead, Tr } from '@patternfly/react-table';
+import DetailsSectionTitle from '@utils/components/DetailsSectionTitle/DetailsSectionTitle';
+import EmptyBox from '@utils/components/EmptyBox/EmptyBox';
+import ConditionLabels from '@utils/components/ResourceDetails/ConditionLabels';
+import RefLink from '@utils/components/ResourceDetails/RefLink';
+import { useNetworkingTranslation } from '@utils/hooks/useNetworkingTranslation';
+import { isEmpty } from '@utils/utils';
+import { Gateway, GatewayListener } from '@views/gatewayapi/details/utils/types';
+
+const allowedRoutesLabel = (listener: GatewayListener): string => {
+  const from = listener?.allowedRoutes?.namespaces?.from || 'Same';
+  const kinds = (listener?.allowedRoutes?.kinds || []).map((kind) => kind?.kind).filter(Boolean);
+
+  return isEmpty(kinds) ? from : `${from} (${kinds.join(', ')})`;
+};
+
+type ListenersSectionProps = {
+  gateway: Gateway;
+};
+
+/**
+ * `spec.listeners` joined with `status.listeners`: the ports this Gateway
+ * serves, the certificates each terminating listener uses, and how many routes
+ * the controller has attached to it.
+ */
+const ListenersSection: FC<ListenersSectionProps> = ({ gateway }) => {
+  const { t } = useNetworkingTranslation();
+  const gatewayNamespace = gateway?.metadata?.namespace;
+  const listeners = gateway?.spec?.listeners || [];
+
+  return (
+    <>
+      <DetailsSectionTitle titleText={t('Listeners')} />
+      <p className="co-m-pane__explanation">
+        {t('The ports this Gateway serves, and the routes attached to each of them.')}
+      </p>
+      {isEmpty(listeners) ? (
+        <EmptyBox label={t('listeners')} />
+      ) : (
+        <Table gridBreakPoint="">
+          <Thead>
+            <Tr>
+              <Th>{t('Name')}</Th>
+              <Th visibility={['hidden', 'visibleOnMd']}>{t('Hostname')}</Th>
+              <Th>{t('Port')}</Th>
+              <Th visibility={['hidden', 'visibleOnSm']}>{t('Protocol')}</Th>
+              <Th visibility={['hidden', 'visibleOnLg']}>{t('Certificates')}</Th>
+              <Th visibility={['hidden', 'visibleOnLg']}>{t('Allowed routes')}</Th>
+              <Th visibility={['hidden', 'visibleOnMd']}>{t('Attached routes')}</Th>
+              <Th>{t('Status')}</Th>
+            </Tr>
+          </Thead>
+          <Tbody>
+            {listeners.map((listener) => {
+              const listenerStatus = (gateway?.status?.listeners || []).find(
+                (candidate) => candidate?.name === listener?.name,
+              );
+              const certificateRefs = listener?.tls?.certificateRefs || [];
+
+              return (
+                <Tr key={listener?.name}>
+                  <Td>{listener?.name || '-'}</Td>
+                  <Td className="co-break-word" visibility={['hidden', 'visibleOnMd']}>
+                    {listener?.hostname || '*'}
+                  </Td>
+                  <Td>{listener?.port ?? '-'}</Td>
+                  <Td visibility={['hidden', 'visibleOnSm']}>
+                    {listener?.protocol || '-'}
+                    {listener?.tls?.mode && ` (${listener.tls.mode})`}
+                  </Td>
+                  <Td visibility={['hidden', 'visibleOnLg']}>
+                    {isEmpty(certificateRefs)
+                      ? '-'
+                      : certificateRefs.map((certificateRef) => (
+                          <RefLink
+                            defaultKind="Secret"
+                            defaultNamespace={gatewayNamespace}
+                            key={`${certificateRef?.namespace || ''}/${certificateRef?.name}`}
+                            reference={certificateRef}
+                          />
+                        ))}
+                  </Td>
+                  <Td visibility={['hidden', 'visibleOnLg']}>
+                    <LabelGroup numLabels={3}>
+                      <Label isCompact>{allowedRoutesLabel(listener)}</Label>
+                    </LabelGroup>
+                  </Td>
+                  <Td visibility={['hidden', 'visibleOnMd']}>
+                    {listenerStatus?.attachedRoutes ?? '-'}
+                  </Td>
+                  <Td>
+                    <ConditionLabels conditions={listenerStatus?.conditions} />
+                  </Td>
+                </Tr>
+              );
+            })}
+          </Tbody>
+        </Table>
+      )}
+    </>
+  );
+};
+
+export default ListenersSection;
