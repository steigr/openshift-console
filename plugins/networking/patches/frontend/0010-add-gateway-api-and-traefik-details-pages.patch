+import { ResourceDetailsPage } from '@openshift-console/dynamic-plugin-sdk';
+import {
+  ConsolePluginBuildMetadata,
+  EncodedExtension,
+} from '@openshift-console/dynamic-plugin-sdk-webpack';
+
+const GATEWAY_API_GROUP = 'gateway.networking.k8s.io';
+
+/**
+ * Console matches a details page extension against the exact
+ * `group~version~kind` in the URL, so every version a cluster may still serve
+ * needs its own entry. The page itself resolves the preferred version at
+ * render time, so all of these land on the same component.
+ */
+const detailsPages = (
+  kind: string,
+  versions: string[],
+  codeRef: string,
+): EncodedExtension<ResourceDetailsPage>[] =>
+  versions.map(
+    (version) =>
+      ({
+        properties: {
+          component: { $codeRef: codeRef },
+          model: {
+            group: GATEWAY_API_GROUP,
+            kind,
+            version,
+          },
+        },
+        type: 'console.page/resource/details',
+      }) as EncodedExtension<ResourceDetailsPage>,
+  );
+
+export const GatewayApiExtensions: EncodedExtension[] = [
+  ...detailsPages('HTTPRoute', ['v1', 'v1beta1'], 'gatewayApiPages.HTTPRouteDetailsPage'),
+  ...detailsPages('GRPCRoute', ['v1', 'v1alpha2'], 'gatewayApiPages.GRPCRouteDetailsPage'),
+  ...detailsPages('TCPRoute', ['v1', 'v1alpha2'], 'gatewayApiPages.TCPRouteDetailsPage'),
+  ...detailsPages(
+    'TLSRoute',
+    ['v1', 'v1alpha2', 'v1alpha3'],
+    'gatewayApiPages.TLSRouteDetailsPage',
+  ),
+  ...detailsPages('UDPRoute', ['v1', 'v1alpha2'], 'gatewayApiPages.UDPRouteDetailsPage'),
+  ...detailsPages('Gateway', ['v1', 'v1beta1'], 'gatewayApiPages.GatewayDetailsPage'),
+  ...detailsPages('GatewayClass', ['v1', 'v1beta1'], 'gatewayApiPages.GatewayClassDetailsPage'),
+  ...detailsPages(
+    'ReferenceGrant',
+    ['v1', 'v1beta1', 'v1alpha2'],
+    'gatewayApiPages.ReferenceGrantDetailsPage',
+  ),
+  ...detailsPages(
+    'BackendTLSPolicy',
+    ['v1', 'v1alpha3'],
+    'gatewayApiPages.BackendTLSPolicyDetailsPage',
+  ),
+];
+
+export const GatewayApiExposedModules: ConsolePluginBuildMetadata['exposedModules'] = {
+  gatewayApiPages: './views/gatewayapi/details/pages.tsx',
+};
