@@ -0,0 +1,131 @@
+import React, { FC } from 'react';
+
+import { Table, Tbody, Td, Th, Thead, Tr } from '@patternfly/react-table';
+import DetailsSectionTitle from '@utils/components/DetailsSectionTitle/DetailsSectionTitle';
+import EmptyBox from '@utils/components/EmptyBox/EmptyBox';
+import RefLink from '@utils/components/ResourceDetails/RefLink';
+import { useNetworkingTranslation } from '@utils/hooks/useNetworkingTranslation';
+import { isEmpty } from '@utils/utils';
+import TraefikServiceRefLink from '@views/traefik/details/components/TraefikServiceRefLink';
+import {
+  TRAEFIK_GROUP,
+  TraefikIngressRoute,
+  TraefikMiddlewareRef,
+} from '@views/traefik/details/utils/types';
+
+const MiddlewaresCell: FC<{
+  kind: string;
+  middlewares: TraefikMiddlewareRef[];
+  namespace: string;
+}> = ({ kind, middlewares, namespace }) => {
+  if (isEmpty(middlewares)) return <>-</>;
+
+  return (
+    <>
+      {middlewares.map((middleware) => (
+        <RefLink
+          defaultNamespace={namespace}
+          key={`${middleware?.namespace || ''}/${middleware?.name}`}
+          reference={{
+            group: TRAEFIK_GROUP,
+            kind,
+            name: middleware?.name,
+            namespace: middleware?.namespace,
+          }}
+        />
+      ))}
+    </>
+  );
+};
+
+type TraefikRoutesSectionProps = {
+  ingressRoute: TraefikIngressRoute;
+  /** `Middleware` for HTTP routes, `MiddlewareTCP` for TCP ones. */
+  middlewareKind?: string;
+  /** UDP routes have no match expression and no priority. */
+  showMatch?: boolean;
+};
+
+/**
+ * `spec.routes`: the Traefik equivalent of an HTTPRoute's rules - a match
+ * expression, the Services it forwards to, and the Middlewares applied on the
+ * way.
+ */
+const TraefikRoutesSection: FC<TraefikRoutesSectionProps> = ({
+  ingressRoute,
+  middlewareKind = 'Middleware',
+  showMatch = true,
+}) => {
+  const { t } = useNetworkingTranslation();
+  const namespace = ingressRoute?.metadata?.namespace;
+  const routes = ingressRoute?.spec?.routes || [];
+
+  const rows = routes.flatMap((route, routeIndex) => {
+    const services = isEmpty(route?.services) ? [null] : route.services;
+
+    return services.map((service, serviceIndex) => ({
+      key: `${routeIndex}-${serviceIndex}`,
+      route,
+      routeIndex,
+      service,
+    }));
+  });
+
+  return (
+    <>
+      <DetailsSectionTitle titleText={t('Routes')} />
+      <p className="co-m-pane__explanation">
+        {t(
+          'The backends this route forwards matching traffic to, and the middlewares applied to it.',
+        )}
+      </p>
+      {isEmpty(rows) ? (
+        <EmptyBox label={t('routes')} />
+      ) : (
+        <Table gridBreakPoint="">
+          <Thead>
+            <Tr>
+              <Th>{t('Rule')}</Th>
+              {showMatch && <Th visibility={['hidden', 'visibleOnMd']}>{t('Match')}</Th>}
+              <Th>{t('Backend')}</Th>
+              <Th visibility={['hidden', 'visibleOnSm']}>{t('Port')}</Th>
+              <Th visibility={['hidden', 'visibleOnLg']}>{t('Weight')}</Th>
+              <Th visibility={['hidden', 'visibleOnLg']}>{t('Middlewares')}</Th>
+            </Tr>
+          </Thead>
+          <Tbody>
+            {rows.map(({ key, route, routeIndex, service }) => (
+              <Tr key={key}>
+                <Td>{t('Rule {{index}}', { index: routeIndex + 1 })}</Td>
+                {showMatch && (
+                  <Td className="co-break-word" visibility={['hidden', 'visibleOnMd']}>
+                    {route?.match || '-'}
+                    {route?.priority ? ` (${t('priority')}: ${route.priority})` : ''}
+                  </Td>
+                )}
+                <Td>
+                  {service ? (
+                    <TraefikServiceRefLink namespace={namespace} reference={service} />
+                  ) : (
+                    t('No backend')
+                  )}
+                </Td>
+                <Td visibility={['hidden', 'visibleOnSm']}>{service?.port ?? '-'}</Td>
+                <Td visibility={['hidden', 'visibleOnLg']}>{service?.weight ?? '-'}</Td>
+                <Td visibility={['hidden', 'visibleOnLg']}>
+                  <MiddlewaresCell
+                    kind={middlewareKind}
+                    middlewares={[...(route?.middlewares || []), ...(service?.middlewares || [])]}
+                    namespace={namespace}
+                  />
+                </Td>
+              </Tr>
+            ))}
+          </Tbody>
+        </Table>
+      )}
+    </>
+  );
+};
+
+export default TraefikRoutesSection;
