+import React, { FC } from 'react';
+
+import { Grid, GridItem, PageSection } from '@patternfly/react-core';
+import { Table, Tbody, Td, Th, Thead, Tr } from '@patternfly/react-table';
+import DetailsSectionTitle from '@utils/components/DetailsSectionTitle/DetailsSectionTitle';
+import EmptyBox from '@utils/components/EmptyBox/EmptyBox';
+import Loading from '@utils/components/Loading/Loading';
+import MetadataSection from '@utils/components/ResourceDetails/MetadataSection';
+import { useNetworkingTranslation } from '@utils/hooks/useNetworkingTranslation';
+import { isEmpty } from '@utils/utils';
+import TraefikServiceRefLink from '@views/traefik/details/components/TraefikServiceRefLink';
+import { TraefikService, TraefikServiceRef } from '@views/traefik/details/utils/types';
+
+type BackendRow = {
+  label: string;
+  service: TraefikServiceRef;
+  share: string;
+};
+
+type TraefikServiceDetailsTabProps = {
+  obj: TraefikService;
+};
+
+/**
+ * A TraefikService is a backend made of other backends - either weighted
+ * round-robin over several Services, or one Service whose traffic is mirrored
+ * to others. Both are reference lists worth resolving.
+ */
+const TraefikServiceDetailsTab: FC<TraefikServiceDetailsTabProps> = ({ obj: traefikService }) => {
+  const { t } = useNetworkingTranslation();
+
+  if (!traefikService) return <Loading />;
+
+  const namespace = traefikService?.metadata?.namespace;
+  const mirroring = traefikService?.spec?.mirroring;
+
+  const rows: BackendRow[] = [
+    ...(traefikService?.spec?.weighted?.services || []).map((service) => ({
+      label: t('Weighted'),
+      service,
+      share: `${service?.weight ?? '-'}`,
+    })),
+    ...(mirroring?.name ? [{ label: t('Mirrored from'), service: mirroring, share: '-' }] : []),
+    ...(mirroring?.mirrors || []).map((service) => ({
+      label: t('Mirror'),
+      service,
+      share: service?.percent === undefined ? '-' : `${service.percent}%`,
+    })),
+  ];
+
+  return (
+    <>
+      <PageSection>
+        <DetailsSectionTitle titleText={t('{{kind}} details', { kind: traefikService?.kind })} />
+        <Grid hasGutter>
+          <GridItem lg={6} sm={12}>
+            <MetadataSection obj={traefikService} />
+          </GridItem>
+        </Grid>
+      </PageSection>
+      <PageSection>
+        <DetailsSectionTitle titleText={t('Backend references')} />
+        <p className="co-m-pane__explanation">
+          {t('The services this TraefikService is composed of.')}
+        </p>
+        {isEmpty(rows) ? (
+          <EmptyBox label={t('backend references')} />
+        ) : (
+          <Table gridBreakPoint="">
+            <Thead>
+              <Tr>
+                <Th>{t('Role')}</Th>
+                <Th>{t('Backend')}</Th>
+                <Th visibility={['hidden', 'visibleOnSm']}>{t('Kind')}</Th>
+                <Th visibility={['hidden', 'visibleOnSm']}>{t('Port')}</Th>
+                <Th visibility={['hidden', 'visibleOnMd']}>{t('Weight')}</Th>
+              </Tr>
+            </Thead>
+            <Tbody>
+              {rows.map((row, index) => (
+                <Tr key={`${row.label}-${row.service?.name}-${index}`}>
+                  <Td>{row.label}</Td>
+                  <Td>
+                    <TraefikServiceRefLink namespace={namespace} reference={row.service} />
+                  </Td>
+                  <Td visibility={['hidden', 'visibleOnSm']}>{row.service?.kind || 'Service'}</Td>
+                  <Td visibility={['hidden', 'visibleOnSm']}>{row.service?.port ?? '-'}</Td>
+                  <Td visibility={['hidden', 'visibleOnMd']}>{row.share}</Td>
+                </Tr>
+              ))}
+            </Tbody>
+          </Table>
+        )}
+      </PageSection>
+    </>
+  );
+};
+
+export default TraefikServiceDetailsTab;
