diff --git a/src/views/gatewayapi/overview/GatewayApiGraph.tsx b/src/views/gatewayapi/overview/GatewayApiGraph.tsx
new file mode 100644
index 0000000..cb8245b
--- /dev/null
+++ b/src/views/gatewayapi/overview/GatewayApiGraph.tsx
@@ -0,0 +1,616 @@
+import React, { FC, useEffect, useRef, useState } from 'react';
+import { useNavigate } from 'react-router';
+
+import {
+  K8sGroupVersionKind,
+  K8sResourceCommon,
+  useK8sWatchResources,
+} from '@openshift-console/dynamic-plugin-sdk';
+import { Bullseye, EmptyState, EmptyStateBody, Spinner } from '@patternfly/react-core';
+import {
+  action,
+  ColaLayout,
+  ComponentFactory,
+  createTopologyControlButtons,
+  defaultControlButtonsOptions,
+  DefaultEdge,
+  DefaultNode,
+  Edge,
+  EdgeModel,
+  EdgeStyle,
+  Graph,
+  GRAPH_LAYOUT_END_EVENT,
+  GraphComponent,
+  Layout,
+  LayoutFactory,
+  Model,
+  ModelKind,
+  Node,
+  NodeModel,
+  NodeShape,
+  NodeStatus,
+  observer,
+  TopologyControlBar,
+  TopologyView,
+  Visualization,
+  VisualizationProvider,
+  VisualizationSurface,
+  withPanZoom,
+} from '@patternfly/react-topology';
+import { useNetworkingTranslation } from '@utils/hooks/useNetworkingTranslation';
+
+import '@patternfly/react-topology/dist/esm/css/topology-components.css';
+import '@patternfly/react-topology/dist/esm/css/topology-controlbar.css';
+import '@patternfly/react-topology/dist/esm/css/topology-view.css';
+
+// --- Types ---
+type Condition = {
+  lastTransitionTime?: string;
+  status?: string;
+  type?: string;
+};
+type GatewayAddress = {
+  type?: string;
+  value: string;
+};
+type GatewayKind = {
+  status?: {
+    addresses?: GatewayAddress[];
+    conditions?: Condition[];
+  };
+} & K8sResourceCommon;
+type RouteParentRef = {
+  group?: string;
+  kind?: string;
+  name: string;
+  namespace?: string;
+};
+type RouteParentStatus = {
+  conditions?: Condition[];
+};
+type GenericRouteKind = {
+  spec?: {
+    hostnames?: string[];
+    parentRefs?: RouteParentRef[];
+  };
+  status?: {
+    parents?: RouteParentStatus[];
+  };
+} & K8sResourceCommon;
+type ReferenceGrantFrom = {
+  group?: string;
+  kind?: string;
+  namespace?: string;
+};
+type ReferenceGrantTo = {
+  group?: string;
+  kind?: string;
+  name?: string;
+};
+type ReferenceGrantKind = {
+  spec?: {
+    from?: ReferenceGrantFrom[];
+    to?: ReferenceGrantTo[];
+  };
+} & K8sResourceCommon;
+
+type RouteKindName = 'GRPCRoute' | 'HTTPRoute' | 'TCPRoute' | 'TLSRoute' | 'UDPRoute';
+interface RouteEntry {
+  kind: RouteKindName;
+  resource: GenericRouteKind;
+}
+
+// --- GroupVersionKinds ---
+const GATEWAY_API_GROUP = 'gateway.networking.k8s.io';
+const GATEWAY_GVK: K8sGroupVersionKind = {
+  group: GATEWAY_API_GROUP,
+  kind: 'Gateway',
+  version: 'v1',
+};
+const REFERENCE_GRANT_GVK: K8sGroupVersionKind = {
+  group: GATEWAY_API_GROUP,
+  kind: 'ReferenceGrant',
+  version: 'v1beta1',
+};
+const ROUTE_GVKS: Record<RouteKindName, K8sGroupVersionKind> = {
+  GRPCRoute: { group: GATEWAY_API_GROUP, kind: 'GRPCRoute', version: 'v1' },
+  HTTPRoute: { group: GATEWAY_API_GROUP, kind: 'HTTPRoute', version: 'v1' },
+  TCPRoute: { group: GATEWAY_API_GROUP, kind: 'TCPRoute', version: 'v1alpha2' },
+  TLSRoute: { group: GATEWAY_API_GROUP, kind: 'TLSRoute', version: 'v1alpha2' },
+  UDPRoute: { group: GATEWAY_API_GROUP, kind: 'UDPRoute', version: 'v1alpha2' },
+};
+const ROUTE_BADGE: Record<RouteKindName, string> = {
+  GRPCRoute: 'GRPC',
+  HTTPRoute: 'HTTP',
+  TCPRoute: 'TCP',
+  TLSRoute: 'TLS',
+  UDPRoute: 'UDP',
+};
+const ROUTE_BADGE_COLOR = 'var(--pf-t--global--color--nonstatus--purple--default)';
+const GATEWAY_BADGE_COLOR = 'var(--pf-t--global--color--brand--default)';
+
+// --- Helpers ---
+function gwId(gw: GatewayKind): string {
+  return `gw/${gw.metadata?.namespace}/${gw.metadata?.name}`;
+}
+function rtId(entry: RouteEntry): string {
+  return `rt/${entry.kind}/${entry.resource.metadata?.namespace}/${entry.resource.metadata?.name}`;
+}
+function lastUpdated(entry: RouteEntry): number {
+  const times = (entry.resource.status?.parents ?? [])
+    .flatMap((p) => p.conditions ?? [])
+    .map((c) => (c.lastTransitionTime ? Date.parse(c.lastTransitionTime) : NaN))
+    .filter((n) => !Number.isNaN(n));
+  if (times.length > 0) return Math.max(...times);
+  const created = entry.resource.metadata?.creationTimestamp;
+  return created ? Date.parse(created) : 0;
+}
+function resourcePath(
+  gvk: K8sGroupVersionKind,
+  namespace: string | undefined,
+  name: string | undefined,
+): string {
+  return `/k8s/ns/${namespace}/${gvk.group}~${gvk.version}~${gvk.kind}/${name}`;
+}
+
+function conditionsStatus(conditions: Condition[] | undefined): NodeStatus {
+  if (!conditions || conditions.length === 0) return NodeStatus.default;
+  if (conditions.some((c) => c.status === 'False')) return NodeStatus.danger;
+  if (conditions.every((c) => c.status === 'True')) return NodeStatus.success;
+  return NodeStatus.default;
+}
+
+function gatewayStatus(gw: GatewayKind): NodeStatus {
+  return conditionsStatus(gw.status?.conditions);
+}
+
+function routeStatus(rt: GenericRouteKind): NodeStatus {
+  const conditions = (rt.status?.parents ?? []).flatMap((p) => p.conditions ?? []);
+  return conditionsStatus(conditions);
+}
+
+function findReferenceGrant(
+  grants: ReferenceGrantKind[],
+  gatewayNamespace: string,
+  routeNamespace: string,
+  routeKind: string,
+): ReferenceGrantKind | undefined {
+  if (gatewayNamespace === routeNamespace) return undefined;
+  return grants.find((rg) => {
+    if ((rg.metadata?.namespace ?? '') !== gatewayNamespace) return false;
+    return (rg.spec?.from ?? []).some(
+      (from) => (from.namespace ?? '') === routeNamespace && (from.kind ?? '') === routeKind,
+    );
+  });
+}
+
+const NODE_WIDTH = 220;
+const NODE_HEIGHT = 56;
+// Routes stay hidden behind the "+N" bubble until a Gateway is expanded.
+const MAX_ROUTES_PER_GATEWAY = 0;
+
+interface GatewayApiNodeData {
+  badge: string;
+  badgeColor: string;
+  expanded?: boolean;
+  moreCount?: number;
+  onClick?: () => void;
+  onToggleMore?: () => void;
+  secondaryLabel?: string;
+}
+
+interface GatewayApiEdgeData {
+  onClick?: () => void;
+  tag: string;
+}
+
+function buildModel(
+  gateways: GatewayKind[],
+  routeEntries: RouteEntry[],
+  referenceGrants: ReferenceGrantKind[],
+  expandedGateways: Set<string>,
+  navigate: (path: string) => void,
+  toggleExpanded: (id: string) => void,
+): { edges: EdgeModel[]; nodes: NodeModel[] } {
+  // Match each route to its parent gateway(s).
+  const entriesByGateway = new Map<string, RouteEntry[]>();
+  for (const entry of routeEntries) {
+    const rtNs = entry.resource.metadata?.namespace ?? '';
+    for (const ref of entry.resource.spec?.parentRefs ?? []) {
+      if ((ref.kind ?? 'Gateway') !== 'Gateway') continue;
+      const refNs = ref.namespace ?? rtNs;
+      const matchingGw = gateways.find(
+        (gw) => gw.metadata?.name === ref.name && (gw.metadata?.namespace ?? '') === refNs,
+      );
+      if (matchingGw) {
+        const key = gwId(matchingGw);
+        const list = entriesByGateway.get(key) ?? [];
+        list.push(entry);
+        entriesByGateway.set(key, list);
+      }
+    }
+  }
+
+  const gwNodes: NodeModel[] = gateways.map((gw) => {
+    const matched = entriesByGateway.get(gwId(gw)) ?? [];
+    const overflow = matched.length - MAX_ROUTES_PER_GATEWAY;
+    const expanded = expandedGateways.has(gwId(gw));
+    return {
+      data: {
+        badge: 'GW',
+        badgeColor: GATEWAY_BADGE_COLOR,
+        expanded,
+        moreCount: overflow > 0 ? overflow : undefined,
+        onClick: () =>
+          navigate(resourcePath(GATEWAY_GVK, gw.metadata?.namespace, gw.metadata?.name)),
+        onToggleMore: overflow > 0 ? () => toggleExpanded(gwId(gw)) : undefined,
+        secondaryLabel: gw.metadata?.namespace,
+      } satisfies GatewayApiNodeData,
+      height: NODE_HEIGHT,
+      id: gwId(gw),
+      label: gw.metadata?.name,
+      shape: NodeShape.rect,
+      status: gatewayStatus(gw),
+      type: 'node',
+      width: NODE_WIDTH,
+    };
+  });
+
+  const visibleRoutes = new Map<string, RouteEntry>();
+  const edges: EdgeModel[] = [];
+  for (const gw of gateways) {
+    const matched = (entriesByGateway.get(gwId(gw)) ?? []).sort(
+      (a, b) => lastUpdated(b) - lastUpdated(a),
+    );
+    const expanded = expandedGateways.has(gwId(gw));
+    const shown = expanded ? matched : matched.slice(0, MAX_ROUTES_PER_GATEWAY);
+    for (const entry of shown) {
+      const routeNs = entry.resource.metadata?.namespace ?? '';
+      const gwNs = gw.metadata?.namespace ?? '';
+      visibleRoutes.set(rtId(entry), entry);
+      const grant = findReferenceGrant(referenceGrants, gwNs, routeNs, entry.kind);
+      edges.push({
+        data: grant
+          ? ({
+              onClick: () =>
+                navigate(
+                  resourcePath(
+                    REFERENCE_GRANT_GVK,
+                    grant.metadata?.namespace,
+                    grant.metadata?.name,
+                  ),
+                ),
+              tag: grant.metadata?.name,
+            } satisfies GatewayApiEdgeData)
+          : undefined,
+        edgeStyle: EdgeStyle.dashed,
+        id: `edge/${gwId(gw)}/${rtId(entry)}`,
+        source: gwId(gw),
+        target: rtId(entry),
+        type: 'edge',
+      });
+    }
+  }
+
+  const rtNodes: NodeModel[] = [...visibleRoutes.values()].map((entry) => ({
+    data: {
+      badge: ROUTE_BADGE[entry.kind],
+      badgeColor: ROUTE_BADGE_COLOR,
+      onClick: () =>
+        navigate(
+          resourcePath(
+            ROUTE_GVKS[entry.kind],
+            entry.resource.metadata?.namespace,
+            entry.resource.metadata?.name,
+          ),
+        ),
+      secondaryLabel: entry.resource.metadata?.namespace,
+    } satisfies GatewayApiNodeData,
+    height: NODE_HEIGHT,
+    id: rtId(entry),
+    label: entry.resource.metadata?.name,
+    shape: NodeShape.rect,
+    status: routeStatus(entry.resource),
+    type: 'node',
+    width: NODE_WIDTH,
+  }));
+
+  return { edges, nodes: [...gwNodes, ...rtNodes] };
+}
+
+const layoutFactory: LayoutFactory = (type: string, graph: Graph): Layout | undefined => {
+  switch (type) {
+    case 'Cola':
+      return new ColaLayout(graph, { layoutOnDrag: false });
+    default:
+      return undefined;
+  }
+};
+
+interface GatewayApiNodeProps {
+  element: Node;
+}
+
+const GatewayApiNode: FC<GatewayApiNodeProps> = observer(({ element }) => {
+  const data = element.getData() as GatewayApiNodeData | undefined;
+  return (
+    <DefaultNode
+      element={element}
+      onSelect={data?.onClick}
+      showLabel={false}
+      showStatusDecorator={!!data?.badge}
+    >
+      <foreignObject height={NODE_HEIGHT} width={NODE_WIDTH} x={0} y={0}>
+        <div
+          style={{
+            alignItems: 'flex-start',
+            boxSizing: 'border-box',
+            cursor: data?.onClick ? 'pointer' : undefined,
+            display: 'flex',
+            flexDirection: 'column',
+            gap: 3,
+            height: '100%',
+            justifyContent: 'center',
+            overflow: 'hidden',
+            padding: '4px 12px',
+            pointerEvents: 'none',
+          }}
+        >
+          <div style={{ alignItems: 'center', display: 'flex', gap: 6, maxWidth: '100%' }}>
+            {data?.badge && (
+              <span
+                style={{
+                  backgroundColor: data.badgeColor,
+                  borderRadius: 3,
+                  color: 'var(--pf-t--global--text--color--inverse)',
+                  flexShrink: 0,
+                  fontSize: 9,
+                  fontWeight: 700,
+                  padding: '1px 5px',
+                }}
+              >
+                {data.badge}
+              </span>
+            )}
+            <span
+              style={{
+                fontSize: 13,
+                fontWeight: 600,
+                overflow: 'hidden',
+                textOverflow: 'ellipsis',
+                whiteSpace: 'nowrap',
+              }}
+            >
+              {element.getLabel()}
+            </span>
+          </div>
+          {data?.secondaryLabel && (
+            <span
+              style={{
+                color: 'var(--pf-t--global--text--color--subtle)',
+                fontSize: 11,
+                overflow: 'hidden',
+                textOverflow: 'ellipsis',
+                whiteSpace: 'nowrap',
+              }}
+            >
+              {data.secondaryLabel}
+            </span>
+          )}
+        </div>
+      </foreignObject>
+      {data?.onToggleMore && (
+        <g
+          onClick={(e) => {
+            e.stopPropagation();
+            data.onToggleMore?.();
+          }}
+          style={{ cursor: 'pointer' }}
+        >
+          <circle
+            cx={NODE_WIDTH}
+            cy={NODE_HEIGHT}
+            fill="var(--pf-t--global--color--brand--default)"
+            r={11}
+            stroke="var(--pf-t--global--background--color--primary--default)"
+            strokeWidth={2}
+          />
+          <text
+            fill="var(--pf-t--global--text--color--inverse)"
+            fontSize={data.expanded ? 16 : 10}
+            fontWeight={700}
+            textAnchor="middle"
+            x={NODE_WIDTH}
+            y={NODE_HEIGHT + (data.expanded ? 5 : 3)}
+          >
+            {data.expanded ? '−' : `+${data.moreCount}`}
+          </text>
+        </g>
+      )}
+    </DefaultNode>
+  );
+});
+
+interface GatewayApiEdgeProps {
+  element: Edge;
+}
+
+const GatewayApiEdge: FC<GatewayApiEdgeProps> = observer(({ element }) => {
+  const data = element.getData() as GatewayApiEdgeData | undefined;
+  return <DefaultEdge element={element} onSelect={data?.onClick} tag={data?.tag} />;
+});
+
+const componentFactory: ComponentFactory = (kind, type) => {
+  switch (type) {
+    case 'group':
+      return undefined;
+    default:
+      switch (kind) {
+        case ModelKind.graph:
+          return withPanZoom()(GraphComponent);
+        case ModelKind.node:
+          return GatewayApiNode;
+        case ModelKind.edge:
+          return GatewayApiEdge;
+        default:
+          return undefined;
+      }
+  }
+};
+
+const GatewayApiGraphView: FC<{
+  gateways: GatewayKind[];
+  referenceGrants: ReferenceGrantKind[];
+  routeEntries: RouteEntry[];
+}> = ({ gateways, referenceGrants, routeEntries }) => {
+  const navigate = useNavigate();
+  const [expandedGateways, setExpandedGateways] = useState<Set<string>>(new Set());
+  const toggleExpanded = (id: string) =>
+    setExpandedGateways((prev) => {
+      const next = new Set(prev);
+      next.has(id) ? next.delete(id) : next.add(id);
+      return next;
+    });
+
+  // The controller is created once and reused: rebuilding it on every data/expand-state
+  // change would reset the user's pan/zoom on each interaction.
+  const controllerRef = useRef<null | Visualization>(null);
+  if (!controllerRef.current) {
+    const newController = new Visualization();
+    newController.registerLayoutFactory(layoutFactory);
+    newController.registerComponentFactory(componentFactory);
+    // Cola's physics simulation settles asynchronously over several ticks, so the initial
+    // fit-to-screen has to wait for it to actually finish rather than firing after one frame.
+    // Only the very first settle is fit automatically -- fitting on every later layout (e.g.
+    // after an expand/collapse) would fight the user's own pan/zoom.
+    const onFirstLayoutEnd = () => {
+      newController.getGraph().fit(80);
+      newController.removeEventListener(GRAPH_LAYOUT_END_EVENT, onFirstLayoutEnd);
+    };
+    newController.addEventListener(GRAPH_LAYOUT_END_EVENT, onFirstLayoutEnd);
+    controllerRef.current = newController;
+  }
+  const controller = controllerRef.current;
+
+  useEffect(() => {
+    const { edges, nodes } = buildModel(
+      gateways,
+      routeEntries,
+      referenceGrants,
+      expandedGateways,
+      navigate,
+      toggleExpanded,
+    );
+    const model: Model = {
+      edges,
+      graph: {
+        id: 'gateway-api-graph',
+        layout: 'Cola',
+        type: 'graph',
+      },
+      nodes,
+    };
+    controller.fromModel(model, true);
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [gateways, routeEntries, referenceGrants, expandedGateways]);
+
+  return (
+    <TopologyView
+      controlBar={
+        <TopologyControlBar
+          controlButtons={createTopologyControlButtons({
+            ...defaultControlButtonsOptions,
+            fitToScreenCallback: action(() => {
+              controller.getGraph().fit(80);
+            }),
+            legend: false,
+            resetViewCallback: action(() => {
+              controller.getGraph().reset();
+              controller.getGraph().layout();
+            }),
+            zoomInCallback: action(() => {
+              controller.getGraph().scaleBy(4 / 3);
+            }),
+            zoomOutCallback: action(() => {
+              controller.getGraph().scaleBy(0.75);
+            }),
+          })}
+        />
+      }
+    >
+      <VisualizationProvider controller={controller}>
+        <VisualizationSurface state={{}} />
+      </VisualizationProvider>
+    </TopologyView>
+  );
+};
+
+const GatewayApiGraph: FC = () => {
+  const { t } = useNetworkingTranslation();
+  const resources = useK8sWatchResources<{
+    gateways: GatewayKind[];
+    grpcroutes: GenericRouteKind[];
+    httproutes: GenericRouteKind[];
+    referencegrants: ReferenceGrantKind[];
+    tcproutes: GenericRouteKind[];
+    tlsroutes: GenericRouteKind[];
+    udproutes: GenericRouteKind[];
+  }>({
+    gateways: { groupVersionKind: GATEWAY_GVK, isList: true, namespaced: true },
+    grpcroutes: { groupVersionKind: ROUTE_GVKS.GRPCRoute, isList: true, namespaced: true },
+    httproutes: { groupVersionKind: ROUTE_GVKS.HTTPRoute, isList: true, namespaced: true },
+    referencegrants: { groupVersionKind: REFERENCE_GRANT_GVK, isList: true, namespaced: true },
+    tcproutes: { groupVersionKind: ROUTE_GVKS.TCPRoute, isList: true, namespaced: true },
+    tlsroutes: { groupVersionKind: ROUTE_GVKS.TLSRoute, isList: true, namespaced: true },
+    udproutes: { groupVersionKind: ROUTE_GVKS.UDPRoute, isList: true, namespaced: true },
+  });
+
+  const coreLoaded = resources.gateways.loaded && resources.httproutes.loaded;
+  if (!coreLoaded) {
+    return (
+      <Bullseye>
+        <Spinner size="lg" />
+      </Bullseye>
+    );
+  }
+
+  const gateways = resources.gateways.data ?? [];
+  const routeEntries: RouteEntry[] = (
+    [
+      ['GRPCRoute', resources.grpcroutes],
+      ['HTTPRoute', resources.httproutes],
+      ['TCPRoute', resources.tcproutes],
+      ['TLSRoute', resources.tlsroutes],
+      ['UDPRoute', resources.udproutes],
+    ] as [RouteKindName, (typeof resources)['httproutes']][]
+  ).flatMap(([kind, result]) => {
+    if (!result.loaded || result.loadError) return [];
+    return (result.data ?? []).map((resource) => ({ kind, resource }));
+  });
+  const referenceGrants =
+    resources.referencegrants.loaded && !resources.referencegrants.loadError
+      ? (resources.referencegrants.data ?? [])
+      : [];
+
+  if (gateways.length === 0 && routeEntries.length === 0) {
+    return (
+      <Bullseye>
+        <EmptyState titleText={t('No Gateway API resources found')}>
+          <EmptyStateBody>
+            {t('No Gateway or Route resources were found in any namespace.')}
+          </EmptyStateBody>
+        </EmptyState>
+      </Bullseye>
+    );
+  }
+  return (
+    <div style={{ height: '600px' }}>
+      <GatewayApiGraphView
+        gateways={gateways}
+        referenceGrants={referenceGrants}
+        routeEntries={routeEntries}
+      />
+    </div>
+  );
+};
+export default GatewayApiGraph;

