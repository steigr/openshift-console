---
 plugin-manifest.ts               |   2 +
 src/views/navigation/manifest.ts | 174 +++++++++++++++++++++++++++++++
 2 files changed, 176 insertions(+)
 create mode 100644 src/views/navigation/manifest.ts

diff --git a/plugin-manifest.ts b/plugin-manifest.ts
index 143ac48..222df57 100644
--- a/plugin-manifest.ts
+++ b/plugin-manifest.ts
@@ -4,6 +4,7 @@ import { ConsolePluginBuildMetadata } from '@openshift-console/dynamic-plugin-sd
 import { FlagsExposedModules, FlagsExtensions } from './src/utils/flags/manifest';
 import { IngressesExposedModules, IngressesExtensions } from './src/views/ingresses/manifest';
 import { NADsExposedModules, NADsExtensions } from './src/views/nads/manifest';
+import { NavigationExtensions } from './src/views/navigation/manifest';
 import {
   NetworkPoliciesExposedModules,
   NetworkPoliciesExtensions,
@@ -36,6 +37,7 @@ export const pluginMetadata: ConsolePluginBuildMetadata = {
 };
 
 export const extensions: EncodedExtension[] = [
+  ...NavigationExtensions,
   ...ServicesExtensions,
   ...RoutesExtensions,
   ...IngressesExtensions,
diff --git a/src/views/navigation/manifest.ts b/src/views/navigation/manifest.ts
new file mode 100644
index 0000000..5683840
--- /dev/null
+++ b/src/views/navigation/manifest.ts
@@ -0,0 +1,174 @@
+import {
+  NavSection,
+  ResourceClusterNavItem,
+  ResourceNSNavItem,
+  Separator,
+} from '@openshift-console/dynamic-plugin-sdk';
+import { EncodedExtension } from '@openshift/dynamic-plugin-sdk-webpack';
+
+const gatewayApiSection = 'gateway-api';
+
+const navSection = (id: string, name: string): EncodedExtension<NavSection> =>
+  ({
+    properties: {
+      id,
+      name,
+    },
+    type: 'console.navigation/section',
+  }) as EncodedExtension<NavSection>;
+
+const namespacedResourceNav = (
+  id: string,
+  name: string,
+  section: string,
+  group: string,
+  version: string,
+  kind: string,
+): EncodedExtension<ResourceNSNavItem> =>
+  ({
+    properties: {
+      id,
+      model: {
+        group,
+        kind,
+        version,
+      },
+      name,
+      section,
+    },
+    type: 'console.navigation/resource-ns',
+  }) as EncodedExtension<ResourceNSNavItem>;
+
+const clusterResourceNav = (
+  id: string,
+  name: string,
+  section: string,
+  group: string,
+  version: string,
+  kind: string,
+): EncodedExtension<ResourceClusterNavItem> =>
+  ({
+    properties: {
+      id,
+      model: {
+        group,
+        kind,
+        version,
+      },
+      name,
+      section,
+    },
+    type: 'console.navigation/resource-cluster',
+  }) as EncodedExtension<ResourceClusterNavItem>;
+
+const sectionSeparator = (id: string, section: string): EncodedExtension<Separator> =>
+  ({
+    properties: {
+      id,
+      section,
+    },
+    type: 'console.navigation/separator',
+  }) as EncodedExtension<Separator>;
+
+export const NavigationExtensions: EncodedExtension[] = [
+  navSection(gatewayApiSection, 'Gateway API'),
+  namespacedResourceNav(
+    'gateway-api-tcproutes',
+    'TCPRoutes',
+    gatewayApiSection,
+    'gateway.networking.k8s.io',
+    'v1alpha2',
+    'TCPRoute',
+  ),
+  namespacedResourceNav(
+    'gateway-api-udproutes',
+    'UDPRoutes',
+    gatewayApiSection,
+    'gateway.networking.k8s.io',
+    'v1alpha2',
+    'UDPRoute',
+  ),
+  namespacedResourceNav(
+    'gateway-api-tlsroutes',
+    'TLSRoutes',
+    gatewayApiSection,
+    'gateway.networking.k8s.io',
+    'v1alpha2',
+    'TLSRoute',
+  ),
+  namespacedResourceNav(
+    'gateway-api-httproutes',
+    'HTTPRoutes',
+    gatewayApiSection,
+    'gateway.networking.k8s.io',
+    'v1',
+    'HTTPRoute',
+  ),
+  namespacedResourceNav(
+    'gateway-api-grpcroutes',
+    'GRPCRoutes',
+    gatewayApiSection,
+    'gateway.networking.k8s.io',
+    'v1',
+    'GRPCRoute',
+  ),
+  namespacedResourceNav(
+    'gateway-api-referencegrants',
+    'ReferenceGrants',
+    gatewayApiSection,
+    'gateway.networking.k8s.io',
+    'v1beta1',
+    'ReferenceGrant',
+  ),
+  sectionSeparator('gateway-api-separator-1', gatewayApiSection),
+  clusterResourceNav(
+    'gateway-api-gatewayclasses',
+    'GatewayClasses',
+    gatewayApiSection,
+    'gateway.networking.k8s.io',
+    'v1',
+    'GatewayClass',
+  ),
+  namespacedResourceNav(
+    'gateway-api-gateways',
+    'Gateways',
+    gatewayApiSection,
+    'gateway.networking.k8s.io',
+    'v1',
+    'Gateway',
+  ),
+  sectionSeparator('gateway-api-separator-2', gatewayApiSection),
+  namespacedResourceNav(
+    'gateway-api-backendtlspolicies',
+    'BackendTLSPolicies',
+    gatewayApiSection,
+    'gateway.networking.k8s.io',
+    'v1alpha3',
+    'BackendTLSPolicy',
+  ),
+  namespacedResourceNav(
+    'gateway-api-listenersets',
+    'ListenerSets',
+    gatewayApiSection,
+    'gateway.networking.k8s.io',
+    'v1',
+    'ListenerSet',
+  ),
+  sectionSeparator('gateway-api-separator-3', gatewayApiSection),
+  namespacedResourceNav(
+    'gateway-api-xbackendtrafficpolicies',
+    'XBackendTrafficPolicies',
+    gatewayApiSection,
+    'gateway.networking.x-k8s.io',
+    'v1alpha1',
+    'XBackendTrafficPolicy',
+  ),
+  clusterResourceNav(
+    'gateway-api-xmeshes',
+    'XMeshes',
+    gatewayApiSection,
+    'gateway.networking.x-k8s.io',
+    'v1alpha1',
+    'XMesh',
+  ),
+];
