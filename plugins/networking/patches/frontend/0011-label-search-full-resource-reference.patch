@@ -15,7 +15,12 @@ export type LabelProps = {
 };
 
 export const Label: FC<LabelProps> = ({ expand, groupVersionKind, name, value }) => {
-  const href = `/search?kind=${groupVersionKind.kind}&q=${
+  // Search resolves a CRD only by its full reference; a bare kind leaves the
+  // results spinning forever. Core kinds have no group and stay bare.
+  const reference = groupVersionKind.group
+    ? `${groupVersionKind.group}~${groupVersionKind.version}~${groupVersionKind.kind}`
+    : groupVersionKind.kind;
+  const href = `/search?kind=${encodeURIComponent(reference)}&q=${
     value ? encodeURIComponent(`${name}=${value}`) : name
   }`;
   const kindOf = `co-m-${groupVersionKind.kind.toLowerCase()}`;
